Функция Удалить_СоответствияТС(МассивИдентификаторов)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	уатТС.Ссылка КАК ТС,
		|	уатТС.ИДвСистемеНавигации КАК ИДвСистемеНавигации
		|ИЗ
		|	Справочник.уатТС КАК уатТС
		|ГДЕ
		|	уатТС.ИДвСистемеНавигации В (&МассивИдентификаторов)";
	
	Запрос.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Процедура ПолучитьСписокТСНаСервере()
	
	МассивОтветаСервиса = SDL_РаботаСHTTPСервисами.ПолучитьСписокТС();
	ТаблицаТС = SDL_ФортМонитор.МассивСтруктурВТаблицуЗначений(МассивОтветаСервиса);

	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаТС);       
	Построитель.Вывести(ТабДокТС);

	Если СоздаватьНовыеТС Тогда 
		отладка_СоздатьТС(ТаблицаТС);
	КонецЕсли;
	
КонецПроцедуры

