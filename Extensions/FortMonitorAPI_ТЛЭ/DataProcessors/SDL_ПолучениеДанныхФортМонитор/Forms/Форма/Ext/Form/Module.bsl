&НаКлиенте
Процедура ГенерацияОтчетаСинхронная(Команда)
	
	ТекущиеДанныеОтчетов = Элементы.ТаблицаОтчетов.ТекущиеДанные;
	
	Если ТекущиеДанныеОтчетов <> Неопределено Тогда 
		
		ИдентификаторОтчета = ТекущиеДанныеОтчетов.Id;
		ГенерацияОтчетаСинхроннаяНаСервере(ИдентификаторОтчета);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ГенерацияОтчетаСинхроннаяНаСервере(ИдентификаторОтчета)
	
	ТаблицаДанных.Очистить();
	
	МассивОтветаСервиса = SDL_РаботаСHTTPСервисами.ПолучитьСписокТС();
	
	ТаблицаТС = SDL_ФортМонитор.МассивСтруктурВТаблицуЗначений(МассивОтветаСервиса);
	МассивТС = ТаблицаТС.ВыгрузитьКолонку("VehicleID");

	СтруктураОтчета = SDL_РаботаСHTTPСервисами.ЗапросОтчета(ИдентификаторОтчета, МассивТС, ДатаНачала, КонецДня(ДатаОкончания));
	
	Если СтруктураОтчета <> Неопределено Тогда 
		
		ТаблицаОтчета = SDL_ФортМонитор.ОтчетВТаблицуЗначений(СтруктураОтчета);
		
		Построитель = Новый ПостроительОтчета;
		Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаОтчета);       
		Построитель.Вывести(ТаблицаДанных);

	КонецЕсли;
	
КонецПроцедуры


