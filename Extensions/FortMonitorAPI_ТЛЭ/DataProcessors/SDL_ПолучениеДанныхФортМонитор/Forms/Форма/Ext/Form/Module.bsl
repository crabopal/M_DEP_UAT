&НаСервере
Процедура отладка_СоздатьТС(ТаблицаТС)
	
	SDL_ФортМонитор.ПреобразоватьКолонкуВТип_Строка(ТаблицаТС, "VehicleID");
	
	Для Каждого ТС из ТаблицаТС Цикл 
		
		НайденноеТС = Справочники.уатТС.НайтиПоРеквизиту("ИДвСистемеНавигации", ТС.Строка_VehicleID);
		Если ЗначениеЗаполнено(НайденноеТС) Тогда 
			Продолжить;
		КонецЕсли;
		
		НовыйТС = Справочники.уатТС.СоздатьЭлемент();
		НовыйТС.ОбменДанными.Загрузка = Истина;
		НовыйТС.ИДвСистемеНавигации = ТС.Строка_VehicleID; //Формат(ТС.VehicleID, "ЧРГ=");
		НовыйТС.Наименование = ТС.Number;
		
		Сообщить("Создано новое ТС:" + НовыйТС.Наименование);
		
		НовыйТС.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

