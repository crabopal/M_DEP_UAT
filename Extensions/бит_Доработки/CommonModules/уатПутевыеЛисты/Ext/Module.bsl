// + бит Петянина А.К 20.04.26
Функция ДанныеОбедаПоЗаданию(Задания) Экспорт
	
	Результат = Новый Структура("ДневнойОбед, ВремяОбеда", Истина, 0 );
	
	Если Задания.Количество() = 1 Тогда
		Запрос = Новый Запрос;
        Задание = Задания[0];
		//Установка значений параметров
		Запрос.УстановитьПараметр("Смена", Задание.Смена);
		Запрос.УстановитьПараметр("Маршрут", Задание.Маршрут);
		Запрос.УстановитьПараметр("ДатаПЛ", Задание.ВремяУбытия);
		Запрос.УстановитьПараметр("ВыхБудн", Задание.ВыходныеБудни);
		Запрос.УстановитьПараметр("Выезд", Задание.Выезд);

		Запрос.Текст = "ВЫБРАТЬ
		               |	ЮЦАУДлительностьВыездаСрезПоследних.Длительность КАК Длительность,
		               |	ЮЦАУДлительностьВыездаСрезПоследних.ВремяВыезда КАК ВремяВыезда,
		               |	ЮЦАУДлительностьВыездаСрезПоследних.ВремяЗаезда КАК ВремяЗаезда,
		               |	ВЫБОР
		               |		КОГДА ЮЦАУДлительностьВыездаСрезПоследних.НачалоОбеда >= ДАТАВРЕМЯ(1, 1, 1, 6, 0, 0)
		               |				И ЮЦАУДлительностьВыездаСрезПоследних.НачалоОбеда < ДАТАВРЕМЯ(1, 1, 1, 22, 0, 0)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК ДневнойОбед
		               |ИЗ
		               |	РегистрСведений.ЮЦАУДлительностьВыезда.СрезПоследних(
		               |			&ДатаПЛ,
		               |			Маршрут = &Маршрут
		               |				И Выезд = &Выезд
		               |				И Смена = &Смена
		               |				И ВыхБудн = &ВыхБудн) КАК ЮЦАУДлительностьВыездаСрезПоследних";

		РезультатЗапроса = Запрос.Выполнить();
		Если РезультатЗапроса.Пустой() Тогда
			Возврат Результат;
		КонецЕсли;

		Выборка = РезультатЗапроса.Выбрать();
		Если Выборка.Следующий() Тогда
			ВыездСек = Выборка.ВремяВыезда - Дата(1,1,1);
			ЗаездСек = Выборка.ВремяЗаезда - Дата(1,1,1); 
			ДлительностьСек = Выборка.Длительность - Дата(1,1,1);
			ВремяОбеда = (ЗаездСек - ВыездСек - ДлительностьСек);
			Если  ЗаездСек < ВыездСек Тогда
				ВремяОбеда = ВремяОбеда + 24 * 3600 ;
			КонецЕсли;
			Результат.ВремяОбеда = ВремяОбеда;
			Результат.ДневнойОбед = Выборка.ДневнойОбед;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ДоработатьТЧФОВ(ФактическиОтработанноеВремя, стОбед) Экспорт
	Для каждого СтрокаФОВ ИЗ ФактическиОтработанноеВремя Цикл
		Если стОбед.ДневнойОбед Тогда
			НовоеВремя = СтрокаФОВ.ВремяДневное - стОбед.ВремяОбеда;
			Если НовоеВремя >= 0 Тогда
				СтрокаФОВ.ВремяДневное = НовоеВремя;
				Прервать;
			Иначе
				СтрокаФОВ.ВремяДневное = 0;
				стОбед.ВремяОбеда = -НовоеВремя;
			КонецЕсли;
		Иначе
			НовоеВремя = СтрокаФОВ.ВремяНочное - стОбед.ВремяОбеда;
			Если НовоеВремя >= 0 Тогда
				СтрокаФОВ.ВремяНочное = НовоеВремя;
				Прервать ;
			Иначе
				СтрокаФОВ.ВремяНочное = 0;
				стОбед.ВремяОбеда = -НовоеВремя;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецФункции

// Новый расчет включен у подразделения водителя (Водитель1) и дата выезда не раньше даты начала.
//
Функция НовыйРасчетВремениСменыВключен(Водитель, ДатаВыезда) Экспорт
	
	Если Не ЗначениеЗаполнено(Водитель) Или Не ЗначениеЗаполнено(ДатаВыезда) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Подразделение = Водитель.Подразделение;
	Если Не ЗначениеЗаполнено(Подразделение) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не Подразделение.ЮЦ_НовыйРасчетВремениСмены Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ДатаНачала = Подразделение.ЮЦ_ДатаНачалаНовогоРасчетаВремениСмены;
	Если Не ЗначениеЗаполнено(ДатаНачала) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат НачалоДня(ДатаВыезда) >= НачалоДня(ДатаНачала);
	
КонецФункции

// Ночная смена не длиннее суток: все дневные и ночные часы относятся на дату выезда,
// а не делятся по календарным суткам.
//
Процедура ОтнестиЧасыНочнойСменыНаДатуВыезда(ФактическиОтработанноеВремя, ДатаВыезда, ДатаВозвращения) Экспорт
	
	Если Не ЗначениеЗаполнено(ДатаВыезда) Или Не ЗначениеЗаполнено(ДатаВозвращения) Тогда
		Возврат;
	КонецЕсли;
	
	Если НачалоДня(ДатаВыезда) = НачалоДня(ДатаВозвращения) Тогда
		Возврат;
	КонецЕсли;
	
	// Длинный рейс (больше суток) оставляем разрезанным по дням.
	Если ДатаВозвращения - ДатаВыезда > 86400 Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСмены = НачалоДня(ДатаВыезда);
	ИтогиПоСотрудникам = Новый Соответствие;
	
	Для Каждого СтрокаФОВ Из ФактическиОтработанноеВремя Цикл
		Итог = ИтогиПоСотрудникам.Получить(СтрокаФОВ.Сотрудник);
		Если Итог = Неопределено Тогда
			Итог = Новый Структура("ВремяДневное, ВремяНочное", 0, 0);
			ИтогиПоСотрудникам.Вставить(СтрокаФОВ.Сотрудник, Итог);
		КонецЕсли;
		Итог.ВремяДневное = Итог.ВремяДневное + СтрокаФОВ.ВремяДневное;
		Итог.ВремяНочное = Итог.ВремяНочное + СтрокаФОВ.ВремяНочное;
	КонецЦикла;
	
	ФактическиОтработанноеВремя.Очистить();
	
	Для Каждого КлючИЗначение Из ИтогиПоСотрудникам Цикл
		Итог = КлючИЗначение.Значение;
		Если Итог.ВремяДневное = 0 И Итог.ВремяНочное = 0 Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = ФактическиОтработанноеВремя.Добавить();
		НоваяСтрока.Сотрудник = КлючИЗначение.Ключ;
		НоваяСтрока.Дата = ДатаСмены;
		НоваяСтрока.ВремяДневное = Итог.ВремяДневное;
		НоваяСтрока.ВремяНочное = Итог.ВремяНочное;
	КонецЦикла;
	
КонецПроцедуры

// Путевой только на слив: часы в задании не заполнены и есть документ слива по этому листу.
// Тогда фактическое время из периода выезда/возвращения в табель не берём.
//
Функция ПутевойЛистТолькоДляСливаТоплива(Ссылка, Задание) Экспорт
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Задание.Итог("КоличествоЧасов") <> 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Слив.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.уатСливГСМ КАК Слив
	|ГДЕ
	|	НЕ Слив.ПометкаУдаления
	|	И (Слив.ПутевойЛист = &Ссылка
	|			ИЛИ Слив.ПутевойЛистПриемник = &Ссылка)";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции
// - бит Петянина А.К 20.04.26

&ИзменениеИКонтроль("РасчитатьВременныеПараметры")
Процедура Бит_РасчитатьВременныеПараметры(Объект)
	флЭтоТПЛ = Ложь;
	Если НЕ уатОбщегоНазначенияПовтИсп.ВариантПоставкиСТД()
		И ТипЗнч(Объект) = Тип("ДокументОбъект.уатТехнологическийПутевойЛист") Тогда
		флЭтоТПЛ = Истина;
	КонецЕсли;

	Если флЭтоТПЛ Тогда
		РежимРаботыТС = Справочники.уатРежимыРаботыТС.ПустаяСсылка();
		тблПростои = Новый ТаблицаЗначений;
	Иначе
		РежимРаботыТС = Объект.РежимРаботыТС;
		тблПростои = Объект.Простои.Выгрузить();
	КонецЕсли;
	
	тблРабочееВремя = РасчетВремени(Объект.ДатаВыезда, Объект.ДатаВозвращения, Объект.Организация, РежимРаботыТС, тблПростои);
		
	// В СТД в ПЛ нет ТЧ ФОВ, поэтому для учета работы сотрудников в выходные и праздники используется отдельная переменная объекта
	РассчитатьВыходныеПраздникиДляСТД(тблРабочееВремя, Объект);

	тблРабочееВремя.Свернуть("ВидВремени, ПростойСВклДвиг", "Продолжительность");

	// работу и ночные часы берем из таблицы рабочего времени, простои тоже
	Объект.мВремяВРаботе = 0;
	Объект.мВремяНочь = 0;
	Объект.мВремяВПростое = 0;
	Объект.мВремяВПростоеСВклДвигателем = 0;
	Если уатОбщегоНазначенияПовтИсп.ВариантПоставкиСТД() Тогда
		Объект.мВремяДень = 0;
	КонецЕсли;
	Для Каждого ТекСтрокаРабВремя Из тблРабочееВремя Цикл
		Если ТекСтрокаРабВремя.ВидВремени = Справочники.уатВидыИспользованияРабочегоВремени.Явка Тогда
			Объект.мВремяВРаботе = Объект.мВремяВРаботе + ТекСтрокаРабВремя.Продолжительность;
		ИначеЕсли ТекСтрокаРабВремя.ВидВремени = Справочники.уатВидыИспользованияРабочегоВремени.РаботаНочныеЧасы Тогда
			Объект.мВремяНочь = Объект.мВремяНочь + ТекСтрокаРабВремя.Продолжительность;
		ИначеЕсли уатОбщегоНазначенияПовтИсп.ВариантПоставкиСТД() И ТекСтрокаРабВремя.ВидВремени = "Дневные" Тогда
			Объект.мВремяДень = Объект.мВремяДень + ТекСтрокаРабВремя.Продолжительность;
		ИначеЕсли ТекСтрокаРабВремя.ВидВремени = Справочники.уатВидыИспользованияРабочегоВремени.Простой Тогда
			Если ТекСтрокаРабВремя.ПростойСВклДвиг Тогда
				Объект.мВремяВПростоеСВклДвигателем = Объект.мВремяВПростоеСВклДвигателем + ТекСтрокаРабВремя.Продолжительность;
			Иначе
				Объект.мВремяВПростое = Объект.мВремяВПростое + ТекСтрокаРабВремя.Продолжительность;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	// общее количество дней по ПЛ
	Объект.мКоличествоДней = (НачалоДня(Объект.ДатаВозвращения) - НачалоДня(Объект.ДатаВыезда))/86400 + 1;

	// время в наряде
	Если Объект.ДатаВозвращения - Объект.ДатаВыезда > 86400 Тогда //многодневный ПЛ
		Если ЗначениеЗаполнено(РежимРаботыТС) Тогда
			мПродолжительностьРабочегоДня = РежимРаботыТС.КонецРаботы - РежимРаботыТС.НачалоРаботы;
			Если РежимРаботыТС.НачалоРаботы <= РежимРаботыТС.КонецРаботы Тогда //дневной
				мПродолжительностьРабочегоДня = РежимРаботыТС.КонецРаботы - РежимРаботыТС.НачалоРаботы;
			Иначе //ночной
				мПродолжительностьРабочегоДня = РежимРаботыТС.КонецРаботы + 86400 - РежимРаботыТС.НачалоРаботы;
			КонецЕсли;
		Иначе
			мПродолжительностьРабочегоДня = уатПраваИНастройки.уатПолучитьПраваИНастройкиПользователя(Объект.Организация, "ПродолжительностьРабочегоДня") - '00010101';
			Если мПродолжительностьРабочегоДня = 0 Тогда
				мПродолжительностьРабочегоДня = 86400;
			КонецЕсли;
		КонецЕсли;

		Объект.мВремяВНаряде = ?(Объект.ДатаВыезда - НачалоДня(Объект.ДатаВыезда) > 86400 - мПродолжительностьРабочегоДня,
		86400 -	(Объект.ДатаВыезда - НачалоДня(Объект.ДатаВыезда)), мПродолжительностьРабочегоДня)
		+ ?(Объект.ДатаВозвращения - НачалоДня(Объект.ДатаВозвращения) > мПродолжительностьРабочегоДня,
		мПродолжительностьРабочегоДня, Объект.ДатаВозвращения - НачалоДня(Объект.ДатаВозвращения))
		+ мПродолжительностьРабочегоДня*((НачалоДня(Объект.ДатаВозвращения) -
		НачалоДня(Объект.ДатаВыезда))/86400 - 1);
	Иначе //однодневный ПЛ
		Объект.мВремяВНаряде = Объект.ДатаВозвращения - Объект.ДатаВыезда;
	КонецЕсли;
	#Вставка
	// + бит Петянина А.К 20.04.26
	Если Объект.ВидПЛ = Перечисления.уатВидыПЛ._6 Тогда
		стОбед = ДанныеОбедаПоЗаданию(Объект.Задание); 
		ДоработатьТЧФОВ(Объект.ФактическиОтработанноеВремя, стОбед);	
	КонецЕсли;
	// - бит Петянина А.К 20.04.26
	#КонецВставки
КонецПроцедуры
