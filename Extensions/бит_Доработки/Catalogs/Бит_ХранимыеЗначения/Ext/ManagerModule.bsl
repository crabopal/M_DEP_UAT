// Возвращает хранимое значение по наименованию.
// Если элемент не найден или помечен на удаление, возвращает ЗначениеПоУмолчанию.
// Пустое хранимое значение найденного элемента возвращается как есть.
//
// Параметры:
//  Наименование - Строка - наименование элемента справочника.
//  ЗначениеПоУмолчанию - Произвольный - значение, если элемент не найден.
//
// Возвращаемое значение:
//  Произвольный - реквизит Значение либо ЗначениеПоУмолчанию.
//
Функция Получить(Наименование, ЗначениеПоУмолчанию = Неопределено) Экспорт
	
	Имя = СокрЛП(Наименование);
	Если Не ЗначениеЗаполнено(Имя) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		НайденноеЗначение = Неопределено;
		Найдено = НайтиЗначениеПоНаименованию(Имя, НайденноеЗначение);
	Исключение
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Если Не Найдено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат НайденноеЗначение;
	
КонецФункции

Функция НайтиЗначениеПоНаименованию(Наименование, Значение)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХранимыеЗначения.Значение КАК Значение
	|ИЗ
	|	Справочник.Бит_ХранимыеЗначения КАК ХранимыеЗначения
	|ГДЕ
	|	ХранимыеЗначения.Наименование = &Наименование
	|	И НЕ ХранимыеЗначения.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХранимыеЗначения.Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Значение = Выборка.Значение;
	Возврат Истина;
	
КонецФункции
