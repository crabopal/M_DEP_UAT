Функция ContractListGet(Запрос)

	// Доступ к данным регулируется правом доступа к методу веб-сервиса.
	// Если у пользователя есть право на вызов веб-сервиса, то он получит все данные
	// без учета прав на эти данные.
	// Такая реализация необходима из-за того, что веб-сервис могут вызывать служебные пользователи:
	// для них назначать доступ к данным не получится из-за отстуствия профиля и невозможности настроить РЛС.
	//УстановитьПривилегированныйРежим(Истина);
	//ПубликуемыеДанные = ВнешнийПрограммныйИнтерфейс.ПубликуемыеДанныеБанковскихСчетов();
	//
	//Возврат Ответ(ПубликуемыеДанные);
	
	

	// Получить из запроса параметр URL *.
	//Признак = Запрос.ПараметрыURL["*"];
	
	КоличествоЗаписей = Запрос.ПараметрыЗапроса.Получить("CountOfRecords");
	ДоговорКод = Запрос.ПараметрыЗапроса.Получить("Id");  
	 
	// Сформировать выборку договоров
	
	ЗапросДоговоры = Новый Запрос;
	ЗапросДоговоры.Текст = 
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
		|	ДоговорыКонтрагентов.Код КАК Код,
		|	ДоговорыКонтрагентов.Наименование КАК Наименование,
		|	ДоговорыКонтрагентов.Владелец.Код КАК КонтрагентКод,
		|	ДоговорыКонтрагентов.Владелец.Наименование КАК КонтрагентНаименование,
		|	ДоговорыКонтрагентов.Владелец.НаименованиеПолное КАК КонтрагентНаименованиеПолное,
		|	ДоговорыКонтрагентов.Владелец.ИНН КАК КонтрагентИНН,
		|	ДоговорыКонтрагентов.Владелец.КПП КАК КонтрагентКПП,
		|	ДоговорыКонтрагентов.Владелец.КодПоОКПО КАК КонтрагентКодПоОКПО,
		|	ВЫБОР
		|		КОГДА ДоговорыКонтрагентов.Владелец.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
		|			ТОГДА 2
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ДоговорыКонтрагентов.Владелец.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
		|					ТОГДА 3
		|				ИНАЧЕ НЕОПРЕДЕЛЕНО
		|			КОНЕЦ
		|	КОНЕЦ КАК ТипКонтрагента,
		|	ВЫБОР
		|		КОГДА ДоговорыКонтрагентов.Владелец.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ЮридическоеЛицо)
		|			ТОГДА ""Юридическое лицо""
		|		ИНАЧЕ ВЫБОР
		|				КОГДА ДоговорыКонтрагентов.Владелец.ЮридическоеФизическоеЛицо = ЗНАЧЕНИЕ(Перечисление.ЮридическоеФизическоеЛицо.ФизическоеЛицо)
		|					ТОГДА ""Индивидуальный предприниматель""
		|				ИНАЧЕ НЕОПРЕДЕЛЕНО
		|			КОНЕЦ
		|	КОНЕЦ КАК ТипКонтрагентаНаименование,
		|	ДоговорыКонтрагентов.Владелец.ЮридическоеФизическоеЛицо КАК КонтрагентЮридическоеФизическоеЛицо,
		|	ДоговорыКонтрагентов.Дата КАК Дата,
		|	ДоговорыКонтрагентов.Номер КАК Номер,
		|	ДоговорыКонтрагентов.СрокДействия КАК СрокДействия,
		|	ДоговорыКонтрагентов.Комментарий КАК Комментарий,
		|	ЕСТЬNULL(ВложенныйЗапросКонтрагентыКонтактнаяИнформация.Представление, """") КАК КонтрагентЮрАдрес
		|ПОМЕСТИТЬ ВТ_Договоры
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КонтрагентыКонтактнаяИнформация.Представление КАК Представление,
		|			КонтрагентыКонтактнаяИнформация.Ссылка КАК Ссылка
		|		ИЗ
		|			Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
		|		ГДЕ
		|			КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
		|			И КонтрагентыКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресКонтрагента)) КАК ВложенныйЗапросКонтрагентыКонтактнаяИнформация
		|		ПО ДоговорыКонтрагентов.Владелец = ВложенныйЗапросКонтрагентыКонтактнаяИнформация.Ссылка
		|ГДЕ
		|	ДоговорыКонтрагентов.ЭтоГруппа = ЛОЖЬ
		|	И ДоговорыКонтрагентов.ВидВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ВидыВзаиморасчетов.РасчетыЗаЭлектроэнергиюСЮридическимиЛицами)
		|	И ДоговорыКонтрагентов.Код = &ДоговорКод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Договоры.Ссылка КАК Ссылка,
		|	ВТ_Договоры.Код КАК ДоговорКод,
		|	ВТ_Договоры.Наименование КАК ДоговорНаименование,
		|	ВТ_Договоры.КонтрагентКод КАК КонтрагентКод,
		|	ВТ_Договоры.КонтрагентНаименование КАК КонтрагентНаименование,
		|	ВТ_Договоры.КонтрагентНаименованиеПолное КАК КонтрагентНаименованиеПолное,
		|	ВТ_Договоры.КонтрагентИНН КАК КонтрагентИНН,
		|	ВТ_Договоры.КонтрагентКПП КАК КонтрагентКПП,
		|	ВТ_Договоры.КонтрагентКодПоОКПО КАК КонтрагентКодПоОКПО,
		|	ВТ_Договоры.ТипКонтрагента КАК ТипКонтрагента,
		|	ВТ_Договоры.ТипКонтрагентаНаименование КАК ТипКонтрагентаНаименование,
		|	ВТ_Договоры.КонтрагентЮрАдрес КАК КонтрагентЮрАдрес,
		|	ВТ_Договоры.Дата КАК ДоговорДата,
		|	ВТ_Договоры.Номер КАК ДоговорНомер,
		|	ВТ_Договоры.СрокДействия КАК ДоговорСрокДействия,
		|	ВТ_Договоры.Комментарий КАК ДоговорКомментарий
		|ИЗ
		|	ВТ_Договоры КАК ВТ_Договоры
		|ГДЕ
		|	ВТ_Договоры.Дата <= &ТекущаяДата
		|	И (ВТ_Договоры.СрокДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
		|			ИЛИ ВТ_Договоры.СрокДействия >= &ТекущаяДата)";
	
	ЗапросДоговоры.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Если КоличествоЗаписей <> Неопределено Тогда	
		Если Не СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(КоличествоЗаписей) Тогда
			КоличествоЗаписей = 1;			
		КонецЕсли;	
		ЗапросДоговоры.Текст = СтрЗаменить(ЗапросДоговоры.Текст, "ВЫБРАТЬ", "ВЫБРАТЬ ПЕРВЫЕ " + Строка(КоличествоЗаписей));
	КонецЕсли;	
	
	Если ДоговорКод <> Неопределено Тогда
		ЗапросДоговоры.УстановитьПараметр("ДоговорКод", ДоговорКод);
	Иначе	
		ЗапросДоговоры.Текст = СтрЗаменить(ЗапросДоговоры.Текст, "И ДоговорыКонтрагентов.Код = &ДоговорКод", "");
	КонецЕсли;	
	
	
	РезультатЗапроса = ЗапросДоговоры.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();

	Массив = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл	
		
		//Контрагенты
		СтруктураКонтрагента = ПолучитьСтруктуруКонтрагента(ВыборкаДетальныеЗаписи);		
		
		//Договоры

		//public class ContractDTO
		//{
		//    public int Id { get; set; }
		//    public string Number { get; set; }
		//    public int ContractorId { get; set; }
		//    public ContractorDTO Contractor { get; set; }
		//    public DateTime? DateRegister { get; set; }
		//    public DateTime? DateStart { get; set; }
		//    public DateTime? DateEnd { get; set; }
		//    public bool IsClose { get; set; }
		//    public DateTime? DateClose { get; set; }
		//    public string Note { get; set; }
		//}
		
		СтруктураЗаписи = Новый Структура; 
		СтруктураЗаписи.Вставить("Id", ВыборкаДетальныеЗаписи.ДоговорКод);
		СтруктураЗаписи.Вставить("Number", ВыборкаДетальныеЗаписи.ДоговорНомер);		
		СтруктураЗаписи.Вставить("ContractorId", ВыборкаДетальныеЗаписи.КонтрагентКод);
		СтруктураЗаписи.Вставить("Contractor", СтруктураКонтрагента);
		СтруктураЗаписи.Вставить("ContractName", ВыборкаДетальныеЗаписи.ДоговорНаименование);
		//СтруктураЗаписи.Вставить("DateRegister", ВыборкаДетальныеЗаписи.ДоговорДата);
		СтруктураЗаписи.Вставить("DateStart", ВыборкаДетальныеЗаписи.ДоговорДата);
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДоговорСрокДействия) Тогда
			СтруктураЗаписи.Вставить("DateEnd", ВыборкаДетальныеЗаписи.ДоговорСрокДействия);
		Иначе
			СтруктураЗаписи.Вставить("DateEnd", Неопределено);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДоговорСрокДействия) Тогда
			Если ВыборкаДетальныеЗаписи.ДоговорСрокДействия <= ТекущаяДата() Тогда
				СтруктураЗаписи.Вставить("IsClose", Ложь);
			Иначе	                                      
				СтруктураЗаписи.Вставить("IsClose", Истина);
			КонецЕсли;
			
			СтруктураЗаписи.Вставить("DateClose", ВыборкаДетальныеЗаписи.ДоговорСрокДействия);	
			
		Иначе
			СтруктураЗаписи.Вставить("IsClose", Ложь);
			СтруктураЗаписи.Вставить("DateClose", Неопределено);
		КонецЕсли;	
		
		СтруктураЗаписи.Вставить("Note", ВыборкаДетальныеЗаписи.ДоговорКомментарий);

		Массив.Добавить(СтруктураЗаписи);
		
	КонецЦикла;	
	
	ЗаписьJSON = Новый ЗаписьJSON;
	НастройкиСериализацииJSON = Новый НастройкиСериализацииJSON;
	НастройкиСериализацииJSON.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;	
	НастройкиСериализацииJSON.ФорматСериализацииДаты = ФорматДатыJSON.ISO; 
	
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, Массив, НастройкиСериализацииJSON);    
	Результат = ЗаписьJSON.Закрыть();
	
	// Сформировать ответ, возвращаемый HTTP-сервисом.
	Ответ = Новый HTTPСервисОтвет(200);
	
	// Установить тело ответа из строки Результат.
	Ответ.УстановитьТелоИзСтроки(Результат);
	Ответ.Заголовки.Вставить("Content-type", "application/json");
	
	Возврат Ответ;
	
КонецФункции


Функция PaymentsGet(Запрос)  
	
	//Пример запроса
	//http://192.168.10.3/ACC_2020/hs/api_ges/Payments?StartDate=01012022&EndDate=31012022&ContractId=00-006491
	// Сформировать ответ, возвращаемый HTTP-сервисом.
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-type", "application/json");
	
	НачальнаяДата = Запрос.ПараметрыЗапроса.Получить("StartDate");
	КонечнаяДата = Запрос.ПараметрыЗапроса.Получить("EndDate");  
	КонтрагентКод = Запрос.ПараметрыЗапроса.Получить("ContractorId");  
	ДоговорКод = Запрос.ПараметрыЗапроса.Получить("ContractId");  
	
	Если НачальнаяДата = Неопределено Тогда
		Возврат Ответ;
	Иначе
		НачальнаяДата = ПолучитьДатуИзСтроки(НачальнаяДата);		
	КонецЕсли;	
	
	Если КонечнаяДата = Неопределено Тогда
		Возврат Ответ;
	Иначе
		КонечнаяДата = ПолучитьДатуИзСтроки(КонечнаяДата);		
	КонецЕсли;	

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ХозрасчетныйОбороты.Регистратор КАК Регистратор,
		|	ХозрасчетныйОбороты.Регистратор.Номер КАК РегистраторНомер,
		|	ХозрасчетныйОбороты.Регистратор.Дата КАК РегистраторДата,
		|	ВЫРАЗИТЬ(ХозрасчетныйОбороты.Регистратор.Комментарий КАК СТРОКА(200)) КАК РегистраторКомментарий,
		|	ХозрасчетныйОбороты.Субконто1.Наименование КАК КонтрагентНаименование,
		|	ХозрасчетныйОбороты.Субконто2 КАК ДоговорКонтрагента,
		|	ХозрасчетныйОбороты.Субконто2.Код КАК ДоговорКонтрагентаКод,
		|	ХозрасчетныйОбороты.Субконто2.Наименование КАК ДоговорКонтрагентаНаименование,
		|	ХозрасчетныйОбороты.Субконто3 КАК Документ,
		|	ХозрасчетныйОбороты.СуммаОборотКт КАК СуммаОборотКт
		|ИЗ
		|	РегистрБухгалтерии.Хозрасчетный.Обороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Регистратор,
		|			Счет В ИЕРАРХИИ (ЗНАЧЕНИЕ(ПланСчетов.Хозрасчетный.РасчетыСПокупателямиИЗаказчиками)),
		|			&ВидыСубконто,
		|			Организация = &Организация
		|				И Субконто1.Код = &КонтрагентКод
		|				И Субконто2.Код = &ДоговорКод,
		|			КорСчет В ИЕРАРХИИ (&КорСчет),
		|			) КАК ХозрасчетныйОбороты
		|ГДЕ
		|	ХозрасчетныйОбороты.СуммаОборотКт <> 0
		|	И ХозрасчетныйОбороты.Субконто2.ВидВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ВидыВзаиморасчетов.РасчетыЗаЭлектроэнергиюСЮридическимиЛицами)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДоговорКонтрагента
		|ИТОГИ
		|	СУММА(СуммаОборотКт)
		|ПО
		|	ОБЩИЕ,
		|	Регистратор,
		|	ДоговорКонтрагента
		|АВТОУПОРЯДОЧИВАНИЕ";
		
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачальнаяДата));	
	
	МоментКонечнаяДата = Новый Граница(КонецДня(КонечнаяДата), ВидГраницы.Включая);
	Запрос.УстановитьПараметр("КонецПериода", МоментКонечнаяДата);
	
	МассивСубконто = Новый Массив;
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры);
	МассивСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДокументыРасчетовСКонтрагентами);
	Запрос.УстановитьПараметр("ВидыСубконто", МассивСубконто);
	
	МассивКорСчет = Новый Массив;
	МассивКорСчет.Добавить(ПланыСчетов.Хозрасчетный.КассаОрганизации);  //50.01
	МассивКорСчет.Добавить(ПланыСчетов.Хозрасчетный.РасчетныеСчета);  //51
	МассивКорСчет.Добавить(ПланыСчетов.Хозрасчетный.ПродажиПоПлатежнымКартам);  //57.03
	Запрос.УстановитьПараметр("КорСчет", МассивКорСчет);

	Если КонтрагентКод = Неопределено Тогда  
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Субконто1.Код = &КонтрагентКод", "");
	Иначе                                                                                
		Запрос.УстановитьПараметр("КонтрагентКод", КонтрагентКод);
	КонецЕсли;	
		
	Если ДоговорКод = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Субконто2.Код = &ДоговорКод", "");
	Иначе                                                                                
		Запрос.УстановитьПараметр("ДоговорКод", ДоговорКод);
	КонецЕсли;	
	
	Результат = Запрос.Выполнить(); 

		//Платежи
		//"Payment": {
		//"Id": string,
		//"ContractId": string,
		//"DatePay": string,
		//"Summa": number,
		//"Note": string,
		//"SaleDocumentId": string | number, 		// идентификатор документа к которому привязана оплата
		//"SaleDocument": saleDocument
		//},

	ОбщийИтог = 0;		
	МассивИтоговый = Новый Массив;
	
	ВыборкаОбщийИтог = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 
	ВыборкаПоРегистратору = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоРегистратору.Следующий() Цикл 

		СтруктураПлатежа = Новый Структура;

		СтруктураРегистратор = Новый Структура; 
		СтруктураРегистратор.Вставить("Id", ПолучитьIdДокумента(ВыборкаПоРегистратору.Регистратор));
		СтруктураРегистратор.Вставить("DatePay", ВыборкаПоРегистратору.РегистраторДата);
		СтруктураРегистратор.Вставить("Note", ВыборкаПоРегистратору.РегистраторКомментарий);
		
		МассивДоговоры = Новый Массив;
		ВыборкаПоДоговоруКонтрагента = ВыборкаПоРегистратору.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		Пока ВыборкаПоДоговоруКонтрагента.Следующий() Цикл 
			
			СтруктураДоговор = Новый Структура;
			СтруктураДоговор.Вставить("ContractId", ВыборкаПоДоговоруКонтрагента.ДоговорКонтрагентаКод);			
			
			МассивДокументы = Новый Массив;
			ВыборкаПоДокументу = ВыборкаПоДоговоруКонтрагента.Выбрать(); 
			Пока ВыборкаПоДокументу.Следующий() Цикл 
				
				СтруктураДокумент = Новый Структура;
				СтруктураДокумент.Вставить("SaleDocumentId", ПолучитьIdДокумента(ВыборкаПоДокументу.Документ));			
				СтруктураДокумент.Вставить("Summa", ВыборкаПоДокументу.СуммаОборотКт);			
				МассивДокументы.Добавить(СтруктураДокумент);
				ОбщийИтог = ОбщийИтог + ВыборкаПоДокументу.СуммаОборотКт;		
				
			КонецЦикла; 
			
			СтруктураДоговор.Вставить("SaleDocuments", МассивДокументы);
			МассивДоговоры.Добавить(СтруктураДоговор);
	
		КонецЦикла;                      
		
		СтруктураРегистратор.Вставить("Contracts", МассивДоговоры);
		СтруктураПлатежа.Вставить("Payment", СтруктураРегистратор);
		
		МассивИтоговый.Добавить(СтруктураПлатежа);
		
	КонецЦикла; 
	
	//Для отладки строка с итогом
	СтруктураИтоговаяСумма = Новый Структура;
	СтруктураИтоговаяСумма.Вставить("GrangTotal", ОбщийИтог);			
	МассивИтоговый.Добавить(СтруктураИтоговаяСумма);  
	//
	
	СтруктураПлатежи = Новый Структура;
	СтруктураПлатежи.Вставить("Payments", МассивИтоговый); 
	
	ЗаписьJSON = Новый ЗаписьJSON;
	НастройкиСериализацииJSON = Новый НастройкиСериализацииJSON;
	НастройкиСериализацииJSON.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;	
	НастройкиСериализацииJSON.ФорматСериализацииДаты = ФорматДатыJSON.ISO; 
	
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, СтруктураПлатежи, НастройкиСериализацииJSON);    
	Результат = ЗаписьJSON.Закрыть();
	
	// Сформировать ответ, возвращаемый HTTP-сервисом.
	//Ответ = Новый HTTPСервисОтвет(200);
	
	// Установить тело ответа из строки Результат.
	Ответ.УстановитьТелоИзСтроки(Результат);
	//Ответ.Заголовки.Вставить("Content-type", "application/json");
	
	Возврат Ответ;
	
КонецФункции


