	|	РеализацияТоваровУслугУслуги.Номенклатура.Наименование,
	|	РеализацияТоваровУслугУслуги.Номенклатура.ЕдиницаИзмерения.Наименование,
	|	РеализацияТоваровУслугУслуги.Количество,
	|	РеализацияТоваровУслугУслуги.Цена,
	|	РеализацияТоваровУслугУслуги.Сумма,
	|	РеализацияТоваровУслугУслуги.СтавкаНДС,
	|	РеализацияТоваровУслугУслуги.СуммаНДС,
	|	ВЫБОР
	|		КОГДА РеализацияТоваровУслугУслуги.Ссылка.СуммаВключаетНДС
	|			ТОГДА РеализацияТоваровУслугУслуги.Сумма
	|		ИНАЧЕ РеализацияТоваровУслугУслуги.Сумма + РеализацияТоваровУслугУслуги.СуммаНДС
	|	КОНЕЦ
	|ИЗ
	|	Документ.РеализацияТоваровУслуг.Услуги КАК РеализацияТоваровУслугУслуги
	|ГДЕ
	|	РеализацияТоваровУслугУслуги.Ссылка.Организация = &Организация
	|	И РеализацияТоваровУслугУслуги.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|	И РеализацияТоваровУслугУслуги.Ссылка.ДоговорКонтрагента.ВидВзаиморасчетов = ЗНАЧЕНИЕ(Справочник.ВидыВзаиморасчетов.РасчетыЗаЭлектроэнергиюСЮридическимиЛицами)
	|	И РеализацияТоваровУслугУслуги.Ссылка.Контрагент.Код = &КонтрагентКод
	|	И РеализацияТоваровУслугУслуги.Ссылка.ДоговорКонтрагента.Код = &ДоговорКод
	|
	|УПОРЯДОЧИТЬ ПО
	|	РеализацияТоваровУслугТовары.Ссылка
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаНДС),
	|	СУММА(СуммаВсего)
	|ПО
	|	ОБЩИЕ,
	|	РеализацияТоваровУслуг
	|АВТОУПОРЯДОЧИВАНИЕ";
		
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачальнаяДата));	
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонечнаяДата));
	
	Если КонтрагентКод = Неопределено Тогда  
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И РеализацияТоваровУслугТовары.Ссылка.Контрагент.Код = &КонтрагентКод", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И РеализацияТоваровУслугУслуги.Ссылка.Контрагент.Код = &КонтрагентКод", "");
	Иначе                                                                                
		Запрос.УстановитьПараметр("КонтрагентКод", КонтрагентКод);
	КонецЕсли;	
		
	Если ДоговорКод = Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И РеализацияТоваровУслугТовары.Ссылка.ДоговорКонтрагента.Код = &ДоговорКод", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И РеализацияТоваровУслугУслуги.Ссылка.ДоговорКонтрагента.Код = &ДоговорКод", "");
	Иначе                                                                                
		Запрос.УстановитьПараметр("ДоговорКод", ДоговорКод);
	КонецЕсли;	
	
	Результат = Запрос.Выполнить(); 

	// начисления
//	"SaleDocument": {
//	"Id": string | number,					// уникальный идентификатор
//	"Number": string,						// номер документа
//	"Month": string							// месяц за который выставлен документ
//	"Year": string							// год за который выставлен документ
//	"CreateDate": string,					// дата создания начисления
//	"MeteringDeviceId": string | number,	// идентификатор прибора учета
//	"Volume": number,						// объем
//	"PaymentSumma": number,					// сумма к оплате
//	"PreviousReading": number,				// предыдущие показания
//	"CurrentReading": number,				// показания по которым выставлен документ
//	"TariffId": string | number,			// идентификатор тарифной зоны
//	"Tariff": {									// тарифная зона
//		"Id": string | number					// уникальный идентификатор
//		"Zone": string,							// название тарифной зоны
//		"Value": number,						// цена за единицу
//	},
//}                              

	ОбщийИтог = 0;		
	МассивИтоговый = Новый Массив;
	
	ВыборкаОбщийИтог = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	ВыборкаОбщийИтог.Следующий(); 
	ВыборкаПоРеализацииТоваровУслуг = ВыборкаОбщийИтог.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаПоРеализацииТоваровУслуг.Следующий() Цикл 

		СтруктураРеализации = Новый Структура;

		СтруктураДокумент = Новый Структура; 
		СтруктураДокумент.Вставить("Id", ПолучитьIdДокумента(ВыборкаПоРеализацииТоваровУслуг.РеализацияТоваровУслуг));
		СтруктураДокумент.Вставить("Number", ВыборкаПоРеализацииТоваровУслуг.РеализацияНомер);
		СтруктураДокумент.Вставить("Month", Месяц(ВыборкаПоРеализацииТоваровУслуг.РеализацияДата));
		СтруктураДокумент.Вставить("Year", Год(ВыборкаПоРеализацииТоваровУслуг.РеализацияДата)); 
		СтруктураДокумент.Вставить("CreateDate", ВыборкаПоРеализацииТоваровУслуг.РеализацияДата); 
		СтруктураДокумент.Вставить("ContractorId", ВыборкаПоРеализацииТоваровУслуг.КонтрагентКод);
		СтруктураДокумент.Вставить("ContractId", ВыборкаПоРеализацииТоваровУслуг.ДоговорКонтрагентаКод);
		
		МассивНоменклатура = Новый Массив;
		ВыборкаПоНоменклатуре = ВыборкаПоРеализацииТоваровУслуг.Выбрать(); 
		Пока ВыборкаПоНоменклатуре.Следующий() Цикл 
				
			СтруктураНоменклатура = Новый Структура;
			СтруктураНоменклатура.Вставить("ItemId", ВыборкаПоНоменклатуре.НоменклатураКод);			
			СтруктураНоменклатура.Вставить("ItemName", ВыборкаПоНоменклатуре.НоменклатураНаименование);			
			СтруктураНоменклатура.Вставить("Unit", ВыборкаПоНоменклатуре.ЕдиницаИзмерения);			
			СтруктураНоменклатура.Вставить("Amount", ВыборкаПоНоменклатуре.Количество);			
			СтруктураНоменклатура.Вставить("Price", ВыборкаПоНоменклатуре.Цена);			
			СтруктураНоменклатура.Вставить("Summa", ВыборкаПоНоменклатуре.Сумма);			
			СтруктураНоменклатура.Вставить("VATRate", Строка(ВыборкаПоНоменклатуре.СтавкаНДС));			
			СтруктураНоменклатура.Вставить("VATSumma", ВыборкаПоНоменклатуре.СуммаНДС);			
			СтруктураНоменклатура.Вставить("TotalSumma", ВыборкаПоНоменклатуре.СуммаВсего);			
			
			МассивНоменклатура.Добавить(СтруктураНоменклатура);
			ОбщийИтог = ОбщийИтог + ВыборкаПоНоменклатуре.СуммаВсего;		
				
		КонецЦикла; 
		
		СтруктураДокумент.Вставить("Items", МассивНоменклатура);
		СтруктураРеализации.Вставить("SaleDocument", СтруктураДокумент);
		
		МассивИтоговый.Добавить(СтруктураРеализации);
		
	КонецЦикла; 
	
	//Для отладки строка с итогом
	//СтруктураИтоговаяСумма = Новый Структура;
	//СтруктураИтоговаяСумма.Вставить("GrandTotal", ОбщийИтог);			
	//МассивИтоговый.Добавить(СтруктураИтоговаяСумма);  
	//
	
	СтруктураДокументовРеализации = Новый Структура;
	СтруктураДокументовРеализации.Вставить("SaleDocuments", МассивИтоговый); 
	
	ЗаписьJSON = Новый ЗаписьJSON;
	НастройкиСериализацииJSON = Новый НастройкиСериализацииJSON;
	НастройкиСериализацииJSON.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;	
	НастройкиСериализацииJSON.ФорматСериализацииДаты = ФорматДатыJSON.ISO; 
	
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, СтруктураДокументовРеализации, НастройкиСериализацииJSON);    
	Результат = ЗаписьJSON.Закрыть();
	
	// Сформировать ответ, возвращаемый HTTP-сервисом.
	//Ответ = Новый HTTPСервисОтвет(200);
	
	// Установить тело ответа из строки Результат.
	Ответ.УстановитьТелоИзСтроки(Результат);
	//Ответ.Заголовки.Вставить("Content-type", "application/json");
	
	Возврат Ответ;

КонецФункции

