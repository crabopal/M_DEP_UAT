Функция ПолучитьIdДокумента(Регистратор)

	ТипДокумента = "НЕТ";
	Если ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") Тогда
		ТипДокумента = "ПРС";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") Тогда
		ТипДокумента = "ПКО";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") Тогда
		ТипДокумента = "ОПК";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.ОперацияБух") Тогда
		ТипДокумента = "ОПЕ";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		ТипДокумента = "РТУ";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаДолга") Тогда
		ТипДокумента = "КДО";
	ИначеЕсли ТипЗнч(Регистратор) = Тип("ДокументСсылка.КорректировкаРеализации") Тогда
		ТипДокумента = "КРЕ";
	КонецЕсли;	
	
	IdДокумента	= ТипДокумента + "-" + СокрЛП(Регистратор.Номер) + "-" + Формат(Регистратор.Дата,"ДФ=dd-MM-yyyy");
	
	Возврат IdДокумента;
	
КонецФункции	


