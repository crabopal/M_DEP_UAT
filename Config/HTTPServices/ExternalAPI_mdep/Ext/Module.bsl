	СтруктураСтроки.Вставить("ТранспортноеСредствоНаименование", "");   
	СтруктураСтроки.Вставить("ТранспортноеСредствоМодельНаименование", "");   
		
	СтруктураСтроки.Вставить("МаршрутИдентификатор", "");
	СтруктураСтроки.Вставить("МаршрутНаименование", "");

	СтруктураСтроки.Вставить("СотрудникИдентификатор", "");
	СтруктураСтроки.Вставить("СотрудникНаименование", "");
		
	СтруктураСтроки.Вставить("РабочееВремя", 0); 
	СтруктураСтроки.Вставить("Выручка", 0); 
	СтруктураСтроки.Вставить("КоличествоПассажиров", 0); 
	СтруктураСтроки.Вставить("КоличествоЕздок", 0); 
	СтруктураСтроки.Вставить("ПробегСПассажирами", 0); 
	
	Возврат СтруктураСтроки;
	
