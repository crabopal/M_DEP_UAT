&НаСервере
Функция ПолучитьСотрудника(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.Сотрудники.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		ОбъектКакОбъект = Справочники.Сотрудники.СоздатьЭлемент();
		ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
		ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    
		
		ОбъектКакОбъект.ФизическоеЛицо = ПолучитьФизическоеЛицо(СтруктураОбъекта.ФизическоеЛицо); 
		
		ОбъектКакОбъект.ВАрхиве = СтруктураОбъекта.ВАрхиве;
		//ОбъектКакОбъект.ДатаПриема = СтруктураОбъекта.ДатаПриема;                                                
		//ОбъектКакОбъект.ДатаУвольнения = СтруктураОбъекта.ДатаУвольнения;
		
		//ОбъектКакОбъект.Организация = ПолучитьОрганизацию(СтруктураОбъекта.Организация);
		ОбъектКакОбъект.ГоловнаяОрганизация = ПолучитьОрганизацию(СтруктураОбъекта.Организация);
		//ОбъектКакОбъект.Подразделение = ПолучитьПодразделение(СтруктураОбъекта.Подразделение);
		//ОбъектКакОбъект.Должность = ПолучитьДолжность(СтруктураОбъекта.Должность);
		
		ОбъектКакОбъект.ОбменДанными.Загрузка = Истина;
		ОбъектКакОбъект.ДополнительныеСвойства.Вставить("ПропуститьЗаписьВерсииОбъекта", Истина);
		УстановитьПривилегированныйРежим(Истина);

		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					
		ОбъектКакОбъект.Записать();	             

		УстановитьПривилегированныйРежим(Ложь);
		
		Возврат ОбъектКакОбъект.Ссылка;
		
	Иначе  
		Возврат СсылкаВИБ; 
	КонецЕсли;
	
КонецФункции		

Процедура ЗаписатьСНИЛСJSON(СтрокаJSON)Экспорт
	
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	 
	МассивПолейДат = Новый Массив;
	МассивПолейДат.Добавить("ДатаРождения");                    
	 
	СотрудникиМассив = ПрочитатьJSON(ЧтениеJSON,,МассивПолейДат,ФорматДатыJSON.ISO);
	Для Каждого СтрокаМассива Из СотрудникиМассив Цикл
		
		ФизическоеЛицо = ПолучитьФизическоеЛицо(СтрокаМассива); 
		
		ФизическоеЛицоОбъект = ФизическоеЛицо.ПолучитьОбъект();
		Если ЗначениеЗаполнено(ФизическоеЛицоОбъект.СтраховойНомерПФР) Тогда
			Продолжить;
		КонецЕсли;
		
		ФизическоеЛицоОбъект.СтраховойНомерПФР = СтрокаМассива.СтраховойНомерПФР;
		ФизическоеЛицоОбъект.Записать();
		
	КонецЦикла;

КонецПроцедуры

