Функция ПолучитьПорядокОкругления(ПорядокОкругления)
	
	Если ПорядокОкругления = "0.01" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр0_01;
	ИначеЕсли ПорядокОкругления = "0.05" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр0_05;
	ИначеЕсли ПорядокОкругления = "0.1" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр0_1;
	ИначеЕсли ПорядокОкругления = "0.5" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр0_5;
	ИначеЕсли ПорядокОкругления = "1" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр1;
	ИначеЕсли ПорядокОкругления = "5" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр5;
	ИначеЕсли ПорядокОкругления = "10" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр10
	ИначеЕсли ПорядокОкругления = "50" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр50;
	ИначеЕсли ПорядокОкругления = "100" Тогда
		Возврат Перечисления.ПорядкиОкругления.Окр100;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
