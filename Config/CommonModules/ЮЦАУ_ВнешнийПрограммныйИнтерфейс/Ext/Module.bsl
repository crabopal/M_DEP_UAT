&НаСервере
Функция ВыгрузитьСписокСкладскихДокументов(ЗапросJSON) Экспорт
	
	ДатаНачалаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("StartDate");
	ДатаКонцаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("EndDate");  
	
	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("Идентификатор", ЗапросJSON.ПараметрыЗапроса.Получить("GUID"));  
	СтруктураОбъекта.Вставить("ИНН", ЗапросJSON.ПараметрыЗапроса.Получить("INN"));
	СтруктураОбъекта.Вставить("КПП", ЗапросJSON.ПараметрыЗапроса.Получить("KPP"));
	Организация = ПолучитьОрганизацию(СтруктураОбъекта);
	
	ДатаНачала = ?(ДатаНачалаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаНачалаСтрокой));		
	ДатаКонца  = ?(ДатаКонцаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаКонцаСтрокой));		

	ДанныеТаблицаДокументовУАТ = Новый Массив;
	
	Запрос = Новый Запрос;  
	Запрос.Текст =   
	"ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеТоваровУслуг.Ссылка) КАК ГУИД,
	|	ПРЕДСТАВЛЕНИЕ(ПоступлениеТоваровУслуг.Ссылка) КАК ДокументУАТ,
	|	ПоступлениеТоваровУслуг.Проведен КАК ДокументУАТПроведен
	|ИЗ
	|	Документ.уатПоступлениеТоваровУслуг КАК ПоступлениеТоваровУслуг
	|ГДЕ
	|	ПоступлениеТоваровУслуг.Организация = &Организация
	|	И ПоступлениеТоваровУслуг.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ОприходованиеТоваров.Ссылка),
	|	ПРЕДСТАВЛЕНИЕ(ОприходованиеТоваров.Ссылка),
	|	ОприходованиеТоваров.Проведен
	|ИЗ
	|	Документ.уатОприходованиеТоваров КАК ОприходованиеТоваров
	|ГДЕ
	|	ОприходованиеТоваров.Организация = &Организация
	|	И ОприходованиеТоваров.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПеремещениеТоваров.Ссылка),
	|	ПРЕДСТАВЛЕНИЕ(ПеремещениеТоваров.Ссылка),
	|	ПеремещениеТоваров.Проведен
	|ИЗ
	|	Документ.уатПеремещениеТоваров КАК ПеремещениеТоваров
	|ГДЕ
	|	ПеремещениеТоваров.Организация = &Организация
	|	И ПеремещениеТоваров.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ИнвентаризацияТоваров.Ссылка),
	|	ПРЕДСТАВЛЕНИЕ(ИнвентаризацияТоваров.Ссылка),
	|	ИнвентаризацияТоваров.Проведен
	|ИЗ
	|	Документ.уатИнвентаризацияТоваров КАК ИнвентаризацияТоваров
	|ГДЕ
	|	ИнвентаризацияТоваров.Организация = &Организация
	|	И ИнвентаризацияТоваров.Дата МЕЖДУ &ДатаНачала И &ДатаКонца";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКонца", КонецДня(ДатаКонца));
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураСтроки = Новый Структура();
		СтруктураСтроки.Вставить("ГУИД", ВыборкаДетальныеЗаписи.ГУИД);
		СтруктураСтроки.Вставить("ДокументУАТ", ВыборкаДетальныеЗаписи.ДокументУАТ);
		СтруктураСтроки.Вставить("ДокументУАТПроведен", ВыборкаДетальныеЗаписи.ДокументУАТПроведен);
		
		ДанныеТаблицаДокументовУАТ.Добавить(СтруктураСтроки);  
		
	КонецЦикла;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДанныеТаблицаДокументовУАТ", ДанныеТаблицаДокументовУАТ);

	Возврат СтруктураДанных;
	
КонецФункции	    

//Парсим JSON-строку
Процедура ЗагрузитьСкладскиеДокументыJSON(СтрокаJSON) Экспорт
	
	ЧтениеJSON = Новый ЧтениеJSON();
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	 
	МассивПолейДат = Новый Массив;
	МассивПолейДат.Добавить("Дата");                    
	МассивПолейДат.Добавить("ДатаПриема"); 
	МассивПолейДат.Добавить("ДатаУвольнения");
	МассивПолейДат.Добавить("ДатаВыдачи");
	МассивПолейДат.Добавить("СрокДействия");
	
	СписокЗагруженныхДокументов = Новый СписокЗначений;
	
	МассивСкладскиеДокументы = ПрочитатьJSON(ЧтениеJSON,,МассивПолейДат,ФорматДатыJSON.ISO);
	Для Каждого СтруктураСтроки Из МассивСкладскиеДокументы Цикл
		
		Если СтруктураСтроки.Свойство("ТипДокумента") Тогда
			Если СтруктураСтроки.ТипДокумента = "ПоступлениеТоваровУслуг" Тогда

				ДокументСсылка = ЗагрузитьДокументПоступлениеТоваровУслуг(СтруктураСтроки);
				СписокЗагруженныхДокументов.Добавить(ДокументСсылка);

			ИначеЕсли СтруктураСтроки.ТипДокумента = "ИнвентаризацияТоваровНаСкладе" Тогда

				ДокументСсылка = ЗагрузитьДокументИнвентаризацияТоваровНаСкладе(СтруктураСтроки);
				СписокЗагруженныхДокументов.Добавить(ДокументСсылка);

			ИначеЕсли СтруктураСтроки.ТипДокумента = "ПеремещениеТоваров" Тогда

				ДокументСсылка = ЗагрузитьДокументПеремещениеТоваров(СтруктураСтроки);
				СписокЗагруженныхДокументов.Добавить(ДокументСсылка);

			ИначеЕсли СтруктураСтроки.ТипДокумента = "АвансовыйОтчет" Тогда

				ДокументСсылка = ЗагрузитьДокументОприходованиеТоваров(СтруктураСтроки);
				СписокЗагруженныхДокументов.Добавить(ДокументСсылка);

			ИначеЕсли СтруктураСтроки.ТипДокумента = "ОприходованиеТоваров" Тогда

				ДокументСсылка = ЗагрузитьДокументОприходованиеТоваров(СтруктураСтроки);
				СписокЗагруженныхДокументов.Добавить(ДокументСсылка);

			КонецЕсли;	
		КонецЕсли;
		
	КонецЦикла;

	//Проведение документов
	Для Каждого ЭлементСписка Из СписокЗагруженныхДокументов Цикл
		
		ДокументОбъект = ЭлементСписка.Значение.ПолучитьОбъект();
		Попытка
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
		КонецПопытки;	
		
	КонецЦикла;	
	
КонецПроцедуры   

&НаСервере 
Функция ЗагрузитьДокументОприходованиеТоваров(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Документы.уатОприходованиеТоваров.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		ОбъектКакОбъект = Документы.уатОприходованиеТоваров.СоздатьДокумент();
		ОбъектКакОбъект.Номер = СтруктураОбъекта.Номер;  
		ОбъектКакОбъект.Дата = СтруктураОбъекта.Дата;    
