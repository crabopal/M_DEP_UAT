&НаСервере
Функция ПолучитьЕдиницуИзмерения(Номенклатура, ЕдиницаПоКлассификатору)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕдиницыИзмерения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ЕдиницыИзмерения КАК ЕдиницыИзмерения
		|ГДЕ
		|	ЕдиницыИзмерения.Владелец = &Номенклатура
		|	И ЕдиницыИзмерения.ЕдиницаПоКлассификатору = &ЕдиницаПоКлассификатору";
	
	Запрос.УстановитьПараметр("ЕдиницаПоКлассификатору", ЕдиницаПоКлассификатору);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка; 
	КонецЦикла;
	
	ОбъектКакОбъект = Справочники.ЕдиницыИзмерения.СоздатьЭлемент();	
	ОбъектКакОбъект.УстановитьНовыйКод();
	ОбъектКакОбъект.Владелец = Номенклатура;
	ОбъектКакОбъект.Наименование = ЕдиницаПоКлассификатору.Наименование;
	ОбъектКакОбъект.ЕдиницаПоКлассификатору = ЕдиницаПоКлассификатору;
	ОбъектКакОбъект.Коэффициент = 1;
	
	ОбъектКакОбъект.ОбменДанными.Загрузка = Истина;
	ОбъектКакОбъект.Записать();
	
	Возврат ОбъектКакОбъект.Ссылка;

КонецФункции

&НаСервере
Функция ПолучитьНоменклатуру(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.Номенклатура.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		Если СтруктураОбъекта.ЭтоГруппа Тогда 

			ОбъектКакОбъект = Справочники.Номенклатура.СоздатьГруппу();

		Иначе

			ОбъектКакОбъект = Справочники.Номенклатура.СоздатьЭлемент();	
			ОбъектКакОбъект.Артикул = СтруктураОбъекта.Артикул; 
		//	ОбъектКакОбъект.ВидНоменклатуры = ПолучитьВидНоменклатуры(СтруктураОбъекта.ВидНоменклатуры);     //Реквизит появляется в версии 2.2
			ОбъектКакОбъект.ЕдиницаИзмерения = ПолучитьЕдиницуИзмеренияПоКлассификатору(СтруктураОбъекта.ЕдиницаИзмерения);
			ОбъектКакОбъект.Комментарий = СтруктураОбъекта.Комментарий;
			ОбъектКакОбъект.НаименованиеПолное = СтруктураОбъекта.НаименованиеПолное;
			ОбъектКакОбъект.НоменклатурнаяГруппа = ПолучитьНоменклатурнуюГруппу(СтруктураОбъекта.НоменклатурнаяГруппа);
			ОбъектКакОбъект.НомерГТД = ПолучитьНомерГТД(СтруктураОбъекта.НомерГТД);
			//ОбъектКакОбъект.СтавкаНДС = ПолучитьСтавкуНДС(СтруктураОбъекта.СтавкаНДС);
			ОбъектКакОбъект.СтранаПроисхождения = ПолучитьСтрануМира(СтруктураОбъекта.СтранаПроисхождения); 
			ОбъектКакОбъект.Услуга = СтруктураОбъекта.Услуга;
			
		КонецЕсли;	

		ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
		ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    

		Если СтруктураОбъекта.Свойство("Родитель") Тогда 
			ОбъектКакОбъект.Родитель = ПолучитьНоменклатуру(СтруктураОбъекта.Родитель);
		КонецЕсли;
		
		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					

		ОбъектКакОбъект.ОбменДанными.Загрузка = Истина;
		ОбъектКакОбъект.Записать();	

		//Заполнение зависимых реквизитов  
		Если Не ОбъектКакОбъект.ЭтоГруппа Тогда
			ОбъектКакОбъект.ЕдиницаХраненияОстатков = ПолучитьЕдиницуИзмерения(ОбъектКакОбъект.Ссылка, ОбъектКакОбъект.ЕдиницаИзмерения);
			ОбъектКакОбъект.Записать();	
		КонецЕсли;
		
		Возврат ОбъектКакОбъект.Ссылка;
		
	Иначе 
		
		Возврат СсылкаВИБ; 
		
	КонецЕсли;
	
КонецФункции		

