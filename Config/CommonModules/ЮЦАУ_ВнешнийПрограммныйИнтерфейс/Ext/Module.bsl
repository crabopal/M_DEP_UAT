&НаСервере
Функция ПолучитьВалюту(СтруктураОбъекта)

	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.Валюты.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				

		ОбъектКакСсылка = ПолучитьВалютуПоКоду(СтруктураОбъекта.Код); //Поиск по коду

		Если ОбъектКакСсылка = Неопределено Тогда
		
			ОбъектКакОбъект = Справочники.Валюты.СоздатьЭлемент();

			ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
			ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    
			ОбъектКакОбъект.НаименованиеПолное = СтруктураОбъекта.НаименованиеПолное;    
			ОбъектКакОбъект.ЗагружаетсяИзИнтернета = СтруктураОбъекта.ЗагружаетсяИзИнтернета; 
			ОбъектКакОбъект.Наценка = СтруктураОбъекта.Наценка;
			ОбъектКакОбъект.ОсновнаяВалюта = ПолучитьВалюту(СтруктураОбъекта.ОсновнаяВалюта);
			ОбъектКакОбъект.ПараметрыПрописи = СтруктураОбъекта.ПараметрыПрописи;    
			ОбъектКакОбъект.ФормулаРасчетаКурса = СтруктураОбъекта.ФормулаРасчетаКурса;    
			ОбъектКакОбъект.СпособУстановкиКурса = ПолучитьСпособУстановкиКурсаВалюты(СтруктураОбъекта.СпособУстановкиКурса);    
			
			ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					

			ОбъектКакОбъект.ОбменДанными.Загрузка = Истина;
			ОбъектКакОбъект.Записать();	
		
			Возврат ОбъектКакОбъект.Ссылка;

		Иначе
			
			Возврат ОбъектКакСсылка; 
			
		Конецесли;	
		
	Иначе
		
		Возврат СсылкаВИБ; 	
		
	КонецЕсли;
	
КонецФункции		

