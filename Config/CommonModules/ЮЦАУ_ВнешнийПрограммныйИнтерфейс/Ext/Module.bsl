	Если Не СтруктураОбъекта.ЭтоГруппа Тогда
	
		//СтруктураОбъекта.Вставить("ГосударственныйНомер", ТранспортноеСредство.ГосударственныйНомер);
		//СтруктураОбъекта.Вставить("ТипТС", ПолучитьСтруктуруТипТС(ТранспортноеСредство.ТипТС));
		//СтруктураОбъекта.Вставить("Модель", ПолучитьСтруктуруМодель(ТранспортноеСредство.Модель));
		
	КонецЕсли;

