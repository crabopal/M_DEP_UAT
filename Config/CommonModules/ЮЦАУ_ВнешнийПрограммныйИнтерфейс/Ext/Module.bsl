&НаСервере
Функция ПолучитьЕдиницуИзмеренияПоКлассификатору(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.КлассификаторЕдиницИзмерения.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				

		ОбъектКакСсылка = ПолучитьЕдиницуИзмеренияПоКоду(СтруктураОбъекта.Код); //Поиск по коду
		Если ОбъектКакСсылка = Неопределено Тогда
		
			Если СтруктураОбъекта.ЭтоГруппа Тогда 
				ОбъектКакОбъект = Справочники.КлассификаторЕдиницИзмерения.СоздатьГруппу();
			Иначе
				ОбъектКакОбъект = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
				ОбъектКакОбъект.НаименованиеПолное = СтруктураОбъекта.НаименованиеПолное;
			КонецЕсли;	

			ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
			ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    

			Если СтруктураОбъекта.Свойство("Родитель") Тогда 
				ОбъектКакОбъект.Родитель = ПолучитьЕдиницуИзмеренияПоКлассификатору(СтруктураОбъекта.Родитель);
			КонецЕсли;
			
			ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					

			ОбъектКакОбъект.ОбменДанными.Загрузка = Истина;
			ОбъектКакОбъект.Записать();	
			
			Возврат ОбъектКакОбъект.Ссылка;
			
		Иначе
			
			Возврат ОбъектКакСсылка;
			
		КонецЕсли;	
			
	Иначе 
		
		Возврат СсылкаВИБ; 
		
	КонецЕсли;
	
КонецФункции		

&НаСервере 
Функция ПолучитьСтавкуНДС(СтавкаНДС) 
	
	Если СтавкаНДС = "18%" Тогда
		Возврат Перечисления.СтавкиНДС.НДС18;
	ИначеЕсли СтавкаНДС = "18/118" Тогда
		Возврат Перечисления.СтавкиНДС.НДС18_118;
	ИначеЕсли СтавкаНДС = "10%" Тогда
		Возврат Перечисления.СтавкиНДС.НДС10;
	ИначеЕсли СтавкаНДС = "10/110" Тогда
		Возврат Перечисления.СтавкиНДС.НДС10_110;
	ИначеЕсли СтавкаНДС = "0%" Тогда
		Возврат Перечисления.СтавкиНДС.НДС0;
	ИначеЕсли СтавкаНДС = "Без НДС" Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	ИначеЕсли СтавкаНДС = "20%" Тогда
		Возврат Перечисления.СтавкиНДС.НДС20;
	ИначеЕсли СтавкаНДС = "20/120" Тогда
		Возврат Перечисления.СтавкиНДС.НДС20_120;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции	

