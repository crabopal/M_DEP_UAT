КонецФункции		

&НаСервере
Функция ПолучитьСтруктуруТС(ТранспортноеСредство)

	СтруктураОбъекта = Новый Структура;     
	
	СтруктураОбъекта.Вставить("Тип", "Справочник.уатТС"); 
	СтруктураОбъекта.Вставить("Идентификатор", ТранспортноеСредство.УникальныйИдентификатор());
	
	СтруктураОбъекта.Вставить("Наименование", ТранспортноеСредство.Наименование);
	СтруктураОбъекта.Вставить("ЭтоГруппа", ТранспортноеСредство.ЭтоГруппа);
	
	Если Не СтруктураОбъекта.ЭтоГруппа Тогда
	
		СтруктураОбъекта.Вставить("ГосударственныйНомер", ТранспортноеСредство.ГосударственныйНомер);
		СтруктураОбъекта.Вставить("ТипТС", ПолучитьСтруктуруТипТС(ТранспортноеСредство.ТипТС));
		СтруктураОбъекта.Вставить("Модель", ПолучитьСтруктуруМодель(ТранспортноеСредство.Модель));
		
	КонецЕсли;

	Если ЗначениеЗаполнено(ТранспортноеСредство.Родитель) Тогда
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруТС(ТранспортноеСредство.Родитель));	
	КонецЕсли;	
		
	Возврат СтруктураОбъекта;	
		
КонецФункции		

&НаСервере
Функция ВыгрузитьДанныеПоМаршрутамПутевыхЛистов(ЗапросJSON) Экспорт
	
	ДатаНачалаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("StartDate");
	ДатаКонцаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("EndDate");  
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	
	ДатаНачала = ?(ДатаНачалаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаНачалаСтрокой));		
	ДатаКонца  = ?(ДатаКонцаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаКонцаСтрокой));		

	СтруктураДанных = ВыгрузитьДанныеПоМаршрутамПутевыхЛистовФрагмент(ДатаКонца, ДатаНачала, Организация);


	Возврат СтруктураДанных;
	
КонецФункции

&НаСервере
Функция ВыгрузитьДанныеПоМаршрутамПутевыхЛистовФрагмент(Знач ДатаКонца, Знач ДатаНачала, Организация) Экспорт
	
	ДанныеПоМаршрутам = Новый Массив;
	
	Запрос = Новый Запрос;  
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	уатМестонахождениеТССрезПоследних.Период КАК Период,
	|	уатМестонахождениеТССрезПоследних.ТС КАК ТС,
	|	уатМестонахождениеТССрезПоследних.Организация КАК Организация,
	|	уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение,
	|	уатМестонахождениеТССрезПоследних.Колонна КАК Колонна
	|ПОМЕСТИТЬ ВТ_уатМестонахождениеТССрезПоследних
	|ИЗ
	|	РегистрСведений.уатМестонахождениеТС.СрезПоследних(&ГраницаДатаОкончания, Организация = &Организация) КАК уатМестонахождениеТССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Организация КАК Организация,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Организация.Наименование КАК ОрганизацияНаименование,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.ТранспортноеСредство КАК ТранспортноеСредство,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Маршрут КАК Маршрут,
	|	ВЫБОР
	|		КОГДА ЮЦАУ_ОборотыПоМаршрутамОбороты.НоменклатурнаяГруппа.Родитель <> ЗНАЧЕНИЕ(Справочник.НоменклатурныеГруппы.ПустаяСсылка)
	|			ТОГДА ЮЦАУ_ОборотыПоМаршрутамОбороты.НоменклатурнаяГруппа.Родитель
	|		ИНАЧЕ ЮЦАУ_ОборотыПоМаршрутамОбороты.НоменклатурнаяГруппа
	|	КОНЕЦ КАК НоменклатурнаяГруппа,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Сотрудник.ФизическоеЛицо КАК Физлицо,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Сотрудник.ФизическоеЛицо.Наименование КАК ФизлицоНаименование,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Сотрудник.ФизическоеЛицо.ИНН КАК ФизлицоИНН,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Сотрудник.ФизическоеЛицо.Пол КАК ФизлицоПол,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Сотрудник.ФизическоеЛицо.ДатаРождения КАК ФизлицоДатаРождения,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.РабочееВремяОборот КАК РабочееВремя,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.ВыручкаОборот КАК Выручка,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.КоличествоПассажировОборот КАК КоличествоПассажиров,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.КоличествоЕздокОборот КАК КоличествоЕздок,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.ПробегСПассажирамиОборот КАК ПробегСПассажирами,
	|	ВЗ_уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение
	|ИЗ
	|	РегистрНакопления.ЮЦАУ_ОборотыПоМаршрутам.Обороты(&ДатаНачала, &ГраницаДатаОкончания, Период, ) КАК ЮЦАУ_ОборотыПоМаршрутамОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТ_уатМестонахождениеТССрезПоследних.ТС КАК ТС,
	|			ВТ_уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение
	|		ИЗ
	|			ВТ_уатМестонахождениеТССрезПоследних КАК ВТ_уатМестонахождениеТССрезПоследних) КАК ВЗ_уатМестонахождениеТССрезПоследних
	|		ПО ЮЦАУ_ОборотыПоМаршрутамОбороты.ТранспортноеСредство = ВЗ_уатМестонахождениеТССрезПоследних.ТС
	|ГДЕ
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТранспортноеСредство,
	|	Маршрут,
	|	ЮЦАУ_ОборотыПоМаршрутамОбороты.Сотрудник
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	
	Граница = Новый Граница(КонецДня(ДатаКонца), ВидГраницы.Включая);
	Запрос.УстановитьПараметр("ГраницаДатаОкончания", Граница); 
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.РабочееВремя = 0 Тогда  //Нулевые коэффициенты не нужны
			Продолжить;
		КонецЕсли;	
		
		СтруктураСтроки = ПолучитьСтруктуруСтроки();
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, ВыборкаДетальныеЗаписи);
		
		СтруктураСтроки.ОрганизацияИдентификатор = ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Организация), ВыборкаДетальныеЗаписи.Организация.УникальныйИдентификатор(), Неопределено);
		СтруктураСтроки.ФизлицоИдентификатор = ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Физлицо), ВыборкаДетальныеЗаписи.Физлицо.УникальныйИдентификатор(), Неопределено);
		
		СтруктураСтроки.ФизлицоПол = Строка(ВыборкаДетальныеЗаписи.ФизлицоПол);
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Маршрут) Тогда 
			СтруктураМаршрут = ПолучитьСтруктуруМаршрут(ВыборкаДетальныеЗаписи.Маршрут);
			СтруктураСтроки.Вставить("Маршрут", СтруктураМаршрут);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Подразделение) Тогда 
			СтруктураПодразделение = ПолучитьСтруктуруПодразделение(ВыборкаДетальныеЗаписи.Подразделение);
			СтруктураСтроки.Вставить("Подразделение", СтруктураПодразделение);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТранспортноеСредство) Тогда 
			СтруктураТС = ПолучитьСтруктуруТС(ВыборкаДетальныеЗаписи.ТранспортноеСредство);
			СтруктураСтроки.Вставить("ТранспортноеСредство", СтруктураТС);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.НоменклатурнаяГруппа) Тогда 
			СтруктураНоменклатурнаяГруппа = ПолучитьСтруктуруНоменклатурнаяГруппа(ВыборкаДетальныеЗаписи.НоменклатурнаяГруппа);
			СтруктураСтроки.Вставить("НоменклатурнаяГруппа", СтруктураНоменклатурнаяГруппа);
		КонецЕсли;
		
		ДанныеПоМаршрутам.Добавить(СтруктураСтроки);  
		
	КонецЦикла;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДанныеПоМаршрутам", ДанныеПоМаршрутам);
	Возврат СтруктураДанных;

КонецФункции

&НаСервере
Функция ПолучитьСтруктуруСтроки()
	
	СтруктураСтроки = Новый Структура;
	СтруктураСтроки.Вставить("ОрганизацияИдентификатор", "");
