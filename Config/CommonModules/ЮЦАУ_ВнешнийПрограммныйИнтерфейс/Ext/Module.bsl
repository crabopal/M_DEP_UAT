&НаСервере
Функция ВыгрузитьСписаниеМатериалов(ЗапросJSON) Экспорт
	
	ДатаНачалаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("StartDate");
	ДатаКонцаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("EndDate");  
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	
	ДатаНачала = ?(ДатаНачалаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаНачалаСтрокой));		
	ДатаКонца  = ?(ДатаКонцаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаКонцаСтрокой));		

	ДанныеСписаниеМатериалов = Новый Массив;
	
	Запрос = Новый Запрос;  

	Запрос.Текст = 
		"ВЫБРАТЬ
		|	уатМестонахождениеТССрезПоследних.Период КАК Период,
		|	уатМестонахождениеТССрезПоследних.ТС КАК ТС,
		|	уатМестонахождениеТССрезПоследних.Организация КАК Организация,
		|	уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение,
		|	уатМестонахождениеТССрезПоследних.Колонна КАК Колонна
		|ПОМЕСТИТЬ ВТ_уатМестонахождениеТССрезПоследних
		|ИЗ
		|	РегистрСведений.уатМестонахождениеТС.СрезПоследних(&ГраницаДатаОкончания, Организация = &Организация) КАК уатМестонахождениеТССрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА уатНоменклатураТСОбороты.Регистратор ССЫЛКА Документ.уатРемонтныйЛист
		|				И уатНоменклатураТСОбороты.Регистратор.СпособРемонта = ЗНАЧЕНИЕ(Перечисление.уатСпособыРемонта.РемЗона)
		|			ТОГДА уатНоменклатураТСОбороты.Регистратор.Контрагент
		|		КОГДА уатНоменклатураТСОбороты.Регистратор ССЫЛКА Документ.уатВыдачаРасходныхМатериалов
		|			ТОГДА уатНоменклатураТСОбороты.Регистратор.Склад
		|		ИНАЧЕ NULL
		|	КОНЕЦ КАК Склад,
		|	уатНоменклатураТСОбороты.ТС КАК ТранспортноеСредство,
		|	уатНоменклатураТСОбороты.Номенклатура КАК Номенклатура,
		|	уатНоменклатураТСОбороты.КоличествоОборот КАК Количество,
		|	ВЗ_уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрНакопления.уатНоменклатураТС.Обороты(&ДатаНачала, &ГраницаДатаОкончания, Регистратор, ) КАК уатНоменклатураТСОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_уатМестонахождениеТССрезПоследних.ТС КАК ТС,
		|			ВТ_уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение
		|		ИЗ
		|			ВТ_уатМестонахождениеТССрезПоследних КАК ВТ_уатМестонахождениеТССрезПоследних) КАК ВЗ_уатМестонахождениеТССрезПоследних
		|		ПО уатНоменклатураТСОбороты.ТС = ВЗ_уатМестонахождениеТССрезПоследних.ТС
		|ГДЕ
		|	уатНоменклатураТСОбороты.Регистратор.Организация = &Организация
		|	И уатНоменклатураТСОбороты.Номенклатура ССЫЛКА Справочник.Номенклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	Склад,
		|	Подразделение,
		|	уатНоменклатураТСОбороты.ТС,
		|	Номенклатура
		|АВТОУПОРЯДОЧИВАНИЕ";	
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	
	Граница = Новый Граница(КонецДня(ДатаКонца), ВидГраницы.Включая);
    Запрос.УстановитьПараметр("ГраницаДатаОкончания", Граница); 
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураСтроки = ПолучитьСтруктуруСтрокиСписаниеМатериалов();
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, ВыборкаДетальныеЗаписи);
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Склад) Тогда 
			СтруктураСклад = ПолучитьСтруктуруСклад(ВыборкаДетальныеЗаписи.Склад);
			СтруктураСтроки.Вставить("Склад", СтруктураСклад);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТранспортноеСредство) Тогда 
			СтруктураТС = ПолучитьСтруктуруТС(ВыборкаДетальныеЗаписи.ТранспортноеСредство);
			СтруктураСтроки.Вставить("ТранспортноеСредство", СтруктураТС);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Подразделение) Тогда 
			СтруктураПодразделение = ПолучитьСтруктуруПодразделение(ВыборкаДетальныеЗаписи.Подразделение);
			СтруктураСтроки.Вставить("Подразделение", СтруктураПодразделение);
		КонецЕсли;	
		
		СтруктураСтроки.Вставить("Номенклатура", ПолучитьСтруктуруНоменклатура(ВыборкаДетальныеЗаписи.Номенклатура));
		
		ДанныеСписаниеМатериалов.Добавить(СтруктураСтроки);  
		
	КонецЦикла;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДанныеСписаниеМатериалов", ДанныеСписаниеМатериалов);

	Возврат СтруктураДанных;
	
КонецФункции

