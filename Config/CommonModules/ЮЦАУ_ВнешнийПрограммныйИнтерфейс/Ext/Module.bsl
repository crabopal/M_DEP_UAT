&НаСервере
Функция ПолучитьФизическоеЛицоПоФИОиИНН(ФИО, ИНН)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛица.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ФизическиеЛица КАК ФизическиеЛица
		|ГДЕ
		|	ФизическиеЛица.Наименование = &Наименование
		|	И ФизическиеЛица.ИНН = &ИНН";
	
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("Наименование", ФИО);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЦикла;
	
	Возврат Неопределено;

КонецФункции	

&НаСервере
Функция ПолучитьФизическоеЛицо(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.ФизическиеЛица.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД по ссылке
		
		ФизическоеЛицо = ПолучитьФизическоеЛицоПоФИОиИНН(СтруктураОбъекта.ФИО, СтруктураОбъекта.ИНН);
		Если ФизическоеЛицо <> Неопределено Тогда
			Возврат ФизическоеЛицо;
		КонецЕсли;	
		
		ОбъектКакОбъект = Справочники.ФизическиеЛица.СоздатьЭлемент();
		ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
		ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    
		ОбъектКакОбъект.ДатаРождения = СтруктураОбъекта.ДатаРождения; 
		
		Если СтруктураОбъекта.Пол = "Мужской" Тогда
			ОбъектКакОбъект.Пол = Перечисления.ПолФизическогоЛица.Мужской;
		ИначеЕсли СтруктураОбъекта.Пол = "Женский" Тогда
			ОбъектКакОбъект.Пол = Перечисления.ПолФизическогоЛица.Женский; 
		КонецЕсли;	
	
		ОбъектКакОбъект.ФИО = СтруктураОбъекта.ФИО;                                                
		ОбъектКакОбъект.ИНН = СтруктураОбъекта.ИНН;
		ОбъектКакОбъект.СтраховойНомерПФР = СтруктураОбъекта.СтраховойНомерПФР;                                                

		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					
		ОбъектКакОбъект.Записать();	

		Если СтруктураОбъекта.Свойство("КонтактнаяИнформация") Тогда

			//Обработка табличной части "КонтактнаяИнформация"
			Для Каждого СтрокаМассиваКИ Из СтруктураОбъекта.КонтактнаяИнформация Цикл
				СтруктураКИ = ПолучитьСтруктуруКонтактнойИнформации(СтрокаМассиваКИ);
				НоваяСтрока = ОбъектКакОбъект.КонтактнаяИнформация.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураКИ);
			КонецЦикла;	

			ОбъектКакОбъект.Записать();	
			
		КонецЕсли;	
		
		//Документы физического лица
		УстановитьДокументыФизическогоЛица(ОбъектКакОбъект.Ссылка, СтруктураОбъекта.ДокументыФизлица);
		//ФИО Физлица
		УстановитьФИОФизлица(ОбъектКакОбъект.Ссылка, СтруктураОбъекта);
		
		Возврат ОбъектКакОбъект.Ссылка;

	Иначе  

		Возврат СсылкаВИБ; 

	КонецЕсли;
	
КонецФункции		

