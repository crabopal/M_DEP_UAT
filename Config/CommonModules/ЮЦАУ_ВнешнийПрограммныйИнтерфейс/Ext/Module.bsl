Функция ПолучитьСписокСотрудников(ЗапросJSON) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТекущиеКадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
		|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|	ТекущиеКадровыеДанныеСотрудников.ДатаПриема КАК ДатаПриема,
		|	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения КАК ДатаУвольнения
		|ПОМЕСТИТЬ ВТ_ТекущиеКадровыеДанныеСотрудников
		|ИЗ
		|	РегистрСведений.ТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Сотрудник,
		|	Сотрудники.Наименование КАК СотрудникНаименование,
		|	Сотрудники.ФизическоеЛицо КАК ФизическоеЛицо,
		|	Сотрудники.ФизическоеЛицо.ИНН КАК ФизическоеЛицоИНН,
		|	Сотрудники.ФизическоеЛицо.СтраховойНомерПФР КАК ФизическоеЛицоСтраховойНомерПФР,
		|	Сотрудники.ФизическоеЛицо.Наименование КАК ФизическоеЛицоНаименование,
		|	ВЗ_ТекущиеКадровыеДанныеСотрудников.ДатаПриема КАК ДатаПриема,
		|	ВЗ_ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения КАК ДатаУвольнения
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_ТекущиеКадровыеДанныеСотрудников.Сотрудник КАК Сотрудник,
		|			ВТ_ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо КАК ФизическоеЛицо,
		|			ВТ_ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация КАК ГоловнаяОрганизация,
		|			ВТ_ТекущиеКадровыеДанныеСотрудников.ДатаПриема КАК ДатаПриема,
		|			ВТ_ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения КАК ДатаУвольнения
		|		ИЗ
		|			ВТ_ТекущиеКадровыеДанныеСотрудников КАК ВТ_ТекущиеКадровыеДанныеСотрудников) КАК ВЗ_ТекущиеКадровыеДанныеСотрудников
		|		ПО Сотрудники.Ссылка = ВЗ_ТекущиеКадровыеДанныеСотрудников.Сотрудник
		|			И Сотрудники.ФизическоеЛицо = ВЗ_ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо
		|			И Сотрудники.ГоловнаяОрганизация = ВЗ_ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация
		|ГДЕ
		|	Сотрудники.ЭтоГруппа = ЛОЖЬ
		|	И Сотрудники.ФизическоеЛицо.ЭтоГруппа = ЛОЖЬ
		|	И Сотрудники.ФизическоеЛицо <> ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)
		|	И Сотрудники.ВАрхиве = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивСотрудников = Новый Массив;

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураСотрудника = Новый Структура; 
		СтруктураСотрудника.Вставить("СотрудникУИД", ВыборкаДетальныеЗаписи.Сотрудник.УникальныйИдентификатор());   
		СтруктураСотрудника.Вставить("СотрудникНаименование", ВыборкаДетальныеЗаписи.СотрудникНаименование);   
		СтруктураСотрудника.Вставить("ДатаПриема", ВыборкаДетальныеЗаписи.ДатаПриема);   
		СтруктураСотрудника.Вставить("ДатаУвольнения", ВыборкаДетальныеЗаписи.ДатаУвольнения);   
		СтруктураСотрудника.Вставить("ФизическоеЛицоУИД", ВыборкаДетальныеЗаписи.ФизическоеЛицо.УникальныйИдентификатор());
		СтруктураСотрудника.Вставить("ФизическоеЛицоНаименование", ВыборкаДетальныеЗаписи.ФизическоеЛицоНаименование);   
		СтруктураСотрудника.Вставить("ФизическоеЛицоИНН", ВыборкаДетальныеЗаписи.ФизическоеЛицоИНН);         
		СтруктураСотрудника.Вставить("ФизическоеЛицоСтраховойНомерПФР", ВыборкаДетальныеЗаписи.ФизическоеЛицоСтраховойНомерПФР);         
		
		МассивСотрудников.Добавить(СтруктураСотрудника);
		
	КонецЦикла;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	НастройкиСериализацииJSON = Новый НастройкиСериализацииJSON;
	НастройкиСериализацииJSON.ВариантЗаписиДаты = ВариантЗаписиДатыJSON.ЛокальнаяДата;	
	НастройкиСериализацииJSON.ФорматСериализацииДаты = ФорматДатыJSON.ISO; 
	
	ЗаписьJSON.УстановитьСтроку();
	
	ЗаписатьJSON(ЗаписьJSON, МассивСотрудников, НастройкиСериализацииJSON, "ФункцияПреобразованияЗаписи", ЮЦАУ_ВнешнийПрограммныйИнтерфейс);    
	Результат = ЗаписьJSON.Закрыть();

	Возврат Результат;
	
КонецФункции	

