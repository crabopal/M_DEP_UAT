	ДатаКонца  = ?(ДатаКонцаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаКонцаСтрокой));		

	ДанныеПотреблениеТехническихЖидкостей = Новый Массив;
	
	Запрос = Новый Запрос;  
	Запрос.Текст =   
		"ВЫБРАТЬ
		|	уатМестонахождениеТССрезПоследних.Период КАК Период,
		|	уатМестонахождениеТССрезПоследних.ТС КАК ТС,
		|	уатМестонахождениеТССрезПоследних.Организация КАК Организация,
		|	уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение,
		|	уатМестонахождениеТССрезПоследних.Колонна КАК Колонна
		|ПОМЕСТИТЬ ВТ_уатМестонахождениеТССрезПоследних
		|ИЗ
		|	РегистрСведений.уатМестонахождениеТС.СрезПоследних(&ГраницаДатаОкончания, Организация = &Организация) КАК уатМестонахождениеТССрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	уатРасходТехническихЖидкостей.Регистратор.Склад КАК Склад,
		|	уатРасходТехническихЖидкостей.ТС КАК ТранспортноеСредство,
		|	уатРасходТехническихЖидкостей.ГСМ КАК Номенклатура,
		|	СУММА(ЕСТЬNULL(уатРасходТехническихЖидкостей.КоличествоПриходОборот, 0)) КАК РасходПоФакту,
		|	ВЗ_уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрНакопления.уатОборотыТЖнаТС.Обороты(&ДатаНачала, &ГраницаДатаОкончания, Регистратор, Организация = &Организация) КАК уатРасходТехническихЖидкостей
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение,
		|			ВТ_уатМестонахождениеТССрезПоследних.ТС КАК ТС
		|		ИЗ
		|			ВТ_уатМестонахождениеТССрезПоследних КАК ВТ_уатМестонахождениеТССрезПоследних) КАК ВЗ_уатМестонахождениеТССрезПоследних
		|		ПО уатРасходТехническихЖидкостей.ТС = ВЗ_уатМестонахождениеТССрезПоследних.ТС
		|
		|СГРУППИРОВАТЬ ПО
		|	уатРасходТехническихЖидкостей.Регистратор.Склад,
		|	уатРасходТехническихЖидкостей.ТС,
		|	уатРасходТехническихЖидкостей.ГСМ,
		|	ВЗ_уатМестонахождениеТССрезПоследних.Подразделение";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	
	Граница = Новый Граница(КонецДня(ДатаКонца), ВидГраницы.Включая);
    Запрос.УстановитьПараметр("ГраницаДатаОкончания", Граница); 
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураСтроки = ПолучитьСтруктуруСтрокиПотреблениеГСМ();
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, ВыборкаДетальныеЗаписи);
		
		СтруктураСтроки.Вставить("Склад", ПолучитьСтруктуруСклад(ВыборкаДетальныеЗаписи.Склад));

		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТранспортноеСредство) Тогда 
			СтруктураТС = ПолучитьСтруктуруТС(ВыборкаДетальныеЗаписи.ТранспортноеСредство);
			СтруктураСтроки.Вставить("ТранспортноеСредство", СтруктураТС);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Подразделение) Тогда 
			СтруктураПодразделение = ПолучитьСтруктуруПодразделение(ВыборкаДетальныеЗаписи.Подразделение);
			СтруктураСтроки.Вставить("Подразделение", СтруктураПодразделение);
		КонецЕсли;	

		СтруктураСтроки.Вставить("Номенклатура", ПолучитьСтруктуруНоменклатура(ВыборкаДетальныеЗаписи.Номенклатура));
		
		ДанныеПотреблениеТехническихЖидкостей.Добавить(СтруктураСтроки);  
		
	КонецЦикла;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДанныеПотреблениеТехническихЖидкостей", ДанныеПотреблениеТехническихЖидкостей);

	Возврат СтруктураДанных;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруСтрокиПотреблениеГСМ()
	
	СтруктураСтроки = Новый Структура;

	СтруктураСтроки.Вставить("РасходПоНорме", 0); 
	СтруктураСтроки.Вставить("РасходПоФакту", 0); 
	
	Возврат СтруктураСтроки;
	
КонецФункции	

&НаСервере
Функция ПолучитьСтруктуруНоменклатура(Номенклатура)
	
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.Номенклатура");
	СтруктураОбъекта.Вставить("Идентификатор", Номенклатура.УникальныйИдентификатор());
	СтруктураОбъекта.Вставить("ЭтоГруппа", Номенклатура.ЭтоГруппа);
	СтруктураОбъекта.Вставить("Код", Номенклатура.Код);
	СтруктураОбъекта.Вставить("Наименование", Номенклатура.Наименование);
	//СтруктураОбъекта.Вставить("ВидНоменклатуры", ПолучитьСтруктуруВидНоменклатуры(Номенклатура.ВидНоменклатуры));

	Если Номенклатура.ЭтоГруппа = Ложь Тогда
		СтруктураОбъекта.Вставить("НаименованиеПолное", Номенклатура.НаименованиеПолное);
		СтруктураОбъекта.Вставить("Артикул", Номенклатура.Артикул);
		СтруктураОбъекта.Вставить("Комментарий", Номенклатура.Комментарий);
		СтруктураОбъекта.Вставить("ЕдиницаИзмерения", ПолучитьСтруктуруЕдиницаИзмерения(Номенклатура.ЕдиницаИзмерения));
		СтруктураОбъекта.Вставить("Услуга", Номенклатура.Услуга);
		//СтруктураОбъекта.Вставить("КодГруза", Номенклатура.КодГруза);
	КонецЕсли;

	Если ЗначениеЗаполнено(Номенклатура.Родитель) Тогда         
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруНоменклатура(Номенклатура.Родитель));
	КонецЕсли;	
	
	Возврат СтруктураОбъекта;

КонецФункции	

&НаСервере
Функция ПолучитьСтруктуруСклад(Склад)
	
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.Склады");
	СтруктураОбъекта.Вставить("Идентификатор", Склад.УникальныйИдентификатор());
	СтруктураОбъекта.Вставить("ЭтоГруппа", Склад.ЭтоГруппа);
	СтруктураОбъекта.Вставить("Код", Склад.Код);
	СтруктураОбъекта.Вставить("Наименование", Склад.Наименование);

	Если Склад.ЭтоГруппа = Ложь Тогда
		СтруктураОбъекта.Вставить("Комментарий", Склад.Комментарий);
		СтруктураОбъекта.Вставить("ВидСклада", Строка(Склад.ВидСклада));
	КонецЕсли;

	Если ЗначениеЗаполнено(Склад.Родитель) Тогда         
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруСклад(Склад.Родитель));
	КонецЕсли;	
	
	Возврат СтруктураОбъекта;

КонецФункции	

