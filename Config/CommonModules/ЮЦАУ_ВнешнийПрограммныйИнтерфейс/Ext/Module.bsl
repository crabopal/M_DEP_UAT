Функция ПолучитьСтруктуруНоменклатурнаяГруппа(НоменклатурнаяГруппа)

	СтруктураОбъекта = Новый Структура;     
	
	СтруктураОбъекта.Вставить("Тип", "Справочник.НоменклатурныеГруппы"); 
	СтруктураОбъекта.Вставить("Идентификатор", НоменклатурнаяГруппа.УникальныйИдентификатор());
	
