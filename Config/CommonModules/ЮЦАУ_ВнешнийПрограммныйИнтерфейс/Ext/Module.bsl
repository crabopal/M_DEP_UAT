&НаСервере
Функция ПолучитьТипКонтактнойИнформации(ТипКИ) 
	
	ТипКадровойИнформации = Неопределено;
	Если ТипКИ = "Адрес" Тогда 
		ТипКадровойИнформации = Перечисления.ТипыКонтактнойИнформации.Адрес;
	ИначеЕсли ТипКИ = "Телефон" Тогда 
		ТипКадровойИнформации = Перечисления.ТипыКонтактнойИнформации.Телефон;
	ИначеЕсли ТипКИ = "Адрес электронной почты" Тогда 
		ТипКадровойИнформации = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
	ИначеЕсли ТипКИ = "Skype" Тогда 
		ТипКадровойИнформации = Перечисления.ТипыКонтактнойИнформации.Skype;
	ИначеЕсли ТипКИ = "Веб страница" Тогда 
		ТипКадровойИнформации = Перечисления.ТипыКонтактнойИнформации.ВебСтраница;
	ИначеЕсли ТипКИ = "Факс" Тогда 
		ТипКадровойИнформации = Перечисления.ТипыКонтактнойИнформации.Факс;
	ИначеЕсли ТипКИ = "Другое" Тогда 
		ТипКадровойИнформации = Перечисления.ТипыКонтактнойИнформации.Другое;
	КонецЕсли;	

	Возврат ТипКадровойИнформации;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруКонтактнойИнформации(СтруктураОбъекта)
	
	СтруктураКИ = Новый Структура; 
	СтруктураКИ.Вставить("АдресЭП", СтруктураОбъекта.АдресЭП);
	СтруктураКИ.Вставить("Вид", ПолучитьВидКонтактнойИнформации(СтруктураОбъекта.Вид));
	СтруктураКИ.Вставить("ВидДляСписка", ПолучитьВидКонтактнойИнформации(СтруктураОбъекта.ВидДляСписка));
	СтруктураКИ.Вставить("Город", СтруктураОбъекта.Город);
	СтруктураКИ.Вставить("ДоменноеИмяСервера", СтруктураОбъекта.ДоменноеИмяСервера);
	СтруктураКИ.Вставить("Значение", СтруктураОбъекта.Значение);
	
	СтруктураКИ.Вставить("ЗначенияПолей", СтруктураОбъекта.ЗначенияПолей);
	СтруктураКИ.Вставить("НомерТелефона", СтруктураОбъекта.НомерТелефона);
	СтруктураКИ.Вставить("НомерТелефонаБезКодов", СтруктураОбъекта.НомерТелефонаБезКодов);
	СтруктураКИ.Вставить("Представление", СтруктураОбъекта.Представление);
	СтруктураКИ.Вставить("Регион", СтруктураОбъекта.Регион);
	СтруктураКИ.Вставить("Страна", СтруктураОбъекта.Страна);
	СтруктураКИ.Вставить("Тип", ПолучитьТипКонтактнойИнформации(СтруктураОбъекта.Тип));
	
	Возврат СтруктураКИ;
	 
КонецФункции

&НаСервере
Процедура УстановитьДокументыФизическогоЛица(ФизическоеЛицо, МассивДокументыФизлица)

	Для Каждого СтрокаМассива Из МассивДокументыФизлица Цикл
		
		ВидДокумента = ПолучитьВидДокумента(СтрокаМассива.ВидДокумента);
				
		//Запись в регистр
		НаборЗаписей = РегистрыСведений.ДокументыФизическихЛиц.СоздатьНаборЗаписей(); 

		НаборЗаписей.Отбор.Период.Установить(СтрокаМассива.ДатаВыдачи); 
		НаборЗаписей.Отбор.Физлицо.Установить(ФизическоеЛицо); 
		НаборЗаписей.Отбор.ВидДокумента.Установить(ВидДокумента); 

		НоваяЗапись = НаборЗаписей.Добавить(); 
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаМассива); 
		
		НоваяЗапись.Период = СтрокаМассива.ДатаВыдачи; 
		НоваяЗапись.Физлицо = ФизическоеЛицо; 
		НоваяЗапись.ВидДокумента = ВидДокумента; 
		
		НаборЗаписей.Записать(); 
		
	КонецЦикла;	
	
КонецПроцедуры 

&НаСервере
Процедура УстановитьФИОФизлица(ФизЛицоОбъект, СтруктураОбъекта)
	
	МенеджерЗаписи = РегистрыСведений.ФИОФизическихЛиц.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период         = '18991231';
	МенеджерЗаписи.ФизическоеЛицо = ФизЛицоОбъект.Ссылка;
	МенеджерЗаписи.Фамилия        = СтруктураОбъекта.Фамилия;
	МенеджерЗаписи.Имя            = СтруктураОбъекта.Имя;
	МенеджерЗаписи.Отчество       = СтруктураОбъекта.Отчество;
	МенеджерЗаписи.Записать(Истина);
	
КонецПроцедуры	

