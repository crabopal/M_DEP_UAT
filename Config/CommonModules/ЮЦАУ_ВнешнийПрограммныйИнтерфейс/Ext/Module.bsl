&НаСервере
Функция ПолучитьСтруктуруОрганизация(Организация)
	
	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.Организации");
	СтруктураОбъекта.Вставить("Идентификатор", Организация.УникальныйИдентификатор());
	
	СтруктураОбъекта.Вставить("Код", Организация.Код);
	СтруктураОбъекта.Вставить("Наименование", Организация.Наименование);
	СтруктураОбъекта.Вставить("ИНН", Организация.ИНН);
	СтруктураОбъекта.Вставить("КПП", Организация.КПП);
		
	Возврат СтруктураОбъекта;

КонецФункции	      

&НаСервере
Функция ПолучитьСтруктуруПодразделение(Подразделение)

	СтруктураОбъекта = Новый Структура();
	СтруктураОбъекта.Вставить("Тип", "Справочник.ПодразделенияОрганизаций");
	СтруктураОбъекта.Вставить("Идентификатор", Подразделение.УникальныйИдентификатор());
	СтруктураОбъекта.Вставить("Владелец", ПолучитьСтруктуруОрганизация(Подразделение.Владелец));
	СтруктураОбъекта.Вставить("Код", Подразделение.Код);
	СтруктураОбъекта.Вставить("Наименование", Подразделение.Наименование);
	СтруктураОбъекта.Вставить("ЭтоГруппа", Подразделение.ЭтоГруппа);
	
	Если ЗначениеЗаполнено(Подразделение.Родитель) Тогда
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруПодразделение(Подразделение.Родитель));
	КонецЕсли;	 
	
	Если Подразделение.ЭтоГруппа = Ложь Тогда
		СтруктураОбъекта.Вставить("КПП", Подразделение.КПП);
		СтруктураОбъекта.Вставить("КодПоОКАТО", Подразделение.КодПоОКАТО);
	КонецЕсли;	
	
	Возврат СтруктураОбъекта;

КонецФункции

&НаСервере
Функция ВыгрузитьПотреблениеТоплива(ЗапросJSON) Экспорт
	
	ДатаНачалаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("StartDate");
	ДатаКонцаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("EndDate");  
	Организация = Справочники.Организации.ОрганизацияПоУмолчанию();
	
	ДатаНачала = ?(ДатаНачалаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаНачалаСтрокой));		
	ДатаКонца  = ?(ДатаКонцаСтрокой=Неопределено, Дата(1,1,1), ПолучитьДатуИзСтроки(ДатаКонцаСтрокой));		

	ДанныеПотреблениеТоплива = Новый Массив;
	
	//В запросе отбрасываются граничные записи, принадлежащие предыдущему периоду и загружаются граничные записи, принадлежащие следующему периоду 
	//Например, п/л 30.04.2023 попадает в период 01.05.2023 из-за произведенной ночной заправки 01.05.2023 (его нужно отбросить)  
	//А п/л 31.05.2023 попадает в период 01.06.2023 из-за произведенной ночной заправки 01.06.2023 (его наоборот нужно включить)
	//Такова специфика работы предприятия
	Запрос = Новый Запрос;  
	Запрос.Текст =    
		"ВЫБРАТЬ
		|	уатМестонахождениеТССрезПоследних.Период КАК Период,
		|	уатМестонахождениеТССрезПоследних.ТС КАК ТС,
		|	уатМестонахождениеТССрезПоследних.Организация КАК Организация,
		|	уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение,
		|	уатМестонахождениеТССрезПоследних.Колонна КАК Колонна
		|ПОМЕСТИТЬ ВТ_уатМестонахождениеТССрезПоследних
		|ИЗ
		|	РегистрСведений.уатМестонахождениеТС.СрезПоследних(&ДатаОкончания, Организация = &Организация) КАК уатМестонахождениеТССрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	уатРасходГСМнаТСОбороты.Регистратор КАК Регистратор,
		|	уатРасходГСМнаТСОбороты.ТС КАК ТранспортноеСредство,
		|	уатРасходГСМнаТСОбороты.ГСМ КАК Номенклатура,
		|	уатРасходГСМнаТСОбороты.РасходПоНормеОборот КАК РасходПоНорме,
		|	уатРасходГСМнаТСОбороты.РасходПоФактуОборот КАК РасходПоФакту
		|ПОМЕСТИТЬ ВТ_РасходГСМвПериоде
		|ИЗ
		|	РегистрНакопления.уатРасходГСМнаТС.Обороты(, , Регистратор, ) КАК уатРасходГСМнаТСОбороты
		|ГДЕ
		|	уатРасходГСМнаТСОбороты.Организация = &Организация
		|	И уатРасходГСМнаТСОбороты.Регистратор.ДатаВыезда МЕЖДУ &ДатаНачала И &ДатаОкончания
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_РасходГСМвПериоде.ТранспортноеСредство КАК ТранспортноеСредство,
		|	ВТ_РасходГСМвПериоде.Номенклатура КАК Номенклатура,
		|	СУММА(ВТ_РасходГСМвПериоде.РасходПоНорме) КАК РасходПоНорме,
		|	СУММА(ВТ_РасходГСМвПериоде.РасходПоФакту) КАК РасходПоФакту,
		|	ВЗ_уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение
		|ИЗ
		|	ВТ_РасходГСМвПериоде КАК ВТ_РасходГСМвПериоде
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВТ_уатМестонахождениеТССрезПоследних.ТС КАК ТС,
		|			ВТ_уатМестонахождениеТССрезПоследних.Подразделение КАК Подразделение
		|		ИЗ
		|			ВТ_уатМестонахождениеТССрезПоследних КАК ВТ_уатМестонахождениеТССрезПоследних) КАК ВЗ_уатМестонахождениеТССрезПоследних
		|		ПО ВТ_РасходГСМвПериоде.ТранспортноеСредство = ВЗ_уатМестонахождениеТССрезПоследних.ТС
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_РасходГСМвПериоде.ТранспортноеСредство,
		|	ВТ_РасходГСМвПериоде.Номенклатура,
		|	ВЗ_уатМестонахождениеТССрезПоследних.Подразделение
		|
		|УПОРЯДОЧИТЬ ПО
		|	ТранспортноеСредство,
		|	Номенклатура
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаКонца));
	
	Граница = Новый Граница(КонецДня(ДатаКонца), ВидГраницы.Включая);
    Запрос.УстановитьПараметр("ГраницаДатаОкончания", Граница); 
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураСтроки = ПолучитьСтруктуруСтрокиПотреблениеГСМ();
		ЗаполнитьЗначенияСвойств(СтруктураСтроки, ВыборкаДетальныеЗаписи);
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ТранспортноеСредство) Тогда 
			СтруктураТС = ПолучитьСтруктуруТС(ВыборкаДетальныеЗаписи.ТранспортноеСредство);
			СтруктураСтроки.Вставить("ТранспортноеСредство", СтруктураТС);
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Подразделение) Тогда 
			СтруктураПодразделение = ПолучитьСтруктуруПодразделение(ВыборкаДетальныеЗаписи.Подразделение);
			СтруктураСтроки.Вставить("Подразделение", СтруктураПодразделение);
		КонецЕсли;	

		СтруктураСтроки.Вставить("Номенклатура", ПолучитьСтруктуруНоменклатура(ВыборкаДетальныеЗаписи.Номенклатура));
		
		ДанныеПотреблениеТоплива.Добавить(СтруктураСтроки);  
		
	КонецЦикла;
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДанныеПотреблениеТоплива", ДанныеПотреблениеТоплива);

	Возврат СтруктураДанных;
	
КонецФункции

&НаСервере
Функция ВыгрузитьРасходТехническихЖидкостей(ЗапросJSON) Экспорт
	
	ДатаНачалаСтрокой = ЗапросJSON.ПараметрыЗапроса.Получить("StartDate");
