Функция ПолучитьПозициюПервогоРазделителяДаты(ДатаСтрокой)

	ПозицияПервогоРазделителя = 0;
	СтрокаЦифр = "0123456789";
	ДлинаСтроки = СтрДлина(ДатаСтрокой);
	Для й=1 По ДлинаСтроки Цикл
		ТекущийСимвол = Сред(ДатаСтрокой,й,1);
		Если СтрНайти(СтрокаЦифр,ТекущийСимвол) = 0 Тогда 
			ПозицияПервогоРазделителя = й;			
			Прервать;
		КонецЕсли;		
	КонецЦикла;	  
	
	Возврат ПозицияПервогоРазделителя;
	
КонецФункции	

Функция ПолучитьДатуИзСтроки(СтрокаСДатой) Экспорт

	ДатаСтрокой = СокрЛП(СтрокаСДатой);
	
	Если ДатаСтрокой = "" Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;	
	
	Если СтрДлина(ДатаСтрокой) = 19 Тогда 
		// 2021-09-05 06:59:51
		
		Год = Число(Лев(ДатаСтрокой,4));
		Месяц = Число(Сред(ДатаСтрокой,6,2));
		День = Число(Сред(ДатаСтрокой,9,2));
		Час = Число(Сред(ДатаСтрокой,12,2));
		Минута = Число(Сред(ДатаСтрокой,15,2));
		Секунда = Число(Сред(ДатаСтрокой,18,2));
		
		ДатаДатой = Дата(Год, Месяц, День, Час, Минута, Секунда);
		
	ИначеЕсли СтрДлина(ДатаСтрокой) = 10 Тогда
		
		ПозицияПервогоРазделителя = ПолучитьПозициюПервогоРазделителяДаты(ДатаСтрокой);		
		Если ПозицияПервогоРазделителя = 3 Тогда		

			// 05.11.2019
			
			День = Число(Лев(ДатаСтрокой,2));
			Месяц = Число(Сред(ДатаСтрокой,4,2));
			Год = Число(Сред(ДатаСтрокой,7,4));
			
		ИначеЕсли ПозицияПервогоРазделителя = 5 Тогда			
			
			// 2019-11-05
			Год = Число(Лев(ДатаСтрокой,4));
			Месяц = Число(Сред(ДатаСтрокой,6,2));
			День = Число(Сред(ДатаСтрокой,9,2));
			
		КонецЕсли;	
		
		ДатаДатой = Дата(Год, Месяц, День);
		
	ИначеЕсли СтрДлина(ДатаСтрокой) = 7 Тогда 
		//01.2019
		
		День = 1;
		Месяц = Число(Лев(ДатаСтрокой,2));
		Год = Число(Сред(ДатаСтрокой,4));
		
		ДатаДатой = Дата(Год, Месяц, День);
		
	ИначеЕсли СтрДлина(ДатаСтрокой) = 8 Тогда 
		//13112020
		
		День = Число(Лев(ДатаСтрокой,2));
		Месяц = Число(Сред(ДатаСтрокой,3,2));
		Год = Число(Сред(ДатаСтрокой,5));
		
		ДатаДатой = Дата(Год, Месяц, День);
		
		
	ИначеЕсли СтрДлина(ДатаСтрокой) = 12 Тогда 	
		
		//4 кв.2012 г.
		//3 кв.2012 г.

		НомерКвартала = Число(Лев(ДатаСтрокой,1));
		Год = Число(Сред(ДатаСтрокой,6,4));
		
		ДатаДатой = КонецМесяца(Дата(Год, НомерКвартала*3, 1));
		

	Иначе	
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	
	Возврат ДатаДатой;

КонецФункции		

&НаСервере
Функция ПолучитьСтруктуруТипТС(ТипТС)

	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("Тип", "Справочник.уатТипыТС");
	СтруктураОбъекта.Вставить("Идентификатор", ТипТС.УникальныйИдентификатор());
	СтруктураОбъекта.Вставить("Код", ТипТС.Код);
	СтруктураОбъекта.Вставить("Наименование", ТипТС.Наименование);
	СтруктураОбъекта.Вставить("Родитель", ТипТС.Родитель);
	СтруктураОбъекта.Вставить("ЭтоГруппа", ТипТС.ЭтоГруппа);
	СтруктураОбъекта.Вставить("ВидТС", Строка(ТипТС.ВидТС));  
	СтруктураОбъекта.Вставить("Комментарий", ТипТС.Комментарий);
	
	Возврат СтруктураОбъекта;

КонецФункции

&НаСервере
Функция ПолучитьСтруктуруМаршрут(Маршрут)

	СтруктураОбъекта = Новый Структура;
	СтруктураОбъекта.Вставить("Тип", "Справочник.уатМаршруты");
	СтруктураОбъекта.Вставить("Идентификатор", Маршрут.УникальныйИдентификатор());
	СтруктураОбъекта.Вставить("Код", Маршрут.Код);
	СтруктураОбъекта.Вставить("Наименование", Маршрут.Наименование);
	СтруктураОбъекта.Вставить("ЭтоГруппа", Маршрут.ЭтоГруппа);
	
	Если ЗначениеЗаполнено(Маршрут.Родитель) Тогда
		СтруктураОбъекта.Вставить("Родитель", ПолучитьСтруктуруМаршрут(Маршрут.Родитель));	
	КонецЕсли;	
		
	Возврат СтруктураОбъекта;

КонецФункции

