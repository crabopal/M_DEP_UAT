	СтруктураСтроки.Вставить("ФизлицоИНН", "");
	СтруктураСтроки.Вставить("ФизлицоПол", "");
	СтруктураСтроки.Вставить("ФизлицоДатаРождения", "");
		
	СтруктураСтроки.Вставить("РабочееВремя", 0); 
	СтруктураСтроки.Вставить("Выручка", 0); 
	СтруктураСтроки.Вставить("КоличествоПассажиров", 0); 
	СтруктураСтроки.Вставить("КоличествоЕздок", 0); 
	СтруктураСтроки.Вставить("ПробегСПассажирами", 0); 
	
	Возврат СтруктураСтроки;
	
КонецФункции	

