&НаСервере
Функция ПолучитьКонтрагента(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.Контрагенты.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		Если СтруктураОбъекта.ЭтоГруппа Тогда 
			
			ОбъектКакОбъект = Справочники.Контрагенты.СоздатьГруппу();
			
		Иначе
			
			ОбъектКакОбъект = Справочники.Контрагенты.СоздатьЭлемент();	
			ОбъектКакОбъект.НаименованиеПолное = СтруктураОбъекта.НаименованиеПолное;
			ОбъектКакОбъект.Комментарий = СтруктураОбъекта.Комментарий;
			ОбъектКакОбъект.ИНН = СтруктураОбъекта.ИНН;
			ОбъектКакОбъект.КПП = СтруктураОбъекта.КПП;
			ОбъектКакОбъект.КодПоОКПО = СтруктураОбъекта.КодПоОКПО;
			ОбъектКакОбъект.ДополнительноеОписание = СтруктураОбъекта.ДополнительноеОписание;
			ОбъектКакОбъект.ЮридическоеФизическоеЛицо = ПолучитьЮридическоеФизическоеЛицо(СтруктураОбъекта.ЮридическоеФизическоеЛицо);
			//ОбъектКакОбъект.СтранаРегистрации = ПолучитьСтрануМира(СтруктураОбъекта.СтранаРегистрации);  //Отсутствуют в версии 2.1.3
			//ОбъектКакОбъект.НалоговыйНомер = СтруктураОбъекта.НалоговыйНомер;
			
		КонецЕсли;	

		ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
		ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    

		Если СтруктураОбъекта.Свойство("Родитель") Тогда 
			ОбъектКакОбъект.Родитель = ПолучитьКонтрагента(СтруктураОбъекта.Родитель);
		КонецЕсли;
		
		ОбъектКакОбъект.УстановитьСсылкуНового(СсылкаВИБ);					

		ОбъектКакОбъект.ОбменДанными.Загрузка = Истина;
		ОбъектКакОбъект.Записать();	
		
		Если СтруктураОбъекта.Свойство("ГоловнойКонтрагент") Тогда
			ОбъектКакОбъект.ГоловнойКонтрагент = ПолучитьКонтрагента(СтруктураОбъекта.ГоловнойКонтрагент);
			ОбъектКакОбъект.Записать();	
		КонецЕсли;	
		
		Возврат ОбъектКакОбъект.Ссылка;
		
	Иначе 
		
		Возврат СсылкаВИБ; 
		
	КонецЕсли;
	
КонецФункции		

&НаСервере
Функция ПолучитьВидДоговора(ВидДоговора)

	Если ВидДоговора = "С покупателем" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
	ИначеЕсли ВидДоговора = "С поставщиком" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	ИначеЕсли ВидДоговора = "С комитентом (принципалом) на продажу" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.СКомитентом;
	ИначеЕсли ВидДоговора = "С комиссионером (агентом) на продажу" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером;
	ИначеЕсли ВидДоговора = "С комитентом (принципалом) на закупку" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку;
	ИначеЕсли ВидДоговора = "С комиссионером (агентом) на закупку" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку;
	ИначеЕсли ВидДоговора = "С факторинговой компанией" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.Прочее;
	ИначеЕсли ВидДоговора = "С транспортной компанией (доставка и оплата)" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
	ИначеЕсли ВидДоговора = "Прочее" Тогда
		Возврат Перечисления.ВидыДоговоровКонтрагентов.Прочее;
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции			

&НаСервере
Функция ПолучитьДоговорКонтрагента(СтруктураОбъекта)
	
	УИДСсылки = Новый УникальныйИдентификатор(СтруктураОбъекта.Идентификатор);
	СсылкаВИБ = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(УИДСсылки);
	
	Если СтрНайти(СсылкаВИБ, "Объект не найден") > 0 Тогда //Объекта нет в БД				
		
		Если СтруктураОбъекта.ЭтоГруппа Тогда

			ОбъектКакОбъект = Справочники.ДоговорыКонтрагентов.СоздатьГруппу();

		Иначе	
			
			ОбъектКакОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
			ОбъектКакОбъект.ВалютаВзаиморасчетов = ПолучитьВалюту(СтруктураОбъекта.ВалютаВзаиморасчетов);
			ОбъектКакОбъект.ВидВзаиморасчетов = ПолучитьВидВзаиморасчетов(СтруктураОбъекта.ВидВзаиморасчетов);
			ОбъектКакОбъект.ВидДоговора = ПолучитьВидДоговора(СтруктураОбъекта.ВидДоговора);
			ОбъектКакОбъект.Комментарий = СтруктураОбъекта.Комментарий;    
			ОбъектКакОбъект.Дата = СтруктураОбъекта.Дата;    
			ОбъектКакОбъект.Номер = СтруктураОбъекта.Номер;    
			ОбъектКакОбъект.Организация = ПолучитьОрганизацию(СтруктураОбъекта.Организация);    
			ОбъектКакОбъект.РасчетыВУсловныхЕдиницах = СтруктураОбъекта.РасчетыВУсловныхЕдиницах;
			ОбъектКакОбъект.ТипЦен = ПолучитьТипЦенНоменклатуры(СтруктураОбъекта.ТипЦен);  
			ОбъектКакОбъект.Контрагент = ПолучитьКонтрагента(СтруктураОбъекта.Контрагент);
			
		КонецЕсли;	
		
		ОбъектКакОбъект.Владелец = ПолучитьКонтрагента(СтруктураОбъекта.Владелец);  
		ОбъектКакОбъект.Код = СтруктураОбъекта.Код;  
		ОбъектКакОбъект.Наименование = СтруктураОбъекта.Наименование;    
		
		Если СтруктураОбъекта.Свойство("Родитель") Тогда 
			ОбъектКакОбъект.Родитель = ПолучитьДоговорКонтрагента(СтруктураОбъекта.Родитель);
		КонецЕсли;
		
