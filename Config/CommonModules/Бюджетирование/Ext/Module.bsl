Процедура СгенерироватьЗапросПоНастройкамРегНакопления(СтатьяБюджета) Экспорт
	
	номПараметра = 1;
	
	Источник = СтатьяБюджета.ИсточникДанныхДляФакта;
	
	Если Источник <> Справочники.ИсточникиДанныхДляРасчетовБюджетирования.ПустаяСсылка() Тогда
		обИсточник = Источник.ПолучитьОбъект();
	Иначе
		Возврат;
	КонецЕсли;
	
	ПараметрыПостроителя = обИсточник.НастройкиПостроителя.Получить().ПараметрыПостроителя; 
	НастройкиПостроителя = обИсточник.НастройкиПостроителя.Получить();
	Если ПараметрыПостроителя.Количество() > 0 Тогда
		ПараметрыПостроителя.Очистить();
	КонецЕсли;	                                             
	
	тНачалоШапки = "ВЫБРАТЬ ";                               
	тРезультат = "";
	тЗапроса   = "";
	тКонецШапки = " КАК Сумма,";                         
	
	НастройкиИсточника = СтатьяБюджета.ХранилищеНастроекПоРегНак.Получить();
	
	Если НастройкиИсточника = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Для Каждого ВыборкаСтроки Из НастройкиИсточника Цикл
		
		Вычитать = ВыборкаСтроки.Вычитать;
		КолСтрок = НастройкиИсточника.Количество();
		
		имяПараметрСтатья = "СтатьяОборотов" + Строка(номПараметра);
		имяПараметрСценарий = "Сценарий" + Строка(номПараметра);
		
		ПараметрыПостроителя.Вставить(имяПараметрСтатья,ВыборкаСтроки.СтатьяОборотовПоБюджетам);
		ПараметрыПостроителя.Вставить(имяПараметрСценарий,ВыборкаСтроки.Сценарий);
		
		Если ВыборкаСтроки.СтатьяОборотовПоБюджетам.ЭтоГруппа Тогда
			СтрокаОтбора =   "СтатьяОборотов В ИЕРАРХИИ (&" + имяПараметрСтатья + ") И Сценарий = &" + имяПараметрСценарий;
		Иначе
			СтрокаОтбора =   "СтатьяОборотов = &" + имяПараметрСтатья + " И Сценарий = &" + имяПараметрСценарий;
		КонецЕсли;

		Если КолСтрок = 1 Тогда
			
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	СУММА(ОборотыБюджетовОбороты.СуммаУпрОборот) КАК Сумма,
			|	ОборотыБюджетовОбороты.Период
			|ИЗ
			|	РегистрНакопления.ОборотыБюджетов.Обороты(&НачалоПериода, &КонецПериода, День, " + СтрокаОтбора + ") КАК ОборотыБюджетовОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	ОборотыБюджетовОбороты.Период"
			
		Иначе
			
			Собираем = (КолСтрок = номПараметра);
			
			тРезультат = тРезультат + " ВложенныйЗапрос"+Строка(номПараметра)+ ".Сумма"+Строка(номПараметра)+ ?(Собираем,"",?(Вычитать," - "," + "));
			
			тЗапроса = тЗапроса + 
			"(ВЫБРАТЬ
		    |ЕСТЬNULL(СУММА(ОборотыБюджетовОбороты.СуммаУпрОборот), 0) КАК Сумма" + Строка(номПараметра) + " 
			|ИЗ
		    |РегистрНакопления.ОборотыБюджетов.Обороты(&НачалоПериода,&КонецПериода,," +СтрокаОтбора+ ") КАК ОборотыБюджетовОбороты) КАК ВложенныйЗапрос" + Строка(номПараметра)+ ?(Собираем,"",",") + Символы.ПС ;
			
			Если Собираем Тогда //Собираем                                                                                                                               
				ТекстЗапроса = 
				"ВЫБРАТЬ
				|" + тРезультат + тКонецШапки + Символы.ПС +
				"&КонецПериода КАК Период
				|ИЗ" + Символы.ПС +
				""+ тЗапроса;
			КонецЕсли;	
			
		КонецЕсли;
		
		номПараметра = номПараметра + 1;
		
	КонецЦикла;
	
	НастройкиПостроителя.Вставить("ПараметрыПостроителя",ПараметрыПостроителя);
	
	обИсточник.НастройкиПостроителя = Новый ХранилищеЗначения(НастройкиПостроителя, Новый СжатиеДанных());
	обИсточник.ПроизвольныйЗапрос = Истина;
	
	обИсточник.ТекстЗапроса = ТекстЗапроса; 
	
	Показатели = обИсточник.Показатели;
	Показатели.Очистить();
	нСтрока=Показатели.Добавить();
	нСтрока.Имя="Сумма";
	нСтрока.Представление="Сумма";
	нСтрока.Использование=Истина;
	
	ДатыОтбораДанныхИсточника = обИсточник.ДатыОтбораДанныхИсточника;
	ДатыОтбораДанныхИсточника.Очистить();
	нСтрока = ДатыОтбораДанныхИсточника.Добавить();
	нСтрока.ИмяДатаГраницы = "НачалоПериода";
	нСтрока.ПредставлениеДатыГраницы = "Дата начала периода";
	нСтрока.НачальнаяГраницаОтсчета	= Перечисления.ВидыГраницОтбораИсточникаПланирования.НачалоПериода;
	
	нСтрока = ДатыОтбораДанныхИсточника.Добавить();
	нСтрока.ИмяДатаГраницы = "КонецПериода";
	нСтрока.ПредставлениеДатыГраницы = "Дата конца периода";
	нСтрока.НачальнаяГраницаОтсчета	= Перечисления.ВидыГраницОтбораИсточникаПланирования.КонецПериода;
	
	обИсточник.Записать();
	
	Сообщить ("Запрос записан.");

КонецПроцедуры	
