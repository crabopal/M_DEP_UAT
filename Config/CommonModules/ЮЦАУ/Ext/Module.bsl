Функция ПолучитьЗначениеПоИдентификатору(Идентификатор,Организация = Неопределено,ДатаСреза = '00010101000000') Экспорт
	
	Если Организация = Неопределено Тогда
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗначенияПоУмолчанию_ЮЦАУСрезПоследних.Период,
	|	ЗначенияПоУмолчанию_ЮЦАУСрезПоследних.Идентификатор,
	|	ЗначенияПоУмолчанию_ЮЦАУСрезПоследних.Значение,
	|	ЗначенияПоУмолчанию_ЮЦАУСрезПоследних.Организация
	|ИЗ
	|	РегистрСведений.ЗначенияПоУмолчанию_ЮЦАУ.СрезПоследних(
	|			&ДатаСреза,
	|			Идентификатор = &Идентификатор
	|				И Организация = &Организация) КАК ЗначенияПоУмолчанию_ЮЦАУСрезПоследних";
	
	Запрос.УстановитьПараметр("Идентификатор",Идентификатор);
	Запрос.УстановитьПараметр("ДатаСреза",ДатаСреза);
	
	Если Организация <> Справочники.Организации.ПустаяСсылка() Тогда
		Запрос.УстановитьПараметр("Организация",Организация);
	Иначе	
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"И Организация = &Организация","");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат(Результат.Значение);
	КонецЕсли;
	
КонецФункции	

Процедура ОбработатьТребованиеНакладная(Документ)
	
	ПроводкиДокумента = Документ.Движения.Хозрасчетный.Выгрузить();
	
	Записывать = Ложь;
	
	Для Каждого Стр Из ПроводкиДокумента Цикл
		
		Если Стр.СчетКт.ПринадлежитЭлементу(ПланыСчетов.Хозрасчетный.Материалы) Тогда
			
			Проводка = Документ.Движения.Хозрасчетный.Добавить();
			Проводка.Организация = Документ.Организация;
			Проводка.Содержание  = "Оприходованно ТМЦ (ДЭП)";
			Проводка.Период = Документ.Дата;
			
			Проводка.СчетДт = ПланыСчетов.Хозрасчетный.НайтиПоКоду("013");
			Проводка.СубконтоДт.Номенклатура = Стр.СубконтоКт2;
			Проводка.СубконтоДт.Склады = Стр.СубконтоКт3;
			Проводка.КоличествоДт = Стр.КоличествоКт;
			Проводка.Сумма = Стр.СУмма;
			
			
			Записывать = Истина;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если Записывать Тогда
		Попытка
			Документ.Движения.Хозрасчетный.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры	

Функция ВремяВходитВИнтервал(пДатаВыезда,пДатаВозвращения,пНачалоОбеда,пКонецОбеда)
	
	пВремяОбеда = 0;
	
	Если  КонецДня(пДатаВыезда) < КонецДня(пДатаВозвращения) Тогда //Несколько  дней
		
		Пока пДатаВыезда < пДатаВозвращения Цикл
			
			КонецДня = Мин(КонецДня(пДатаВыезда),пДатаВозвращения);
			
			Если пДатаВыезда < Дата(Год(пДатаВыезда),Месяц(пДатаВыезда),День(пДатаВыезда),Час(пНачалоОбеда),Минута(пНачалоОбеда),Секунда(пНачалоОбеда)) И 
				КонецДня > Дата(Год(КонецДня),Месяц(КонецДня),День(КонецДня),Час(пКонецОбеда),Минута(пКонецОбеда),Секунда(пКонецОбеда)) Тогда 
				пВремяОбеда = пВремяОбеда + (пКонецОбеда-пНачалоОбеда);
			КонецЕсли;
			
			пДатаВыезда = КонецДня + 1;
			
		КонецЦикла;
		
		Возврат(пВремяОбеда);
		
	Иначе
		
		КонецДня = Мин(КонецДня(пДатаВыезда),пДатаВозвращения);
		
		Если пДатаВыезда < Дата(Год(пДатаВыезда),Месяц(пДатаВыезда),День(пДатаВыезда),Час(пНачалоОбеда),Минута(пНачалоОбеда),Секунда(пНачалоОбеда)) И 
			КонецДня > Дата(Год(КонецДня),Месяц(КонецДня),День(КонецДня),Час(пКонецОбеда),Минута(пКонецОбеда),Секунда(пКонецОбеда)) Тогда 
			пВремяОбеда = пВремяОбеда + (пКонецОбеда-пНачалоОбеда);
		КонецЕсли;
		
		Возврат(пВремяОбеда);
		
	КонецЕсли;	
	
	Возврат(0);
	
КонецФункции	

// Функция рассчитывает ночное время однодневного ПЛ
// Возвращает значение в секундах
Функция ВремяНочьОдинДень(ДокументСсылка,ДатаВыезда,ДатаВозвращения) Экспорт
	сВремяНочь = 0;
	Если ДатаВыезда - НачалоДня(ДатаВыезда) <= 21600 Тогда
		сВремяНочь = ?(ДатаВозвращения - НачалоДня(ДатаВозвращения) > 21600,
		уатОбщегоНазначения.уатВремяВСекунды(6) - (ДатаВыезда - НачалоДня(ДатаВыезда)),
		ДатаВозвращения - ДатаВыезда);
	КонецЕсли;	
	Если Час(ДатаВозвращения) >= 22 Тогда
		сВремяНочь = сВремяНочь + ?(Час(ДатаВыезда) < 22,
		(ДатаВозвращения - НачалоДня(ДатаВозвращения))- уатОбщегоНазначения.уатВремяВСекунды(22),
		ДатаВозвращения - ДатаВыезда) + ?(ДатаВозвращения = КонецДня(ДатаВыезда),1,0);
	КонецЕсли; 
	
	Возврат сВремяНочь;
КонецФункции	

// Функция рассчитывает ночное время первого дня многодневного ПЛ
// Возвращает значение в секундах
Функция ВремяНочьПервыйДень(ДокументСсылка,ДатаВыезда,ДатаВозвращения) Экспорт
	Если Час(ДатаВыезда) <= 6 Тогда
		// Время выезда раньше 6.00 -> Рассчитывается время работы до 6.00 + время работы с 22.00 до 24.00 = 2 часа
		сВремяНочь = уатОбщегоНазначения.уатВремяВСекунды(6) - (ДатаВыезда
		- НачалоДня(ДатаВыезда)) + уатОбщегоНазначения.уатВремяВСекунды(2);
	ИначеЕсли Час(ДатаВыезда) >= 22 Тогда
		// Время выезда позже 22.00 -> Рассчитывается время работы
		сВремяНочь = уатОбщегоНазначения.уатВремяВСекунды(24) - (ДатаВыезда - НачалоДня(ДатаВыезда));
	Иначе
		// Время выезда позже 6.00, но раньше 22.00 -> Рассчитывается время работы с 22.00 до 24.00 = 2 часа
		сВремяНочь = уатОбщегоНазначения.уатВремяВСекунды(2);
	КонецЕсли;
	
	Возврат сВремяНочь;
КонецФункции

// Функция рассчитывает ночное время последнего дня многодневного ПЛ
// Возвращает значение в секундах
Функция ВремяНочьПоследнийДень(ДокументСсылка,ДатаВыезда,ДатаВозвращения) Экспорт
	Если Час(ДатаВозвращения) >= 22 Тогда
		// Время возвращения позже 22.00 ->
		//Рассчитывается время работы с 22.00 до возвращения + время работы с 0.00 до 6.00 = 6 часам
		сВремяНочь = уатОбщегоНазначения.уатВремяВСекунды(6) + (ДатаВозвращения
		- НачалоДня(ДатаВозвращения)) - уатОбщегоНазначения.уатВремяВСекунды(22);
	ИначеЕсли ДатаВозвращения - НачалоДня(ДатаВозвращения) <= 21600 Тогда
		// Время возвращения раньше 6.00 -> Рассчитывается время работы
		сВремяНочь = ДатаВозвращения - НачалоДня(ДатаВозвращения);
	Иначе	
		// Время возвращения позже 6.00, но раньше 22.00 -> Рассчитывается время работы с 0.00 до 6.00 = 6 часам
		сВремяНочь = уатОбщегоНазначения.уатВремяВСекунды(6);
	КонецЕсли;
	
	Возврат сВремяНочь;
КонецФункции	

Процедура уатПутевойЛист(Источник)
	
	нзВыработка = РегистрыНакопления.уатВыработкаСотрудников.СоздатьНаборЗаписей();
	нзВыработка.Отбор.Регистратор.Установить(Источник.Ссылка);
	нзВыработка.Прочитать();
	
	нзПростои = РегистрыНакопления.уатПростои.СоздатьНаборЗаписей();
	нзПростои.Отбор.Регистратор.Установить(Источник.Ссылка);
	нзПростои.Прочитать();
	тзПростои = нзПростои.Выгрузить();
	
	нзРВС = РегистрыНакопления.уатРабочееВремяСотрудников.СоздатьНаборЗаписей();
	нзРВС.Отбор.Регистратор.Установить(Источник.Ссылка);
	нзРВС.Прочитать();
	тзРВС = нзРВС.Выгрузить();
	нзРВС.Очистить();
	
	Записывать = Ложь;
	
	Для а = (тзРВС.Количество()-1)* (-1) По 0 Цикл
		СтрРВС = тзРВС[а*(-1)];
		Если СтрРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа  или 
			СтрРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Ночные  или
			СтрРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.ПростойПочасовой Тогда
			
			тзРВС.Удалить(СтрРВС);
		КонецЕсли;
	КонецЦикла;
	
	
	ПростойВНочноеВремя = 0;
	
	Для Каждого СтрПростои Из тзПростои Цикл
		
		нСтр = тзРВС.Добавить();
		ЗаполнитьЗначенияСвойств(нСтр,СтрПростои);
		
		стрТЧПростои = Источник.Простои [СтрПростои.НомерСтроки - 1];
		
		Если стрТЧПростои.ВключенДвигатель Тогда
			нСтр.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа;
		Иначе
			нСтр.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.ПростойПочасовой;
			ПростойВНочноеВремя = ПростойВНочноеВремя + ВремяНочьОдинДень(Источник.Ссылка,стрТЧПростои.НачалоПростоя,?(Час(стрТЧПростои.КонецПростоя)= 0,КонецДня(стрТЧПростои.КонецПростоя),стрТЧПростои.КонецПростоя));
		КонецЕсли;
		
		нСтр.Сотрудник = СтрПростои.Водитель;
		нСтр.Организация = Источник.Организация;
		
		ВремяПростоя = СтрПростои.Время;
		
		Если НЕ Источник.РежимРаботыТС.Пустая() Тогда
			Если Источник.РежимРаботыТС.Обед <> Дата(0001,01,01) Тогда
				КонПростоя = СтрПростои.Период+ВремяПростоя;
				Если КонПростоя = НачалоДня(СтрПростои.период +(60*60*24)) Тогда
					КонПростоя = КонПростоя - 1;
				КонецЕсли;	
				ВремяПростоя = ВремяПростоя - (ВремяВходитВИнтервал(СтрПростои.период,КонПростоя ,Источник.РежимРаботыТС.НачалоОбеда,Источник.РежимРаботыТС.КонецОбеда));
			КонецЕсли;
		КонецЕсли;
		
		нСтр.Время = ВремяПростоя;
		
		нСтр.ДатаРаботы = Источник.ДатаВыезда;
		нСтр.Период   = Источник.ДатаВыезда;
		нСтр.Дней = 1;
		
		Записывать = Истина;
		
	КонецЦикла;	
	
	Для Каждого СтрВВР Из нзВыработка Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	уатПутевойЛист.ДатаВыезда,
		|	уатПутевойЛист.ДатаВозвращения
		|ИЗ
		|	Документ.уатПутевойЛист КАК уатПутевойЛист
		|ГДЕ
		|	уатПутевойЛист.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		ВыборкаДетальныеЗаписи.Следующий();
		
		ДатаВыезда = ВыборкаДетальныеЗаписи.ДатаВыезда;
		ДатаВозвращения = ВыборкаДетальныеЗаписи.ДатаВозвращения;
		
		Если СтрВВР.ПараметрВыработки = Справочники.уатПараметрыВыработки.ВремяВРаботе  Тогда 
			нСтр = тзРВС.Добавить();
			ЗаполнитьЗначенияСвойств(нСтр,СтрВВР);
			Если Источник.ВидПЛ = Перечисления.уатВидыПЛ._4М Тогда
				нСтр.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.КомандировкаПочасовая;
			Иначе	
				нСтр.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа;
			КонецЕсли;
			нСтр.Время = СтрВВР.Количество;
			нСтр.ДатаРаботы = Источник.ДатаВыезда;
			нСтр.Дней = 1;
			
			Записывать = Истина;
			Продолжить;
		КонецЕсли;	
		
		Если СтрВВР.ПараметрВыработки = Справочники.уатПараметрыВыработки.ВремяНочное Тогда
			
			Если НЕ Источник.РежимРаботыТС.Пустая() Тогда
				Если Источник.РежимРаботыТС.Обед <> Дата(0001,01,01) Тогда
					НочноеВремя = СтрВВР.Количество - ВремяВходитВИнтервал(ДатаВыезда,ДатаВозвращения,Источник.РежимРаботыТС.НачалоОбеда,Источник.РежимРаботыТС.КонецОбеда);
				Иначе
					НочноеВремя = СтрВВР.Количество;
				КонецЕсли;
			Иначе
				НочноеВремя = СтрВВР.Количество;
			КонецЕсли;
			
			Если НочноеВремя = ПростойВНочноеВремя Тогда
				НочноеВремя = 0;
				ПростойВНочноеВремя = 0;
			ИначеЕсли НочноеВремя < ПростойВНочноеВремя Тогда
				НочноеВремя = 0; 
				ПростойВНочноеВремя = ПростойВНочноеВремя - НочноеВремя; 
			ИначеЕсли НочноеВремя > ПростойВНочноеВремя Тогда
				НочноеВремя = НочноеВремя - ПростойВНочноеВремя;
				ПростойВНочноеВремя = 0;
			КонецЕсли;	
			
			Если НочноеВремя > 0 Тогда
				
				нСтр = тзРВС.Добавить();
				ЗаполнитьЗначенияСвойств(нСтр,СтрВВР);
				нСтр.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Ночные;
				нСтр.Время = НочноеВремя;
				нСтр.ДатаРаботы = Источник.ДатаВыезда;
				нСтр.Период   = Источник.ДатаВыезда;
				нСтр.Дней = 1;
				
				Записывать = Истина;
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;	
		
		//Спец.работы 
		Если СтрВВР.ПараметрВыработки = Справочники.уатПараметрыВыработки.ВремяСпециальнойРаботы  Тогда 
			нСтр = тзРВС.Добавить();
			ЗаполнитьЗначенияСвойств(нСтр,СтрВВР);
			нСтр.ВидИспользованияРабочегоВремени = ПолучитьЗначениеПоИдентификатору ("ВремяСпециальнойРаботы",Источник.Организация,Источник.ДатаВыезда);
			нСтр.Время = СтрВВР.Количество;
			нСтр.ДатаРаботы = Источник.ДатаВыезда;
			нСтр.Дней = 1;
			Записывать = Истина;
			Продолжить;
		КонецЕсли;	
		
	КонецЦикла;	
	
	
	Если Записывать Тогда
		нзРВС.Загрузить(тзРВС);
		нзРВС.Записать();
	КонецЕсли;	
	
	нзВода = РегистрыНакопления.ЮЦАУ_РасходВодыПоВидамРабот.СоздатьНаборЗаписей();
	нзВода.Отбор.Регистратор.Установить(Источник.Ссылка);
	нзВода.Прочитать();
	нзВода.Очистить();
	
	Для Каждого СтрЗадание Из Источник.Задание Цикл
		
		нСтр = нзВода.Добавить();
		
		нСтр.Организация = Источник.Организация;
		нСтр.Период = Источник.Дата;
		нСтр.Участок = СтрЗадание.Подразделение;
		нСтр.КАУ = СтрЗадание.КАУ;
		нСтр.КАУ = СтрЗадание.ОбъемВоды;
		
	КонецЦикла;
	
	нзВода.Записать();
	//Автобусные перевозки
	Если Источник.ВидПЛ = Перечисления.уатВидыПЛ._6 Тогда
		нзРВС.Очистить();
		тзРВС.Очистить();
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	уатПутевойЛистЗадание.КоличествоЧасов,
		|	уатПутевойЛистЗадание.Смена,
		|	уатПутевойЛистЗадание.Маршрут
		|ИЗ
		|	Документ.уатПутевойЛист.Задание КАК уатПутевойЛистЗадание
