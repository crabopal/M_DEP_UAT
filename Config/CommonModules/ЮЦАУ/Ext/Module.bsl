Функция ОкруглитьЧерезСтроку (СуммаДляОкругления) Экспорт
	
	Запятая = Найти(Строка(СуммаДляОкругления),",");
	ЦелыеЧисла = Лев(Строка(СуммаДляОкругления),Запятая);
	Дробь = Прав(Строка(СуммаДляОкругления),СтрДлина(Строка(СуммаДляОкругления))-Запятая);
	
	Если СтрДлина(Дробь) >= 2 Тогда
		Дробь = Лев(Дробь,2);
	Иначе	   
		Дробь = Лев(Дробь + "00000000",2);
	КонецЕсли;	   
	
	фСумма = Число(ЦелыеЧисла+Дробь);
	
	Возврат(фСумма);
	
КонецФункции	

Функция ПолучитьДолжностьФизЛица(ФизическоеЛицо) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо,
	|	ТекущиеКадровыеДанныеСотрудников.Сотрудник,
	|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущееПодразделение,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность,
	|	МАКСИМУМ(ТекущиеКадровыеДанныеСотрудников.ДатаПриема) КАК ДатаПриема,
	|	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения,
	|	ТекущиеКадровыеДанныеСотрудников.ОсновноеРабочееМестоВОрганизации
	//|	ТекущиеКадровыеДанныеСотрудников.ТекущийВидЗанятости,
	//|	ТекущиеКадровыеДанныеСотрудников.УдалитьТекущаяОрганизация
	|ИЗ
	|	РегистрСведений.УдалитьТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|ГДЕ
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо = &ФизическоеЛицо
	|
	|СГРУППИРОВАТЬ ПО
	|	ТекущиеКадровыеДанныеСотрудников.ФизическоеЛицо,
	|	ТекущиеКадровыеДанныеСотрудников.Сотрудник,
	|	ТекущиеКадровыеДанныеСотрудников.ГоловнаяОрганизация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущееПодразделение,
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность,
	|	ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения,
	|	ТекущиеКадровыеДанныеСотрудников.ОсновноеРабочееМестоВОрганизации
	//|	ТекущиеКадровыеДанныеСотрудников.ТекущийВидЗанятости,
	//|	ТекущиеКадровыеДанныеСотрудников.УдалитьТекущаяОрганизация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПриема УБЫВ";
	
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат Строка(ВыборкаДетальныеЗаписи.ТекущаяДолжность);
	Иначе
		Возврат Строка("");
	КонецЕсли;
	
КонецФункции	

Процедура ОткрытьФормуДопСведенийДоговора(Договор) Экспорт
	
	Форма = Договор.ПолучитьФорму("Справочник.ДоговорыКонтрагентов.Форма.ФормаДополнительнойИнформации");
	
	Форма.Договор = Договор;
	НаборЗаписей = РегистрыСведений.ЮЦАУ_ДоговорыКонтрагентовДопИнформация.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ДоговорКонтрагента.Установить(Договор);
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество() = 1 Тогда
		
		Запись = НаборЗаписей[0];
		Форма.ЭлементыФормы.ПредметДоговора.Значение       = Запись.ПредметДоговора;
		Форма.ЭлементыФормы.ЦенаДоговора.Значение          = Запись.ЦенаДоговора;
		Форма.ЭлементыФормы.ПорядокРасчётов.Значение       = Запись.ПорядокРасчётов;
		Форма.ЭлементыФормы.ОтветственностьСторон.Значение = Запись.ОтветственностьСторон;
		Форма.ЭлементыФормы.СрокДействия.Значение          = Запись.СрокДействия;
		Форма.ЭлементыФормы.СсылкаНаСкан.Значение          = Запись.СсылкаНаСкан;
		
		Форма.ЭлементыФормы.ДатаРегистрации.Значение       = Запись.ДатаРегистрации;
		Форма.ЭлементыФормы.СрокИсполненияОрг.Значение     = Запись.СрокИсполненияОбязательствОрганизацией;
		Форма.ЭлементыФормы.СрокИсполненияКонтр.Значение   = Запись.СрокИсполненияОбязательствКонтрагентом;
		Форма.ЭлементыФормы.ОтметкиОбИсполнении.Значение   = Запись.ОтметкиОбИсполненииОбязательств;
		Форма.ЭлементыФормы.ПринятыеМеры.Значение          = Запись.ПринятыеМеры;
		
	КонецЕсли;
	
	Форма.Открыть();
	
КонецПроцедуры

Функция ОпределитьДеньНедели(НомерДняНедели) Экспорт
	
	Если НомерДняНедели = 1 Тогда
		Возврат "Понедельник";
	ИначеЕсли НомерДняНедели = 2 Тогда
		Возврат "Вторник";
	ИначеЕсли НомерДняНедели = 3 Тогда
		Возврат "Среда";
	ИначеЕсли НомерДняНедели = 4 Тогда
		Возврат "Четверг";
	ИначеЕсли НомерДняНедели = 5 Тогда
		Возврат "Пятница";
	ИначеЕсли НомерДняНедели = 6 Тогда
		Возврат "Суббота";
	Иначе
		Возврат "Воскресенье";
	КонецЕсли;
	
КонецФункции

