//КАА
//Заполняет значениями строку из таблицы рабочего времени сотрудника
Процедура ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС,Источник,Сотрудник,ВидИспользованияРабочегоВремени,Время)

	СтрокаРВС.Регистратор = Источник.Ссылка;
	СтрокаРВС.Организация = Источник.Организация;
	СтрокаРВС.Сотрудник = Сотрудник;
	СтрокаРВС.ВидИспользованияРабочегоВремени = ВидИспользованияРабочегоВремени;
	СтрокаРВС.Время = Время;
	СтрокаРВС.ДатаРаботы = Источник.ДатаВыезда;
	СтрокаРВС.Период = Источник.Дата;
	СтрокаРВС.Дней = 1;
	СтрокаРВС.Активность = Истина;

КонецПроцедуры	


Процедура ОтразитьВыработкуСотрудниковПоМаршрутам(Источник)
	
	// Отбирается Водитель1 и Пустой водитель из тч "Задание"
	// Отбирается Водитель2 и Пустой водитель из тч "Задание"
	// Результаты запросов соединяются	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	уатПутевойЛистЗадание.Ссылка КАК Ссылка,
		|	уатПутевойЛистЗадание.Ссылка.Дата КАК Период,
		|	уатПутевойЛистЗадание.Ссылка.Организация КАК Организация,
		|	уатПутевойЛистЗадание.Ссылка.ТранспортноеСредство КАК ТранспортноеСредство,
		|	уатПутевойЛистЗадание.Маршрут КАК Маршрут,  
		|	уатПутевойЛистЗадание.КАУ КАК НоменклатурнаяГруппа,
		|	уатПутевойЛистЗадание.Ссылка.Водитель1 КАК Сотрудник,
		|	ЦЕЛ(уатПутевойЛистЗадание.КоличествоЧасов) * 3600 + (уатПутевойЛистЗадание.КоличествоЧасов - ЦЕЛ(уатПутевойЛистЗадание.КоличествоЧасов)) * 100 * 60 КАК РабочееВремя,
		|	уатПутевойЛистЗадание.КоличествоЕздок КАК КоличествоЕздок,
		|	уатПутевойЛистЗадание.КоличествоПассажиров КАК КоличествоПассажиров,
		|	уатПутевойЛистЗадание.КоличествоКмГруз КАК ПробегСПассажирами,
		|	уатПутевойЛистЗадание.Выручка КАК Выручка
		|ИЗ
		|	Документ.уатПутевойЛист.Задание КАК уатПутевойЛистЗадание
		|ГДЕ
		|	уатПутевойЛистЗадание.Ссылка = &Ссылка
		|	И (уатПутевойЛистЗадание.Водитель = уатПутевойЛистЗадание.Ссылка.Водитель1
		|			ИЛИ уатПутевойЛистЗадание.Водитель = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	уатПутевойЛистЗадание.Ссылка,
		|	уатПутевойЛистЗадание.Ссылка.Дата,
		|	уатПутевойЛистЗадание.Ссылка.Организация,
		|	уатПутевойЛистЗадание.Ссылка.ТранспортноеСредство,
		|	уатПутевойЛистЗадание.Маршрут,
		|	уатПутевойЛистЗадание.КАУ,
		|	уатПутевойЛистЗадание.Ссылка.Водитель2,
		|	ЦЕЛ(уатПутевойЛистЗадание.КоличествоЧасов) * 3600 + (уатПутевойЛистЗадание.КоличествоЧасов - ЦЕЛ(уатПутевойЛистЗадание.КоличествоЧасов)) * 100 * 60,
		|	уатПутевойЛистЗадание.КоличествоЕздок,
		|	уатПутевойЛистЗадание.КоличествоПассажиров,
		|	уатПутевойЛистЗадание.КоличествоКмГруз,
		|	уатПутевойЛистЗадание.Выручка
		|ИЗ
		|	Документ.уатПутевойЛист.Задание КАК уатПутевойЛистЗадание
		|ГДЕ
		|	уатПутевойЛистЗадание.Ссылка = &Ссылка  
		|	И уатПутевойЛистЗадание.Ссылка.Водитель2 <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
		|	И (уатПутевойЛистЗадание.Водитель = уатПутевойЛистЗадание.Ссылка.Водитель2
		|			ИЛИ уатПутевойЛистЗадание.Водитель = ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))";	
		
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	ТаблицаМаршруты = Запрос.Выполнить().Выгрузить();

	ДвиженияЮЦАУ_РабочееВремяПоМаршрутам = Источник.Движения.ЮЦАУ_ОборотыПоМаршрутам;
	ДвиженияЮЦАУ_РабочееВремяПоМаршрутам.Записывать = Истина;
	ДвиженияЮЦАУ_РабочееВремяПоМаршрутам.Загрузить(ТаблицаМаршруты);

КонецПроцедуры	

