			СтрокаРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.ПростойПочасовой Тогда
			
			тзРВС.Удалить(СтрокаРВС);   
			
		КонецЕсли;
	КонецЦикла;

	
	//Обработка простоя
	
	ПростойВНочноеВремя = 0;
	
