	Запрос.Текст = 
		"ВЫБРАТЬ
		|	уатПутевойЛистПростои.Ссылка КАК Ссылка,
		|	уатПутевойЛистПростои.ВидПростоя КАК ВидПростоя,
		|	уатПутевойЛистПростои.ВключенДвигатель КАК ВключенДвигатель,
		|	уатПутевойЛистПростои.НачалоПростоя КАК НачалоПростоя,
		|	уатПутевойЛистПростои.КонецПростоя КАК КонецПростоя,
		|	уатПутевойЛистПростои.ВремяПростоя КАК ВремяПростоя
		|ИЗ
		|	Документ.уатПутевойЛист.Простои КАК уатПутевойЛистПростои
		|ГДЕ
		|	уатПутевойЛистПростои.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ВыборкаДетальныеЗаписи.ВключенДвигатель Тогда
			ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа;
		Иначе
			ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.ПростойПочасовой;
			ПростойВНочноеВремя = ПростойВНочноеВремя + ВремяНочьОдинДень(Источник.Ссылка,ВыборкаДетальныеЗаписи.НачалоПростоя,?(Час(ВыборкаДетальныеЗаписи.КонецПростоя)= 0,КонецДня(ВыборкаДетальныеЗаписи.КонецПростоя),ВыборкаДетальныеЗаписи.КонецПростоя));
		КонецЕсли;
		
		ВремяПростоя = ВыборкаДетальныеЗаписи.ВремяПростоя - НачалоДня(ВыборкаДетальныеЗаписи.ВремяПростоя);

		Если ЗначениеЗаполнено(Источник.РежимРаботыТС) Тогда
			Если Источник.РежимРаботыТС.Обед <> Дата(0001,01,01) Тогда
				КонецПростоя = ВыборкаДетальныеЗаписи.НачалоПростоя + ВремяПростоя;
				Если КонецПростоя = НачалоДня(ВыборкаДетальныеЗаписи.НачалоПростоя + 60*60*24) Тогда
					КонецПростоя = КонецПростоя - 1;
				КонецЕсли;	
				ВремяПростоя = ВремяПростоя - (ВремяВходитВИнтервал(ВыборкаДетальныеЗаписи.НачалоПростоя, КонецПростоя, Источник.РежимРаботыТС.НачалоОбеда, Источник.РежимРаботыТС.КонецОбеда));
			КонецЕсли;
		КонецЕсли;
		
		СтрокаРВС = тзРВС.Добавить();                                                                                                                           
		ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, Источник.Водитель1, ВидИспользованияРабочегоВремени, ВремяПростоя);

		Записывать = Истина;
		
	КонецЦикла;

	//Рабочее время
	Если Источник.ВидПЛ <> Перечисления.уатВидыПЛ._6 Тогда //Все п/л кроме автобусов
		
		Для Каждого СтрокаВВР Из нзВыработка Цикл
			
			Если СтрокаВВР.ПараметрВыработки = Справочники.уатПараметрыВыработки.ВремяВРаботе  Тогда 
				
				Если Источник.ВидПЛ = Перечисления.уатВидыПЛ._4М Тогда
					ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.КомандировкаПочасовая;
				Иначе	
					ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа;
				КонецЕсли;

				СтрокаРВС = тзРВС.Добавить();                                                                                                                           
				ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, СтрокаВВР.Сотрудник, ВидИспользованияРабочегоВремени, СтрокаВВР.Количество);
				
				Записывать = Истина;
				
			КонецЕсли;	
			
			Если СтрокаВВР.ПараметрВыработки = Справочники.уатПараметрыВыработки.ВремяНочное Тогда
				
				Если ЗначениеЗаполнено(Источник.РежимРаботыТС) Тогда
					Если Источник.РежимРаботыТС.Обед <> Дата(0001,01,01) Тогда
						НочноеВремя = СтрокаВВР.Количество - ВремяВходитВИнтервал(Источник.ДатаВыезда,Источник.ДатаВозвращения,Источник.РежимРаботыТС.НачалоОбеда,Источник.РежимРаботыТС.КонецОбеда);
					Иначе
						НочноеВремя = СтрокаВВР.Количество;
					КонецЕсли;
				Иначе
					НочноеВремя = СтрокаВВР.Количество;
				КонецЕсли;
				
				Если НочноеВремя = ПростойВНочноеВремя Тогда
					НочноеВремя = 0;
					ПростойВНочноеВремя = 0;
				ИначеЕсли НочноеВремя < ПростойВНочноеВремя Тогда
					НочноеВремя = 0; 
					ПростойВНочноеВремя = ПростойВНочноеВремя - НочноеВремя; 
				ИначеЕсли НочноеВремя > ПростойВНочноеВремя Тогда
					НочноеВремя = НочноеВремя - ПростойВНочноеВремя;
					ПростойВНочноеВремя = 0;
				КонецЕсли;	
				
				Если НочноеВремя > 0 Тогда
					
					СтрокаРВС = тзРВС.Добавить();                                                                                                                           
					ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Ночные;
					ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, СтрокаВВР.Сотрудник, ВидИспользованияРабочегоВремени, НочноеВремя);
					Записывать = Истина; 
					
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;	
			
			//Спец.работы 
			Если СтрокаВВР.ПараметрВыработки = Справочники.уатПараметрыВыработки.ВремяСпециальнойРаботы  Тогда 
				
				СтрокаРВС = тзРВС.Добавить();                                                                                                                           
				ВидИспользованияРабочегоВремени = ПолучитьЗначениеПоИдентификатору("ВремяСпециальнойРаботы",Источник.Организация,Источник.ДатаВыезда);
				ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, СтрокаВВР.Сотрудник, ВидИспользованияРабочегоВремени, СтрокаВВР.Количество);
				Записывать = Истина; 
				
			КонецЕсли;	
			
		КонецЦикла;	
		
	ИначеЕсли Источник.ВидПЛ = Перечисления.уатВидыПЛ._6 Тогда //Автобусные перевозки

		Записывать = Истина; 
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
	//	|	уатПутевойЛистЗадание.КоличествоЧасов,
		|	уатПутевойЛистЗадание.Смена,
		|	уатПутевойЛистЗадание.Маршрут,    
		|	ЦЕЛ(уатПутевойЛистЗадание.КоличествоЧасов) * 3600 + (уатПутевойЛистЗадание.КоличествоЧасов - ЦЕЛ(уатПутевойЛистЗадание.КоличествоЧасов)) * 100 * 60 КАК РабочееВремя
		|ИЗ
		|	Документ.уатПутевойЛист.Задание КАК уатПутевойЛистЗадание
		|ГДЕ
		|	уатПутевойЛистЗадание.Ссылка = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Источник.Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НочныеЧасы = ПолучитьНочныеЧасы(Источник, ВыборкаДетальныеЗаписи.Смена);
			//Если ВыборкаДетальныеЗаписи.Маршрут = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("Дежурный", Источник.Организация, Источник.Дата) Тогда
			//	НочныеЧасы = НочныеЧасы - 3600;
			//КонецЕсли;
			Если ЗначениеЗаполнено(Источник.Водитель1) Тогда
					
				//Ночные часы
				Если НочныеЧасы > 0 Тогда
					СтрокаРВС = тзРВС.Добавить();                                                                                                                           
					Время = НочныеЧасы - ПростойВНочноеВремя;
					ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, Источник.Водитель1, Справочники.уатВидыИспользованияРабочегоВремени.Ночные, Время);
				КонецЕсли;
				
				//Рабочее время
				СтрокаРВС = тзРВС.Добавить();      
				//Время = 60*(Цел(ВыборкаДетальныеЗаписи.КоличествоЧасов)*60 + (ВыборкаДетальныеЗаписи.КоличествоЧасов- Цел(ВыборкаДетальныеЗаписи.КоличествоЧасов))*100);// - ВремяПростоя1;// - НочныеЧасы;
				ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, Источник.Водитель1, Справочники.уатВидыИспользованияРабочегоВремени.Работа, ВыборкаДетальныеЗаписи.РабочееВремя);
				
			КонецЕсли;
				
			Если ЗначениеЗаполнено(Источник.Водитель2) Тогда
				
				//Ночные часы
				Если НочныеЧасы > 0 Тогда

					СтрокаРВС = тзРВС.Добавить();                                                                                                                           
					Время = НочныеЧасы - ПростойВНочноеВремя;
					ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, Источник.Водитель2, Справочники.уатВидыИспользованияРабочегоВремени.Ночные, Время);

				КонецЕсли;

				//Рабочее время
				СтрокаРВС = тзРВС.Добавить();      
				//Время = 60*(Цел(ВыборкаДетальныеЗаписи.КоличествоЧасов)*60 + (ВыборкаДетальныеЗаписи.КоличествоЧасов- Цел(ВыборкаДетальныеЗаписи.КоличествоЧасов))*100);// - ВремяПростоя1;// - НочныеЧасы;
				ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, Источник.Водитель2, Справочники.уатВидыИспользованияРабочегоВремени.Работа, ВыборкаДетальныеЗаписи.РабочееВремя);

			КонецЕсли;
				
		КонецЦикла;
		
		//ОтразитьВыработкуСотрудниковПоМаршрутам(Источник);
		
	КонецЕсли; //Автобусные перевозки 
	
	
	//Подготовительно - заключительные работы      
	ДобавлятьПЗР = Истина;
	ВидИспользованияРабочегоВремени = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПЗР", Источник.Организация, Источник.Дата);
	Если Источник.ВидПЛ = Перечисления.уатВидыПЛ._6 Тогда	//Автобусные перевозки 
		ВремяПЗР = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПЗРВремяАвтобусы", Источник.Организация, Источник.Дата);	
	Иначе
		
		ВремяПЗР = ЮЦАУ.ПолучитьЗначениеПоИдентификатору("ПЗРВремя", Источник.Организация, Источник.Дата);	
		Если Источник.Дата >= '20231001' Тогда //С 01.10.2023 ПЗР добавляется только для водителей автобусов. Остальным - нет
			ДобавлятьПЗР = Ложь;
		КонецЕсли;	
		
	КонецЕсли;	
	
	Если ДобавлятьПЗР Тогда
	
		Если ЗначениеЗаполнено(Источник.Водитель1) Тогда 
			
			СтрокаРВС = тзРВС.Добавить();      
			ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, Источник.Водитель1, ВидИспользованияРабочегоВремени, ВремяПЗР);
			
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Источник.Водитель2) Тогда 
			
			СтрокаРВС = тзРВС.Добавить();      
			ЗаполнитьСтрокуРабочегоВремениСотрудника(СтрокаРВС, Источник, Источник.Водитель2, ВидИспользованияРабочегоВремени, ВремяПЗР);
			
		КонецЕсли;
		
	КонецЕсли;
		
	Если Записывать Тогда
		тзРВС.Свернуть("Сотрудник, Организация, ВидИспользованияРабочегоВремени, ДатаРаботы, Регистратор, Дней, Период", "Время");
		нзРВС.Загрузить(тзРВС);
		нзРВС.Записать();
	КонецЕсли;	
	
	//Учет воды
	нзВода = РегистрыНакопления.ЮЦАУ_РасходВодыПоВидамРабот.СоздатьНаборЗаписей();
	нзВода.Отбор.Регистратор.Установить(Источник.Ссылка);
	нзВода.Прочитать();
	нзВода.Очистить();
	
	Для Каждого СтрЗадание Из Источник.Задание Цикл
		
		Если СтрЗадание.ОбъемВоды > 0 Тогда
			нСтр = нзВода.Добавить();
			
			нСтр.Организация = Источник.Организация;
			нСтр.Период = Источник.Дата;
			нСтр.Участок = СтрЗадание.Подразделение;
			нСтр.КАУ = СтрЗадание.КАУ;
			нСтр.КАУ = СтрЗадание.ОбъемВоды;
		КонецЕсли;
		
	КонецЦикла;
	
	нзВода.Записать();   

	ОтразитьВыработкуСотрудниковПоМаршрутам(Источник);	
	
КонецПроцедуры	
