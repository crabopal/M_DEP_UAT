Функция ПолучитьДолжностьСотрудникаУАТ(Сотрудник,Организация,КонПериода) 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяДолжность КАК Должность
	|ИЗ
	|	РегистрСведений.УдалитьТекущиеКадровыеДанныеСотрудников КАК ТекущиеКадровыеДанныеСотрудников
	|ГДЕ
	|	ТекущиеКадровыеДанныеСотрудников.ТекущаяОрганизация = &Организация
	|	И ТекущиеКадровыеДанныеСотрудников.ДатаПриема <= &КонПериода
	|	И (ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения >= &КонПериода
	|			ИЛИ ТекущиеКадровыеДанныеСотрудников.ДатаУвольнения = ДАТАВРЕМЯ(1, 1, 1))
	|	И ТекущиеКадровыеДанныеСотрудников.Сотрудник = &Сотрудник";	
	
	Запрос.УстановитьПараметр("КонПериода", КонПериода);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Если  РезультатЗапроса.Следующий() Тогда
		Возврат(РезультатЗапроса.Должность);
	Иначе	
		Возврат(Неопределено);
	КонецЕсли;
	
КонецФункции

Функция ПроверитьВидОбслуживанияТСсОсобымПорядкомУчета(ВидОбслуживанияТС) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыОбслуживанияТСсОсобымПорядкомУчета.ВидОбслуживания
	|ИЗ
	|	РегистрСведений.ВидыОбслуживанияТСсОсобымПорядкомУчета КАК ВидыОбслуживанияТСсОсобымПорядкомУчета
	|ГДЕ
	|	ВидыОбслуживанияТСсОсобымПорядкомУчета.ВидОбслуживания = &ВидОбслуживанияТС";
	
	Запрос.УстановитьПараметр("ВидОбслуживанияТС",ВидОбслуживанияТС);
	Результат = Запрос.Выполнить().Выбрать();
	
	Если Результат.Следующий() Тогда
		Возврат(Истина);
	Иначе
		Возврат(Ложь);
	КонецЕсли;
	
КонецФункции	

Процедура уатРемонтныйЛист(Источник)
	
	ДокументСсылка = Источник.Ссылка; 
	
	ДатаНачала = Источник.ДатаНачала;
	ДатаОкончания = Источник.ДатаОкончания;
	
	нзРВС = РегистрыНакопления.уатРабочееВремяСотрудников.СоздатьНаборЗаписей();
	нзРВС.Отбор.Регистратор.Установить(ДокументСсылка);
	нзРВС.Прочитать();
	тзРВС = нзРВС.Выгрузить();
	тзРВССвернуть = нзРВС.Выгрузить();
	
	тзРВССвернуть.Свернуть("Сотрудник","Время");
	
	Записывать = Ложь;
	
	Слесарь = ПолучитьЗначениеПоИдентификатору("Слесарь",Источник.Организация,Источник.Дата);
	
	мПродолжительностьОбеда = уатПраваИНастройки.уатПолучитьПраваИНастройкиПользователя(ДокументСсылка.Организация, ПланыВидовХарактеристик.уатПраваИНастройки.ПродолжительностьОбеда) - '00010101';
	мПродолжительностьРабочегоДня  = 0;
	
	Если НачалоДня(ДатаНачала) = НачалоДня(ДатаОкончания) Тогда
		
		сВремяНочьОдинДень = ВремяНочьОдинДень(ДокументСсылка,ДатаНачала,ДатаОкончания);
		сВремяНочьПервыйДень = 0;
		сВремяНочьПоследнийДень = 0;
		//
		сВремяОдинДень = ДокументСсылка.ДатаНачала - ДокументСсылка.ДатаОкончания;
		сВремяПервыйДень = 0;
		сВремяПоследнийДень = 0;
	Иначе
		сВремяНочьПервыйДень = ВремяНочьПервыйДень(ДокументСсылка,ДатаНачала,ДатаОкончания);
		сВремяНочьПоследнийДень = ВремяНочьПоследнийДень(ДокументСсылка,ДатаНачала,ДатаОкончания);
		сВремяНочьОдинДень = 0;
		//
		сВремяПервыйДень = уатОбщегоНазначения.уатВремяВСекунды(24) - (ДатаНачала - НачалоДня(ДатаНачала));
		сВремяПоследнийДень = ДатаОкончания - НачалоДня(ДатаОкончания);
		сВремяОдинДень = 0;
		
	КонецЕсли;	
	
	сВремяНочь = сВремяНочьПервыйДень + сВремяНочьПоследнийДень + сВремяНочьОдинДень;
	сВремяРаботы = сВремяПервыйДень + сВремяПоследнийДень + сВремяОдинДень; 
	
	сВремяНочь = ?(тзРВССвернуть.Количество() = тзРВС.Количество(),сВремяНочь,0);
	
	Если сВремяНочь > 0 Тогда
		
		нзРВС.Очистить();
		
		Для Каждого СтрРВС Из тзРВС Цикл
			
			сВремяПоФакту = СтрРВС.Время;
			сОтработаноеВремя = Мин(сВремяПоФакту,сВремяРаботы);
			
			Если Слесарь = ПолучитьДолжностьСотрудникаУАТ(СтрРВС.Сотрудник,Источник.Организация,Источник.Дата) Тогда
				ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа;
			Иначе
				Если ПроверитьВидОбслуживанияТСсОсобымПорядкомУчета(ДокументСсылка.ВидОбслуживания) Тогда
					ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа;
				Иначе	
					ВидИспользованияРабочегоВремени = СтрРВС.ВидИспользованияРабочегоВремени
				КонецЕсли;
			КонецЕсли;
			
			нСтрРВС = нзРВС.Добавить();
			ЗаполнитьЗначенияСвойств(нСтрРВС,СтрРВС);
			нСтрРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Ночные;
			нСтрРВС.Время = Мин(сВремяНочь,сОтработаноеВремя);
			
			сДневноеВремя = сОтработаноеВремя - сВремяНочь;
			
			Если сДневноеВремя > 0 Тогда
				нСтрРВС = нзРВС.Добавить();
				ЗаполнитьЗначенияСвойств(нСтрРВС,СтрРВС);
				нСтрРВС.ВидИспользованияРабочегоВремени = ВидИспользованияРабочегоВремени;
				нСтрРВС.Время = сДневноеВремя;
			КонецЕсли;	
			
			Записывать = Истина;
			
		КонецЦикла;	
	Иначе
		
		Для Каждого СтрРВС Из нзРВС Цикл
			
			Если СтрРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Ремонт  Тогда 
				Если Слесарь = ПолучитьДолжностьСотрудникаУАТ(СтрРВС.Сотрудник,Источник.Организация,Источник.Дата) Тогда
					СтрРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа;
					Записывать = Истина;
				ИначеЕсли ПроверитьВидОбслуживанияТСсОсобымПорядкомУчета(ДокументСсылка.ВидОбслуживания) Тогда
					СтрРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа;
					Записывать = Истина;
				КонецЕсли;
			КонецЕсли;	
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Если Записывать Тогда
		нзРВС.Записать();
	КонецЕсли;	
	
	ЗЧ = Источник.Материалы.Выгрузить();
	
	Если Зч.Количество() > 0 Тогда
		нзРНТС = РегистрыСведений.ЮЦАУ_НоменклатураТС.СоздатьНаборЗаписей();
		нзРНТС.Отбор.Регистратор.Установить(ДокументСсылка);
		нзРНТС.Прочитать();         	
		
		Для Каждого Стр Из ЗЧ Цикл
			нЗапись = нзРНТС.Добавить();
			нЗапись.Период = Источник.Дата;
			нЗапись.Регистратор = Источник;
			нЗапись.ТС = Источник.ТС;
			нЗапись.Номенклатура = Стр.Номенклатура;
			нЗапись.Количество = Стр.Количество;
			нЗапись.ДатаУстановки = ?(ЗначениеЗаполнено(Стр.ДатаУстановки), Стр.ДатаУстановки, Источник.ДатаОкончания);
		КонецЦикла;
		
