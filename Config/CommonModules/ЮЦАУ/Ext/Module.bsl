//КАА
Функция ПолучитьОсновныеСведенияОПеревозке(ВидПутевогоЛиста) Экспорт
	
	ОсновныеСведенияОПеревозке = Новый Структура("ВидПутевогоЛиста,ВидСообщения,ВидПеревозки", ВидПутевогоЛиста, Неопределено, Неопределено);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЮЦАУ_ОсновныеСведенияОПеревозке.ВидПутевогоЛиста КАК ВидПутевогоЛиста,
		|	ЮЦАУ_ОсновныеСведенияОПеревозке.ВидСообщения КАК ВидСообщения,
		|	ЮЦАУ_ОсновныеСведенияОПеревозке.ВидПеревозки КАК ВидПеревозки
		|ИЗ
		|	РегистрСведений.ЮЦАУ_ОсновныеСведенияОПеревозке КАК ЮЦАУ_ОсновныеСведенияОПеревозке
		|ГДЕ
		|	ЮЦАУ_ОсновныеСведенияОПеревозке.ВидПутевогоЛиста = &ВидПутевогоЛиста";
	
	Запрос.УстановитьПараметр("ВидПутевогоЛиста", ВидПутевогоЛиста);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОсновныеСведенияОПеревозке, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	Возврат ОсновныеСведенияОПеревозке;
	
КонецФункции	

