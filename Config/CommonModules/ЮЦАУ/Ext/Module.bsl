Функция ПолучитьНочныеЧасы(ДокументСсылка, Смена)
	
	Ночные = 0;
	Если Смена = Перечисления.ЮЦАУ_Смены.ПерваяСмена Тогда			

		Если Час(ДокументСсылка.ДатаВыезда) < 6 Тогда
			Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) - (ДокументСсылка.ДатаВыезда - НачалоДня(ДокументСсылка.ДатаВыезда));
		КонецЕсли;

	ИначеЕсли Смена = Перечисления.ЮЦАУ_Смены.ВтораяСмена Тогда			
	
		Если Час(ДокументСсылка.ДатаВозвращения) >= 22 И День(ДокументСсылка.ДатаВозвращения) = День(ДокументСсылка.ДатаВыезда) Тогда
			Ночные = ДокументСсылка.ДатаВозвращения - (НачалоДня(ДокументСсылка.ДатаВозвращения) + уатОбщегоНазначения.уатВремяВСекунды(22));
		КонецЕсли;
		
		Если День(ДокументСсылка.ДатаВозвращения) > День(ДокументСсылка.ДатаВыезда) И Час(ДокументСсылка.ДатаВозвращения) >= 6 Тогда
			Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) + 2 * 3600;
		КонецЕсли;
		
		Если (День(ДокументСсылка.ДатаВозвращения) > День(ДокументСсылка.ДатаВыезда) ИЛИ Месяц(ДокументСсылка.ДатаВозвращения) > Месяц(ДокументСсылка.ДатаВыезда)) И Час(ДокументСсылка.ДатаВозвращения) < 6 Тогда
			Ночные = ДокументСсылка.ДатаВозвращения - НачалоДня(ДокументСсылка.ДатаВозвращения) + 2 * 3600;
		КонецЕсли;
		
	ИначеЕсли Смена = Перечисления.ЮЦАУ_Смены.ПолнаяСмена Тогда	
	
		Если Час(ДокументСсылка.ДатаВыезда) <= 6 Тогда
			Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) - (ДокументСсылка.ДатаВыезда - НачалоДня(ДокументСсылка.ДатаВыезда));
		КонецЕсли;
		
		Если Час(ДокументСсылка.ДатаВозвращения) >= 22 И День(ДокументСсылка.ДатаВозвращения) = День(ДокументСсылка.ДатаВыезда) Тогда
			Ночные = ДокументСсылка.ДатаВозвращения - (НачалоДня(ДокументСсылка.ДатаВозвращения) + уатОбщегоНазначения.уатВремяВСекунды(22));
		КонецЕсли;
		
		Если День(ДокументСсылка.ДатаВозвращения) > День(ДокументСсылка.ДатаВыезда) И Час(ДокументСсылка.ДатаВозвращения) > 6 Тогда
			Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) + 2 * 3600;
		КонецЕсли;
		
		Если Час(ДокументСсылка.ДатаВыезда) <= 6 И День(ДокументСсылка.ДатаВозвращения) > День(ДокументСсылка.ДатаВыезда) Тогда 
			Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) - (ДокументСсылка.ДатаВыезда - НачалоДня(ДокументСсылка.ДатаВыезда)) + ДокументСсылка.ДатаВозвращения - НачалоДня(ДокументСсылка.ДатаВозвращения) + 2 * 3600;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ночные;
	
КонецФункции
