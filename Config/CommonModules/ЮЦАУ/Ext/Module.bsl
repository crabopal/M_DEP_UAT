Процедура ОбработатьПроведениеДокумента_уатПутевойЛист(Источник)
	
	нзВыработка = РегистрыНакопления.уатВыработкаСотрудников.СоздатьНаборЗаписей();
	нзВыработка.Отбор.Регистратор.Установить(Источник.Ссылка);
	нзВыработка.Прочитать();
	
	нзРВС = РегистрыНакопления.уатРабочееВремяСотрудников.СоздатьНаборЗаписей();
	нзРВС.Отбор.Регистратор.Установить(Источник.Ссылка);
	нзРВС.Прочитать();
	тзРВС = нзРВС.Выгрузить();
	нзРВС.Очистить();
	
	Записывать = Ложь;
	
	//Зачистка таблицы движений рабочего времени сотрудников: удаление видов времени работа, ночные, простой почасовой 
	СтаршийИндекс = тзРВС.Количество() - 1;
	Для й = -СтаршийИндекс По 0 Цикл
		СтрокаРВС = тзРВС[-й];
		Если СтрокаРВС.ВидИспользованияРабочегоВремени = Справочники.уатВидыИспользованияРабочегоВремени.Работа или 
