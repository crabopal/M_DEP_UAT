// Останавливает выполнение кода на заданное время.
//
// Параметры:
//  Секунд - Число - время ожидания в секундах.
//
Процедура Пауза(Секунд) Экспорт
	
	ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();
	
	Если ФоновоеЗадание = Неопределено Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("ОбщегоНазначенияБТС.Пауза", Параметры);
	КонецЕсли;
	
	Попытка
		ФоновоеЗадание.ОжидатьЗавершения(Секунд);
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

//Автобусные перевозки
Функция ПолучитьДанныеМаршрутаВыездаСмены(Выезд, Смена, ВыхБудн, Период, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЮЦАУДлительностьВыездаСрезПоследних.Длительность КАК Длительность,
	|	ЮЦАУДлительностьВыездаСрезПоследних.НачалоОбеда КАК НачалоОбеда,
	|	ЮЦАУДлительностьВыездаСрезПоследних.КонецОбеда КАК КонецОбеда,
	|	ЮЦАУДлительностьВыездаСрезПоследних.ВремяВыезда КАК ВремяВыезда,
	|	ЮЦАУДлительностьВыездаСрезПоследних.ВремяЗаезда КАК ВремяЗаезда,
	|	ЮЦАУДлительностьВыездаСрезПоследних.НачалоДопОбеда КАК НачалоДопОбеда,
	|	ЮЦАУДлительностьВыездаСрезПоследних.КонецДопОбеда КАК КонецДопОбеда
	|ИЗ
	|	РегистрСведений.ЮЦАУДлительностьВыезда.СрезПоследних(&Период, ) КАК ЮЦАУДлительностьВыездаСрезПоследних
	|ГДЕ
	|	ЮЦАУДлительностьВыездаСрезПоследних.Организация = &Организация
	|	И ЮЦАУДлительностьВыездаСрезПоследних.Выезд = &Выезд
	|	И ЮЦАУДлительностьВыездаСрезПоследних.Смена = &Смена
//	|	И ЮЦАУДлительностьВыездаСрезПоследних.Период < &Период
	|	И ЮЦАУДлительностьВыездаСрезПоследних.ВыхБудн = &ВыхБудн";
	
	Запрос.УстановитьПараметр("Выезд", 			Выезд);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	Запрос.УстановитьПараметр("Период", 		Период);
	Запрос.УстановитьПараметр("Смена", 			Смена);
	Запрос.УстановитьПараметр("ВыхБудн", 		ВыхБудн);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ДанныеМаршрута = Новый Структура;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ДанныеМаршрута.Вставить("Длительность", 	ВыборкаДетальныеЗаписи.Длительность);
		ДанныеМаршрута.Вставить("НачалоОбеда", 		ВыборкаДетальныеЗаписи.НачалоОбеда);
		ДанныеМаршрута.Вставить("КонецОбеда", 		ВыборкаДетальныеЗаписи.КонецОбеда);
		ДанныеМаршрута.Вставить("ВремяВыезда",		ВыборкаДетальныеЗаписи.ВремяВыезда);
		ДанныеМаршрута.Вставить("ВремяЗаезда", 		ВыборкаДетальныеЗаписи.ВремяЗаезда);
		ДанныеМаршрута.Вставить("НачалоДопОбеда", 	ВыборкаДетальныеЗаписи.НачалоДопОбеда);
		ДанныеМаршрута.Вставить("КонецДопОбеда", 	ВыборкаДетальныеЗаписи.КонецДопОбеда);
		
	КонецЦикла;
	
	Возврат ДанныеМаршрута;
	
КонецФункции

Функция ПолучитьНочныеДляПервойСмены(ДокументСсылка)
	
	Ночные = 0;
	
	Если Час(ДокументСсылка.ДатаВыезда) < 6 Тогда
		
		Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) - (ДокументСсылка.ДатаВыезда - НачалоДня(ДокументСсылка.ДатаВыезда));
		
	КонецЕсли;
	
	Возврат Ночные;
	
КонецФункции

Функция ПолучитьНочныеДляВторойСмены(ДокументСсылка)
	
	Ночные = 0;
	
	Если Час(ДокументСсылка.ДатаВозвращения) >= 22 И День(ДокументСсылка.ДатаВозвращения) = День(ДокументСсылка.ДатаВыезда) Тогда
		
		Ночные = ДокументСсылка.ДатаВозвращения - (НачалоДня(ДокументСсылка.ДатаВозвращения) + уатОбщегоНазначения.уатВремяВСекунды(22));
		
	КонецЕсли;
	
	Если День(ДокументСсылка.ДатаВозвращения) > День(ДокументСсылка.ДатаВыезда) И Час(ДокументСсылка.ДатаВозвращения) >= 6 Тогда
		
		Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) + 2 * 3600;
		
	КонецЕсли;
	
	Если (День(ДокументСсылка.ДатаВозвращения) > День(ДокументСсылка.ДатаВыезда) ИЛИ Месяц(ДокументСсылка.ДатаВозвращения) > Месяц(ДокументСсылка.ДатаВыезда)) И Час(ДокументСсылка.ДатаВозвращения) < 6 Тогда
		
		Ночные = ДокументСсылка.ДатаВозвращения - НачалоДня(ДокументСсылка.ДатаВозвращения) + 2 * 3600;
		
	КонецЕсли;
	
	Возврат Ночные;
	
КонецФункции

Функция ПолучитьНочныеДляПолнойСмены(ДокументСсылка)
	
	Ночные = 0;
	
	Если Час(ДокументСсылка.ДатаВыезда) <= 6 Тогда
		
		Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) - (ДокументСсылка.ДатаВыезда - НачалоДня(ДокументСсылка.ДатаВыезда));
		
	КонецЕсли;
	
	Если Час(ДокументСсылка.ДатаВозвращения) >= 22 И День(ДокументСсылка.ДатаВозвращения) = День(ДокументСсылка.ДатаВыезда) Тогда
		
		Ночные = ДокументСсылка.ДатаВозвращения - (НачалоДня(ДокументСсылка.ДатаВозвращения) + уатОбщегоНазначения.уатВремяВСекунды(22));
		
	КонецЕсли;
	
	Если День(ДокументСсылка.ДатаВозвращения) > День(ДокументСсылка.ДатаВыезда) И Час(ДокументСсылка.ДатаВозвращения) > 6 Тогда
		
		Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) + 2 * 3600;
		
	КонецЕсли;
	
	Если Час(ДокументСсылка.ДатаВыезда) <= 6 И День(ДокументСсылка.ДатаВозвращения) > День(ДокументСсылка.ДатаВыезда) Тогда 
		
		Ночные = уатОбщегоНазначения.уатВремяВСекунды(6) - (ДокументСсылка.ДатаВыезда - НачалоДня(ДокументСсылка.ДатаВыезда)) + ДокументСсылка.ДатаВозвращения - НачалоДня(ДокументСсылка.ДатаВозвращения) + 2 * 3600;
		
	КонецЕсли;
	
	Возврат Ночные;
	
КонецФункции

