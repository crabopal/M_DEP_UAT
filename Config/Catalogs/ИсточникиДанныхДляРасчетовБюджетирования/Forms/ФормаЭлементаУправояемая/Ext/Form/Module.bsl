Процедура ОткрытьКонструкторЗапроса(Команда)
	Конструктор = Новый КонструкторЗапроса;
	Если ЗначениеЗаполнено(Объект.ТекстЗапроса) Тогда
		Конструктор.Текст = Объект.ТекстЗапроса; 
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ОткрытьКонструкторЗапросаЗавершение",ЭтаФорма); 
	Конструктор.Показать(Оповещение); 
КонецПроцедуры

&НаКлиенте 
Процедура ОткрытьКонструкторЗапросаЗавершение(Текст, ДополнительныеПараметры) Экспорт 
	Если НЕ Текст = Неопределено Тогда 
		Объект.ТекстЗапроса = Текст; 
	КонецЕсли; 
КонецПроцедуры   

&НаКлиенте
Процедура ПроизвольныйЗапросПриИзменении(Элемент)
	Если Объект.ПроизвольныйЗапрос Тогда
		Объект.ПредставлениеРегистра="";
		Объект.ИмяРегистра="";
		УстановитьВидимость()
	Иначе
		ТекстВопроса="При смене режима редактирования текущие настройки будут утеряны.
		|Продолжить?";
		ПоказатьВопрос(Новый ОписаниеОповещения("ПроизвольныйЗапросПриИзмененииЗавершение", ЭтаФорма), ТекстВопроса,РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольныйЗапросПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		Объект.Показатели.Очистить();
		Объект.ИзмеренияИсточника.Очистить();
		Объект.ДатыОтбораДанныхИсточника.Очистить();
		Объект.ТекстЗапроса = "";
	Иначе
		Объект.ПроизвольныйЗапрос=Истина;
	КонецЕсли;
	УстановитьВидимость();
КонецПроцедуры


&НаСервере
Процедура ПрименитьЗапросНаСервере()
	ПостроительОтчета=Новый ПостроительОтчета;
	ПостроительОтчета.Текст = ОБъект.ТекстЗапроса;
	ПостроительОтчета.ЗаполнитьНастройки();
	
	Объект.Показатели.Очистить();
	Объект.ДатыОтбораДанныхИсточника.Очистить();
	Объект.ИзмеренияИсточника.Очистить();
	
	Для Каждого Поле ИЗ ПостроительОтчета.ДоступныеПоля Цикл
		
		Если Строка(Поле.ТипЗначения)="Число" Тогда
			
			Если НЕ ПостроительОтчета.ВыбранныеПоля.Найти(Поле.Имя)=Неопределено Тогда
				
				СтрокаПоказатель=Объект.Показатели.Добавить();
				СтрокаПоказатель.Имя=Поле.Имя;
				СтрокаПоказатель.Представление=Поле.Представление;
				СтрокаПоказатель.Использование=Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПроверитьТекстЗапросаНаСервере()
	ПостроительОтчета=Новый ПостроительОтчета;
	Попытка
		ПостроительОтчета.Текст = ОБъект.ТекстЗапроса;
	Исключение
		РезультатПроверки = ОписаниеОшибки();
		Возврат РезультатПроверки;
	КонецПопытки;
	ПостроительОтчета.ЗаполнитьНастройки();
	Если ПостроительОтчета.ИзмеренияСтроки.Количество()>0 Тогда
		РезультатПроверки= "В запросе, используемом для источника данных, нельзя использовать итоги.
		|Воспользуйтесь группировками.";
		Возврат РезультатПроверки;
	КонецЕсли;
	Возврат "ОК";
КонецФункции

&НаКлиенте
Процедура ПрименитьЗапрос(Команда)
	РезультатПроверкиЗапроса = ПроверитьТекстЗапросаНаСервере();
	Если РезультатПроверкиЗапроса <> "ОК" Тогда
		ПоказатьПредупреждение(,РезультатПроверкиЗапроса);
		Возврат;	
	КонецЕсли;
	ПрименитьЗапросНаСервере();
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьВидимость();
КонецПроцедуры


&НаКлиенте
Процедура ИзмеренияИсточникаИмяПоляИсточникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка=Ложь;
	СписокПолей = ПолучитьСписокПолейИзЗапрсоа();
	
	ПараметрыОткрытия = Новый Структура("СписокПолей",СписокПолей);
	РезультатВыбора = Неопределено;
	ТекСтрока = Элементы.ИзмеренияИсточника.ТекущиеДанные;
	
	ОткрытьФорму("Справочник.ИсточникиДанныхДляРасчетовБюджетирования.Форма.ФормаВыборкаПоля",ПараметрыОткрытия,ЭтаФорма,,,, Новый ОписаниеОповещения("ИзмеренияИсточникаИмяПоляИсточникаНачалоВыбораЗавершение", ЭтаФорма,ТекСтрока), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзмеренияИсточникаИмяПоляИсточникаНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	РезультатВыбора = Результат;
	Если РезультатВыбора = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	ТекСтрока = ДополнительныеПараметры;
	ТекСтрока.ИмяПоляИсточника = РезультатВыбора.Имя;
	ТекСтрока.ПутьКДанным = РезультатВыбора.Имя;
	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокПолейИзЗапрсоа()
	СписокПолей = Новый Соответствие;
	ПостроительОтчета=Новый ПостроительОтчета;
	ПостроительОтчета.Текст = ОБъект.ТекстЗапроса;
	ПостроительОтчета.ЗаполнитьНастройки();
	
	Для Каждого Поле ИЗ ПостроительОтчета.ДоступныеПоля Цикл
		Если Строка(Поле.ТипЗначения)<>"Число" Тогда
			Если ПостроительОтчета.ВыбранныеПоля.Найти(Поле.Имя)<>Неопределено Тогда
				СписокПолей.Вставить(Поле.Имя,Поле.ПутьКДанным);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат СписокПолей;
КонецФункции

&НаКлиенте
Процедура Проверить(Команда)
	ТабДок = Новый ТабличныйДокумент;
	ПроверитьИсточник(ТабДок);
	ТабДок.Показать();
КонецПроцедуры

&НаСервере
Процедура ПроверитьИсточник(ТабДок)
	
	ПостроительПроверка=Новый ПостроительОтчета;
	ПостроительПроверка.Текст=Объект.ТекстЗапроса;
	
	Если (НЕ Объект.ПроизвольныйЗапрос) И Найти(ВРЕГ(ПостроительПроверка.Текст),"НАЧАЛОПЕРИОДА(")=0 Тогда
		ПостроительПроверка.Текст=СтрЗаменить(ПостроительПроверка.Текст,"День","");
	КонецЕсли;

	ПостроительПроверка.ЗаполнитьНастройки();
	
	Если Объект.ПроизвольныйЗапрос Тогда
		
		//Для Каждого СтрокаПараметров Из Параметры Цикл
		//	
		//	ПостроительПроверка.Параметры.Вставить(СтрокаПараметров.ИмяПараметра, СтрокаПараметров.ЗначениеПараметра);
		//	
		//КонецЦикла;
		
	Иначе
		
		////Для Каждого Параметр Из ПостроительОтчета.Параметры Цикл
		////	
		////	ПостроительПроверка.Параметры.Вставить(Параметр.Ключ,Параметр.Значение);
		////	
		////КонецЦикла;
		
	КонецЕсли;
	
	Для каждого Граница Из Объект.ДатыОтбораДанныхИсточника Цикл
		
		Если Граница.НачальнаяГраницаОтсчета=Перечисления.ВидыГраницОтбораИсточникаПланирования.ФиксированнаяДата Тогда
			НачальнаяДатаГраницы=Граница.ДатаНачальнойГраницыОтсчета;
		ИначеЕсли Граница.НачальнаяГраницаОтсчета=Перечисления.ВидыГраницОтбораИсточникаПланирования.НачалоПериода Тогда
			НачальнаяДатаГраницы=НачалоМесяца(ТекущаяДата());
		ИначеЕсли Граница.НачальнаяГраницаОтсчета=Перечисления.ВидыГраницОтбораИсточникаПланирования.КонецПериода Тогда
			НачальнаяДатаГраницы=КонецМесяца(ТекущаяДата());
		КонецЕсли;
		
		Если НЕ Граница.СдвигВПериодах=0 Тогда
			
			Если Граница.НачальнаяГраницаОтсчета=Перечисления.ВидыГраницОтбораИсточникаПланирования.КонецПериода Тогда
				
				НачальнаяДатаГраницы=КонецДня(ОбщегоНазначения.ДобавитьИнтервал(НачальнаяДатаГраницы,Граница.ПериодСмещения,Граница.СдвигВПериодах));
				
			Иначе
				
				НачальнаяДатаГраницы=ОбщегоНазначения.ДобавитьИнтервал(НачальнаяДатаГраницы,Граница.ПериодСмещения,Граница.СдвигВПериодах);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ПостроительПроверка.Параметры.Вставить(Граница.ИмяДатаГраницы,НачальнаяДатаГраницы);
		
	КонецЦикла;
	
	ПостроительПроверка.Выполнить(); 
	ПостроительПроверка.Вывести(ТабДок);
	
 КонецПроцедуры
 
