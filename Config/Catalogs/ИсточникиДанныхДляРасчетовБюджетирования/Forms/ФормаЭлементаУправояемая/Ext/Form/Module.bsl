&НаСервере
Процедура ДобавитьПоказательВТаблицу(Представление,Имя,Использование=Истина)
	НовыйПоказатель = Объект.Показатели.Добавить();
	НовыйПоказатель.Представление = Представление;
	НовыйПоказатель.Имя = Имя;
	НовыйПоказатель.Использование = Использование;
