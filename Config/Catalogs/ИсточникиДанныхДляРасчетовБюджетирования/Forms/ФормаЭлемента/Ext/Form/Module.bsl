&НаКлиенте
Процедура НачалоВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		пМД = Элементы.НастройкиПоРегиструБухгатерии.ТекущиеДанные[Элемент.Имя].Метаданные(); 
		Если Метаданные.Справочники.Найти(пМД.Имя) <> Неопределено Тогда
			Если пМД.Владельцы.Количество() > 0 Тогда
				СтандартнаяОбработка = Ложь;
				вФорма = Справочники[пМД.Имя].ПолучитьформуВыбора(,Элемент);
				вФорма.РежимВыбора = Ложь;
				Если вФорма.ЭлементыФормы.СправочникСписок.Колонки.Найти("Владелец") <> Неопределено Тогда
					вФорма.ЭлементыФормы.СправочникСписок.Колонки.Владелец.Видимость = Истина;
				КонецЕсли;
				вФорма.Открыть();
				вФорма.РежимВыбора = Истина;
			КонецЕсли;	 
		КонецЕсли;   
	#КонецЕсли
КонецПроцедуры

