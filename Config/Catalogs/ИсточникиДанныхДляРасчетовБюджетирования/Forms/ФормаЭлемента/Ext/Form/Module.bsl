&НаСервере
Процедура ПолучитьСхемуКомпоновкиДанных()
	// инициализирует новую СКД и помещает во временное хранилище
	// устанавливает адрес временного хранилища схемы компоновки данных
	СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновкиДанных.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ЛокальнаяБаза";
	ИсточникДанных.СтрокаСоединения = "";
	ИсточникДанных.ТипИсточникаДанных= "Local";
	
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "Запрос";
	НаборДанных.ИсточникДанных = "ЛокальнаяБаза";
	НаборДанных.АвтоЗаполнениеДоступныхПолей=Истина;
	
	НаборДанных.Запрос =
	"ВЫБРАТЬ
	|*";
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
КонецПроцедуры


&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Правило = ДанныеФормыВЗначение(Объект,Тип("СправочникОбъект.ИсточникиДанныхДляРасчетовБюджетирования"));
		СохраненнаяСхема = Правило.СхемаИсточникаДанных.Получить();
		СохраненныйКомпоновщикНастроек = Правило.КомпоновщикНастроек.Получить();
		
		Если СохраненнаяСхема = Неопределено Тогда
			ПолучитьСхемуКомпоновкиДанных();
			ИнициализироватьКомпоновщикСервер(Неопределено);
		Иначе
			СхемаКомпоновкиДанных = СохраненнаяСхема;
			АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
		КонецЕсли;
		
		ИнициализироватьКомпоновщикСервер(СохраненныйКомпоновщикНастроек);
	Иначе
		ИнициализироватьКомпоновщикСервер(Неопределено);
		// новый элемент 
		// для него нужно создать пустую СКД и получить адрес временного хранилища
//		АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, УникальныйИдентификатор);
	КонецЕсли;
	
	
	//ИнициализироватьКомпоновщикСервер(Неопределено);
	//Если ТипЗнч(СхемаКомпоновкиДанных)=Тип("СхемаКомпоновкиДанных") Тогда
	//	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	//	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	//КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьСхемуКомпоновки(Команда)
	ОткрытьКонструкторСхемыКомпоновкиДанных();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКонструкторСхемыКомпоновкиДанных()
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		// Настройки компоновщика настроек помещаются в редактируемую схему
		ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиДанных);
		
		// Создается копия редактируемой схемы
		СхемаКомпоновкиДанных = СериализаторXDTO.ПрочитатьXDTO(СериализаторXDTO.ЗаписатьXDTO(ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных)));
		
		// Копия редактируемой схемы открывается в конструкторе
		Конструктор = Новый КонструкторСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);
		Конструктор.Редактировать(ЭтаФорма);
		
	#Иначе
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Для того, чтобы редактировать схему компоновки, необходимо запустить конфигурацию в режиме толстого клиента.'"));
		
	#КонецЕсли
	
КонецПроцедуры


&НаСервереБезКонтекста
Процедура ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиДанных)
	
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
	
	КомпоновкаДанныхКлиентСервер.ОчиститьНастройкиКомпоновкиДанных(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КомпоновкаДанныхКлиентСервер.СкопироватьНастройкиКомпоновкиДанных(СхемаКомпоновкиДанных.НастройкиПоУмолчанию, КомпоновщикНастроек.Настройки);
	
	ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, АдресСхемыКомпоновкиДанных);
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьИспользованиеПараметра(СКД,ИмяПараметра,Использование)
	 Параметр = СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы.Найти(ИмяПараметра);
	 Если Параметр <> Неопределено Тогда
		Параметр.Использование = Использование;
	 КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	// Структуру отчета пересоздаем во избежание ошибок
	// если ее забыли создать млм создали не так как нужно
	
	СтруктураОтчета = ВыбранноеЗначение.НастройкиПоУмолчанию.Структура;
	СтруктураОтчета.Очистить();
	
	ГруппировкаДетальныхЗаписей = СтруктураОтчета.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаДетальныхЗаписей.Имя = "ДетальныеЗаписиБюджетирования";
	ГруппировкаДетальныхЗаписей.Использование = Истина;
	
	АвтоПоле = ГруппировкаДетальныхЗаписей.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	// отключим итоги по вертикали
	ИтогиПоВертикали = ВыбранноеЗначение.НастройкиПоУмолчанию.ПараметрыВывода.Элементы.Найти("ВертикальноеРасположениеОбщихИтогов");
	Если ИтогиПоВертикали <> Неопределено Тогда
		ИтогиПоВертикали.Значение = РасположениеИтоговКомпоновкиДанных.Нет;
		ИтогиПоВертикали.Использование = Истина;
	КонецЕсли;	
	
	// установим использование у параметоров периода
	УстановитьИспользованиеПараметра(ВыбранноеЗначение,"НачалоПериода",Истина);
	УстановитьИспользованиеПараметра(ВыбранноеЗначение,"КонецПериода",Истина);
	
	ПоместитьВоВременноеХранилище(ВыбранноеЗначение,АдресСхемыКомпоновкиДанных);
	// тут можно выбрать все доступные поля из СКД
	ИнициализироватьКомпоновщикСервер(Неопределено);
	КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
	Для Каждого ДоступноеПоле Из КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл
		Если ДоступноеПоле.Папка Тогда
			ПродолжитЬ;
		КонецЕсли;	
		НовоеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		НовоеПоле.Заголовок = ДоступноеПоле.Заголовок;
		НовоеПоле.Поле = ДоступноеПоле.Поле;
		НовоеПоле.Использование = Истина;
	КонецЦикла;
	
КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	// скопируем настройки из компоновщика настроек в СКД
	ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиДанных);
	// сохраним СКД в хранилище
	СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
	ТекущийОбъект.СхемаИсточникаДанных = Новый ХранилищеЗначения(СхемаКомпоновкиДанных);
	// сохраним настройки компановщика в хранилище
	ТекущийОбъект.КомпоновщикНастроек = Новый ХранилищеЗначения(КомпоновщикНастроек.ПолучитьНастройки());
	
КонецПроцедуры


&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	СохраненныйКомпоновщикНастроек = ТекущийОбъект.КомпоновщикНастроек.Получить();
	ИнициализироватьКомпоновщикСервер(СохраненныйКомпоновщикНастроек);
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикСервер(НастройкаКомпоновки)
	Если Не ЗначениеЗаполнено(АдресСхемыКомпоновкиДанных) Тогда
		ПолучитьСхемуКомпоновкиДанных();
	КонецЕсли;
	
	Попытка
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных));
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
					УровеньЖурналаРегистрации.Ошибка,,,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
	КонецПопытки;
	
	Если НастройкаКомпоновки = Неопределено Тогда
		СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкаКомпоновки);
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	КонецЕсли;
	
КонецПроцедуры

// проверка результата работы источника данных
&НаСервере
Процедура ПроверитьРезультатНаСервере(ДокументРезультат)
	СКД = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
	// подготовим макет 
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.ПолучитьНастройки());
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет);
	ПроцессорКомпоновки.Сбросить();
	
	// выведем результат                                                             
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ДокументРезультат);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРезультат(Команда)
	ДокументРезультат = Новый ТабличныйДокумент;
	ПроверитьРезультатНаСервере(ДокументРезультат);
	ДокументРезультат.Показать();
КонецПроцедуры

&НаСервере
Процедура ПроверитьРезультатНаСервереВТЗ()
	СКД = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
	// подготовим макет 
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(СКД, КомпоновщикНастроек.ПолучитьНастройки(),,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет);
	ПроцессорКомпоновки.Сбросить();
	
	// выведем результат       
	ТЗ = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТЗ);
	ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		// что то не работает ну и не очень хотелось в отладчике можно таблицу поймать
		ТЗ.ВыбратьСтроку();
	#КонецЕсли
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьРезультатВТЗ(Команда)
	ПроверитьРезультатНаСервереВТЗ();
КонецПроцедуры

#Область КонструкторЗапроса
// конструктор запроса для совместимости со старыми статьями
&НаКлиенте
Процедура ОткрытьКонтструкторЗапроса(Команда)
	Конструктор = Новый КонструкторЗапроса;
	Если ЗначениеЗаполнено(Объект.ТекстЗапроса) Тогда
		Конструктор.Текст = Объект.ТекстЗапроса; 
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ОткрытьКонструкторЗапросаЗавершение",ЭтаФорма); 
	Конструктор.Показать(Оповещение); 
КонецПроцедуры

&НаКлиенте 
Процедура ОткрытьКонструкторЗапросаЗавершение(Текст, ДополнительныеПараметры) Экспорт 
	Если НЕ Текст = Неопределено Тогда 
		Объект.ТекстЗапроса = Текст; 
	КонецЕсли; 
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьЗапросВСКД(Команда)
	ОткрытьКонструкторСхемыКомпоновкиДанныхПоЗапросу();
КонецПроцедуры
	
&НаКлиенте
Процедура ОткрытьКонструкторСхемыКомпоновкиДанныхПоЗапросу()
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
		// Настройки компоновщика настроек помещаются в редактируемую схему
		//ПоместитьНастройкиВСхемуКомпоновкиДанных(КомпоновщикНастроек, АдресСхемыКомпоновкиДанных);
		
		// Создается копия редактируемой схемы
		СхемаКомпоновкиДанных = СериализаторXDTO.ПрочитатьXDTO(СериализаторXDTO.ЗаписатьXDTO(ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных)));
		НаборДанных = СхемаКомпоновкиДанных.НаборыДанных[0];
		НаборДанных.Имя = "Запрос";
		НаборДанных.ИсточникДанных = "ЛокальнаяБаза";
		НаборДанных.АвтоЗаполнениеДоступныхПолей=Истина;
		НаборДанных.Запрос = Объект.ТекстЗапроса;

		// Копия редактируемой схемы открывается в конструкторе
		Конструктор = Новый КонструкторСхемыКомпоновкиДанных(СхемаКомпоновкиДанных);
		Конструктор.Редактировать(ЭтаФорма);
		
	#Иначе
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Для того, чтобы редактировать схему компоновки, необходимо запустить конфигурацию в режиме толстого клиента.'"));
		
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура СгенерироватьЗапросПоРегистру(Команда)
	СгенерироватьЗапросПоНастройкамРегНакопленияДляИсточника();
КонецПроцедуры


&НаСЕрвере
Процедура СгенерироватьЗапросПоНастройкамРегНакопленияДляИсточника()
	
	номПараметра = 1;
	
	тНачалоШапки = "ВЫБРАТЬ ";                               
	тРезультат = "";
	тЗапроса   = "";
	тКонецШапки = " КАК Сумма,";                         
	
	// если нет строк настройки тогда просто возвращаемся
	Если Объект.НастройкиПоРегиструБюджетирования.Количество() = 0 Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура;
	
	Для Каждого ВыборкаСтроки Из Объект.НастройкиПоРегиструБюджетирования Цикл
		
		Вычитать = ВыборкаСтроки.Вычитать;
		КолСтрок = Объект.НастройкиПоРегиструБюджетирования.Количество();
		
		имяПараметрСтатья = "СтатьяОборотов" + Строка(номПараметра);
		имяПараметрСценарий = "Сценарий" + Строка(номПараметра);
		
		СтруктураПараметров.Вставить(имяПараметрСтатья,ВыборкаСтроки.СтатьяОборотовПоБюджетам);  // проставить знаяение
		СтруктураПараметров.Вставить(имяПараметрСценарий,ВыборкаСтроки.Сценарий);// проставить знаяение
		
		Если ВыборкаСтроки.СтатьяОборотовПоБюджетам.ЭтоГруппа Тогда
//			СтрокаОтбора =   "СтатьяОборотов В ИЕРАРХИИ (&" + имяПараметрСтатья + ")" + ?(ЗначениеЗаполнено(ВыборкаСтроки.Сценарий), " И Сценарий = &" + имяПараметрСценарий,"");
			СтрокаОтбора =   "СтатьяОборотов В ИЕРАРХИИ (&" + имяПараметрСтатья + ")" + " И Сценарий = &" + имяПараметрСценарий;
		Иначе
//			СтрокаОтбора =   "СтатьяОборотов = &" + имяПараметрСтатья + ?(ЗначениеЗаполнено(ВыборкаСтроки.Сценарий), " И Сценарий = &" + имяПараметрСценарий,"");
			СтрокаОтбора =   "СтатьяОборотов = &" + имяПараметрСтатья + " И Сценарий = &" + имяПараметрСценарий;
		КонецЕсли;

		Если КолСтрок = 1 Тогда
			
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	СУММА(ОборотыБюджетовОбороты.СуммаУпрОборот) КАК Сумма,
			|	ОборотыБюджетовОбороты.Период
			|ИЗ
			|	РегистрНакопления.ОборотыБюджетов.Обороты(&НачалоПериода, &КонецПериода, День, " + СтрокаОтбора + ") КАК ОборотыБюджетовОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	ОборотыБюджетовОбороты.Период"
			
		Иначе
			
			Собираем = (КолСтрок = номПараметра);
			
			тРезультат = тРезультат + " ВложенныйЗапрос"+Строка(номПараметра)+ ".Сумма"+Строка(номПараметра)+ ?(Собираем,"",?(Вычитать," - "," + "));
			
			тЗапроса = тЗапроса + 
			"(ВЫБРАТЬ
		    |ЕСТЬNULL(СУММА(ОборотыБюджетовОбороты.СуммаУпрОборот), 0) КАК Сумма" + Строка(номПараметра) + " 
			|ИЗ
		    |РегистрНакопления.ОборотыБюджетов.Обороты(&НачалоПериода,&КонецПериода,," +СтрокаОтбора+ ") КАК ОборотыБюджетовОбороты) КАК ВложенныйЗапрос" + Строка(номПараметра)+ ?(Собираем,"",",") + Символы.ПС ;
			
			Если Собираем Тогда //Собираем                                                                                                                               
				ТекстЗапроса = 
				"ВЫБРАТЬ
				|" + тРезультат + тКонецШапки + Символы.ПС +
				"&КонецПериода КАК Период
				|ИЗ" + Символы.ПС +
				""+ тЗапроса;
			КонецЕсли;	
			
		КонецЕсли;
		
		номПараметра = номПараметра + 1;
		
	КонецЦикла;
	
	Объект.ТекстЗапроса = ТекстЗапроса;
	
	// Создание СКД
	СоздатьСКДПоЗапросуИПараметрам(СтруктураПараметров);
КонецПроцедуры	

&НаСервере
Процедура СоздатьСКДПоЗапросуИПараметрам(СтруктураПараметров)
		// Создание СКД
	СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновкиДанных.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ЛокальнаяБаза";
	ИсточникДанных.СтрокаСоединения = "";
	ИсточникДанных.ТипИсточникаДанных= "Local";
	
	
	НаборДанных = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "Запрос";
	НаборДанных.ИсточникДанных = "ЛокальнаяБаза";
	
	НаборДанных.Запрос = Объект.ТекстЗапроса;
	НаборДанных.АвтоЗаполнениеДоступныхПолей=Истина;
	
	НовыйРесурс = СхемаКомпоновкиДанных.ПоляИтога.Добавить();
	НовыйРесурс.ПутьКДанным = "Сумма";
	НовыйРесурс.Выражение   = "Сумма(Сумма)";

	СхемаКомпоновкиДанных.Параметры.Очистить();
	
    ПараметрДанных               = СхемаКомпоновкиДанных.Параметры.Добавить();
    ПараметрДанных.Имя           = "НачалоПериода";
    ПараметрДанных.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
    ПараметрДанных.Заголовок     = "Начало периода";
    ПараметрДанных.ВключатьВДоступныеПоля = Истина;
    
    ПараметрДанных               = СхемаКомпоновкиДанных.Параметры.Добавить();
    ПараметрДанных.Имя           = "КонецПериода";
    ПараметрДанных.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
    ПараметрДанных.Заголовок     = "Конец периода";
    ПараметрДанных.ВключатьВДоступныеПоля = Истина;
	
	
	Для Каждого ПараметрИсточника Из СтруктураПараметров Цикл
		ПараметрДанных = СхемаКомпоновкиДанных.Параметры.Добавить();
		ПараметрДанных.Имя = ПараметрИсточника.Ключ;
		ПараметрДанных.Значение = ПараметрИсточника.Значение;
 	    ПараметрДанных.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
		ПараметрДанных.ОграничениеИспользования = Ложь;
	КонецЦикла;	
	
	
	СтруктураОтчета = СхемаКомпоновкиДанных.НастройкиПоУмолчанию.Структура;
	СтруктураОтчета.Очистить();
	
	ГруппировкаДетальныхЗаписей = СтруктураОтчета.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаДетальныхЗаписей.Имя = "ДетальныеЗаписиБюджетирования";
	ГруппировкаДетальныхЗаписей.Использование = Истина;
	
	АвтоПоле = ГруппировкаДетальныхЗаписей.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	
	ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных,АдресСхемыКомпоновкиДанных);

КонецПроцедуры


&НаКлиенте
Процедура СгенерироватьЗапросПоРегиструБухгалтерии(Команда)
	СгенерироватьЗапросПоНастройкамРегистраБухгалтерии();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЭтоСчетГруппа(Счет)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Хозрасчетный.Ссылка
		|ИЗ
		|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
		|ГДЕ
		|	Хозрасчетный.Родитель = &Родитель";

	Запрос.УстановитьПараметр("Родитель", Счет);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат(Истина);
	Иначе	
		Возврат(Ложь);
	КонецЕсли;

КонецФункции	


