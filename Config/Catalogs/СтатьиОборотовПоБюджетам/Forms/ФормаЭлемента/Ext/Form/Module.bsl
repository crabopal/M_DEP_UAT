&НаКлиенте
Процедура УстановитьДоступностьПолей()
	Элементы.ПоказательИсточникаДанныхДляФактаКол.Доступность=Объект.УчетПоКоличеству;
	Элементы.КоэффициентДляФактаКол.Доступность = Объект.УчетПоКоличеству;
	
	Элементы.ПоказательИсточникаДанныхДляФактаСум.Доступность=Объект.УчетПоСумме;
	Элементы.КоэффициентДляФактаСум.Доступность = Объект.УчетПоСумме;
	Элементы.ОсновнаяВалюта.Доступность = Объект.УчетПоСумме;
	
	Элементы.ПоказательИсточникаДанныхКонтрагент.Доступность = Объект.РазделениеПоКонтрагентам;
	Элементы.ПоказательИсточникаДанныхНоменклатура.Доступность = Объект.РазделениеПоНоменклатуре;
	
КонецПроцедуры

&НаКлиенте
Процедура УчетПоКоличествуПриИзменении(Элемент)
	УстановитьДоступностьПолей();
КонецПроцедуры

&НаКлиенте
Процедура УчетПоСуммеПриИзменении(Элемент)
	УстановитьДоступностьПолей();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьДоступностьПолей();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбычнуюФорму(Команда)
	ОткрытьФорму("Справочник.СтатьиОборотовПоБюджетам.Форма.ФормаЭлементаОбычная",Новый Структура("Ключ",Объект.Ссылка));
КонецПроцедуры

&НаКлиенте
Процедура РазделениеПоКонтрагентамПриИзменении(Элемент)
	УстановитьДоступностьПолей();
КонецПроцедуры

&НаКлиенте
Процедура РазделениеПоНоменклатуреПриИзменении(Элемент)
	УстановитьДоступностьПолей();
КонецПроцедуры

&НаКлиенте
Процедура НастроитьИсточник(Команда)
	Если ЗначениеЗаполнено(Объект.ИсточникДанныхДляФакта) Тогда
		ОткрытьФорму("Справочник.ИсточникиДанныхДляРасчетовБюджетирования.ФормаОбъекта",Новый Структура("Ключ",Объект.ИсточникДанныхДляФакта),ЭтаФорма,ЭтаФорма);		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.УчетПоСумме и НЕ ЗначениеЗаполнено(Объект.ОсновнаяВалюта) Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не выбрана валюта статьи";
		Сообщение.Поле = "Объект.ОсновнаяВалюта";
		Сообщение.УстановитьДанные(Объект);  //ЭтотОбъект  //Паша
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

