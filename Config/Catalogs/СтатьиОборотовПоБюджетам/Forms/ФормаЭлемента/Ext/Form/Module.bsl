
&НаКлиенте
Процедура ДоходыРасходыПриИзменении(Элемент)
	Объект.КоэффициентДляФактаСум = Объект.ДоходыРасходы;
КонецПроцедуры

&НаКлиенте
Процедура ИсточникДанныхДляФактаПриИзменении(Элемент)
	ЗаполнитьСписокВыборкаПоказателей();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыборкаПоказателей()
	Элементы.ПоказательИсточникаДанныхДляФактаКол.СписокВыбора.Очистить();
	Элементы.ПоказательИсточникаДанныхДляФактаСум.СписокВыбора.Очистить();
	Элементы.ПоказательИсточникаДанныхКонтрагент.СписокВыбора.Очистить();
	Элементы.ПоказательИсточникаДанныхНоменклатура.СписокВыбора.Очистить();
	
   ////// Для использования собственных отборов в статье
   ////ТекущийОбъект = ДанныеФормыВЗначение(Объект,Тип("СправочникОбъект.СтатьиОборотовПоБюджетам"));
   ////СохраненныйКомпоновщикНастроек = ТекущийОбъект.КомпоновщикНастроек.Получить();
   ////ИнициализироватьКомпоновщикСервер(СохраненныйКомпоновщикНастроек);
   //// 
    //Для использования собственных отборов в статье
	// раскоментировать если не используем собственные настройки
	ИнициализироватьКомпоновщикСервер(Неопределено);
	КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
	
	
	Для Каждого ДоступноеПоле Из КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.Элементы Цикл
		Если ДоступноеПоле.Папка Тогда
			ПродолжитЬ;
		КонецЕсли;	
		Если ДоступноеПоле.Ресурс Тогда
			Элементы.ПоказательИсточникаДанныхДляФактаКол.СписокВыбора.Добавить(Строка(ДоступноеПоле.Поле),ДоступноеПоле.Заголовок);
			Элементы.ПоказательИсточникаДанныхДляФактаСум.СписокВыбора.Добавить(Строка(ДоступноеПоле.Поле),ДоступноеПоле.Заголовок);
		Иначе	
			Элементы.ПоказательИсточникаДанныхКонтрагент.СписокВыбора.Добавить(Строка(ДоступноеПоле.Поле),ДоступноеПоле.Заголовок);
			Элементы.ПоказательИсточникаДанныхНоменклатура.СписокВыбора.Добавить(Строка(ДоступноеПоле.Поле),ДоступноеПоле.Заголовок);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщикСервер(НастройкаКомпоновки)
	//Если Не ЗначениеЗаполнено(АдресСхемыКомпоновкиДанных) Тогда
	СхемаКомпоновкиДанных = Объект.ИсточникДанныхДляФакта.СхемаИсточникаДанных.Получить();
	АдресСхемыКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных,УникальныйИдентификатор);
	//КонецЕсли;
	
	Если СхемаКомпоновкиДанных = Неопределено Тогда
		Возврат;	
	КонецЕсли;
	
	Попытка
		КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновкиДанных));
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
		УровеньЖурналаРегистрации.Ошибка,,,
		ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	
	КонецПопытки;
	
	Если НастройкаКомпоновки = Неопределено Тогда
		СхемаКомпоновкиДанных = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновкиДанных);
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	Иначе
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкаКомпоновки);
		КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	КонецЕсли;
	
КонецПроцедуры

