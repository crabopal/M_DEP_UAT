	Движение.СуммаУпр = Сумма*?(ПланированиеВТысячах,1000,1);
	Движение.ВалютнаяСумма = Сумма*?(ПланированиеВТысячах,1000,1);
	Движение.СуммаСценария = Сумма*?(ПланированиеВТысячах,1000,1);
	
