Процедура ОбработкаПроведения(Отказ, Режим)
	
	Перем Заголовок;
	СтруктураОбязательныхПолей = Новый Структура("Организация, Сценарий");
	
	//ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
	// Проведем доходы
	//Для Каждого ТекСтрока Из Доходы Цикл
	//	ЗаписатьДвижение(ТекСтрока.СтатьяБюджета, Дата, ТекСтрока.Сумма1);//БюджетныйПериод
	//КонецЦикла;
	Для Каждого ТекСтрока Из Доходы Цикл
		
		Для i = 1 По 31 Цикл 
			
			Если ТекСтрока["Сумма" + i] > 0 Тогда 	
				
				ЗаписатьДвижение(ТекСтрока.СтатьяБюджета, БюджетныйПериод + (i-1)*24*60*60, ТекСтрока["Сумма" + i]);
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	// проведем расходы
	Для Каждого ТекСтрока Из Расходы Цикл
		ЗаписатьДвижение(ТекСтрока.СтатьяБюджета, Дата, ТекСтрока.Сумма);//БюджетныйПериод
	КонецЦикла;
		
КонецПроцедуры	