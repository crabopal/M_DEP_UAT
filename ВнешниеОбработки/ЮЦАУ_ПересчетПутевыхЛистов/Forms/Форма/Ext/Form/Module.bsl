
&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Документы.Очистить();
	Результат.Очистить();
	Журнал = "";
	Таблица = Обработка().ЗаполнитьДокументы(ДатаНачала, ДатаОкончания, Водитель);
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(Документы.Добавить(), СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьИПровестиНаСервере()
	
	Пакет = Обработка().ПересчитатьИПровести(ПомеченныеСсылки());
	ПоказатьРезультат(Пакет.Результат);
	Журнал = Пакет.Журнал;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьОбратимостьНаСервере()
	
	ПоказатьРезультат(Обработка().ПроверитьОбратимость(ПомеченныеСсылки()));
	
КонецПроцедуры

&НаСервере
Функция Обработка()
	
	Возврат РеквизитФормыВЗначение("Объект");
	
КонецФункции

&НаСервере
Функция ПомеченныеСсылки()
	
	Ссылки = Новый Массив;
	Для Каждого СтрокаДокумента Из Документы Цикл
		Если СтрокаДокумента.Пометка Тогда
			Ссылки.Добавить(СтрокаДокумента.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ссылки;
	
КонецФункции

&НаСервере
Процедура ПоказатьРезультат(Таблица)
	
	Результат.Очистить();
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		ЗаполнитьЗначенияСвойств(Результат.Добавить(), СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите начало и конец периода.");
		Возврат;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИПровести(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПересчитатьИПровестиЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Пересчитать фактически отработанное время и провести помеченные путевые листы?",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьИПровестиЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПересчитатьИПровестиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбратимость(Команда)
	
	Оповещение = Новый ОписаниеОповещения("ПроверитьОбратимостьЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение,
		"Проверка проведет помеченные путевые листы внутри транзакции и отменит все изменения. Продолжить?",
		РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьОбратимостьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьОбратимостьНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьЖурнал(Команда)
	
	Если Не ЗначениеЗаполнено(Журнал) Тогда
		ПоказатьПредупреждение(, "Журнал пуст. Сначала выполните «Пересчитать и провести».");
		Возврат;
	КонецЕсли;
	
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(Журнал);
	Текст.Показать("Журнал пересчета путевых листов");
	
КонецПроцедуры
