// Пересчет фактически отработанного времени проведенных путевых листов
// по текущему хранимому значению «НовыйРасчетВремениСмены»
// и проверка, что выключение значения возвращает прежние движения.

#Область ПрограммныйИнтерфейс

// Проведенные путевые листы за период по дате документа.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Пометка, Ссылка, Дата, Номер, Организация, РучнойФОВ.
//
Функция ЗаполнитьДокументы(ДатаНачала, ДатаОкончания) Экспорт
	
	Таблица = НоваяТаблицаДокументов();
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	уатПутевойЛист.Ссылка КАК Ссылка,
	|	уатПутевойЛист.Дата КАК Дата,
	|	уатПутевойЛист.Номер КАК Номер,
	|	уатПутевойЛист.Организация КАК Организация,
	|	уатПутевойЛист.НеВыполнятьАвтоРасчетФОВ КАК РучнойФОВ
	|ИЗ
	|	Документ.уатПутевойЛист КАК уатПутевойЛист
	|ГДЕ
	|	уатПутевойЛист.Проведен
	|	И НЕ уатПутевойЛист.ПометкаУдаления
	|	И уатПутевойЛист.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Пометка = Не Выборка.РучнойФОВ;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Пересчитывает ФОВ и проводит документы по текущему хранимому значению.
// Каждый документ записывается в своей транзакции.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.уатПутевойЛист
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Документ, Этап, Регистр, Сообщение.
//
Функция ПересчитатьИПровести(Ссылки) Экспорт
	
	Результат = НоваяТаблицаРезультата();
	ТаблицаДокументов = УпорядочитьДокументы(Ссылки);
	Если ТаблицаДокументов.Количество() = 0 Тогда
		ДобавитьРезультат(Результат, Неопределено, "Пересчет", "", "Нет помеченных путевых листов.");
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Если СтрокаДокумента.РучнойФОВ Тогда
			ДобавитьРезультат(Результат, СтрокаДокумента.Ссылка, "Пересчет", "",
				"Пропущен: фактически отработанное время изменено вручную.");
			Продолжить;
		КонецЕсли;
		
		НачатьТранзакцию();
		Попытка
			ПересчитатьДокумент(СтрокаДокумента.Ссылка);
			ЗафиксироватьТранзакцию();
			ДобавитьРезультат(Результат, СтрокаДокумента.Ссылка, "Пересчет", "", "Пересчитан и проведен.");
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			ДобавитьРезультат(Результат, СтрокаДокумента.Ссылка, "Пересчет", "",
				"Ошибка, документ не изменен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// В одной транзакции включает хранимое значение, пересчитывает и проводит документы,
// выключает значение, повторяет расчет и сравнивает движения с исходными.
// Транзакция всегда отменяется.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.уатПутевойЛист
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Документ, Этап, Регистр, Сообщение.
//
Функция ПроверитьОбратимость(Ссылки) Экспорт
	
	Результат = НоваяТаблицаРезультата();
	ИсходноеЗначение = Справочники.ХранимыеЗначения.Получить("НовыйРасчетВремениСмены", Ложь);
	ДобавитьРезультат(Результат, Неопределено, "Проверка", "",
		"Исходное значение «НовыйРасчетВремениСмены»: " + Строка(ИсходноеЗначение) + ".");
	
	ТаблицаДокументов = УпорядочитьДокументы(Ссылки);
	Проверяемые = Новый Массив;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Если СтрокаДокумента.РучнойФОВ Тогда
			ДобавитьРезультат(Результат, СтрокаДокумента.Ссылка, "Проверка", "",
				"Пропущен: фактически отработанное время изменено вручную.");
		Иначе
			Проверяемые.Добавить(СтрокаДокумента.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если Проверяемые.Количество() = 0 Тогда
		ДобавитьРезультат(Результат, Неопределено, "Проверка", "", "Нет путевых листов для проверки.");
		Возврат Результат;
	КонецЕсли;
	
	Снимки = Новый Соответствие;
	Попытка
		Для Каждого Ссылка Из Проверяемые Цикл
			Снимки.Вставить(Ссылка, СнимокДокумента(Ссылка));
		КонецЦикла;
	Исключение
		ДобавитьРезультат(Результат, Неопределено, "Проверка", "",
			"Не удалось прочитать исходные движения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	НачатьТранзакцию();
	Попытка
		УстановитьНовыйРасчет(Истина);
		Для Каждого Ссылка Из Проверяемые Цикл
			ПересчитатьДокумент(Ссылка);
		КонецЦикла;
		
		Для Каждого Ссылка Из Проверяемые Цикл
			ДобавитьОтличия(Результат, Ссылка, Снимки[Ссылка], СнимокДокумента(Ссылка), "При включении");
		КонецЦикла;
		
		УстановитьНовыйРасчет(Ложь);
		Для Каждого Ссылка Из Проверяемые Цикл
			ПересчитатьДокумент(Ссылка);
		КонецЦикла;
		
		Для Каждого Ссылка Из Проверяемые Цикл
			ДобавитьОтличия(Результат, Ссылка, Снимки[Ссылка], СнимокДокумента(Ссылка), "После выключения");
		КонецЦикла;
		
		ОтменитьТранзакцию();
		ДобавитьРезультат(Результат, Неопределено, "Проверка", "",
			"Транзакция отменена. Документы, движения и хранимое значение не изменены.");
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ДобавитьРезультат(Результат, Неопределено, "Проверка", "",
			"Проверка прервана, транзакция отменена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УпорядочитьДокументы(Ссылки)
	
	Таблица = НоваяТаблицаДокументов();
	Если Ссылки.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	уатПутевойЛист.Ссылка КАК Ссылка,
	|	уатПутевойЛист.Дата КАК Дата,
	|	уатПутевойЛист.Номер КАК Номер,
	|	уатПутевойЛист.Организация КАК Организация,
	|	уатПутевойЛист.НеВыполнятьАвтоРасчетФОВ КАК РучнойФОВ
	|ИЗ
	|	Документ.уатПутевойЛист КАК уатПутевойЛист
	|ГДЕ
	|	уатПутевойЛист.Ссылка В (&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура ПересчитатьДокумент(Ссылка)
	
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ДокументОбъект.РасчетФОВ(Истина);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура УстановитьНовыйРасчет(Включено)
	
	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Элемент = ЭлементХранимогоЗначения();
		Элемент.ПометкаУдаления = Ложь;
		Элемент.Значение = Включено;
		Элемент.Записать();
	Исключение
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭлементХранимогоЗначения()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", "НовыйРасчетВремениСмены");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХранимыеЗначения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ХранимыеЗначения КАК ХранимыеЗначения
	|ГДЕ
	|	ХранимыеЗначения.Наименование = &Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХранимыеЗначения.ПометкаУдаления,
	|	ХранимыеЗначения.Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Элемент = Справочники.ХранимыеЗначения.СоздатьЭлемент();
	Элемент.Наименование = "НовыйРасчетВремениСмены";
	Возврат Элемент;
	
КонецФункции

Функция СнимокДокумента(Ссылка)
	
	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Снимок = Новый Структура;
		Снимок.Вставить("ФОВ", ПредставлениеФОВ(Ссылка));
		Снимок.Вставить("Движения", ПредставлениеДвижений(Ссылка));
	Исключение
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Снимок;
	
КонецФункции

Функция ПредставлениеФОВ(Ссылка)
	
	Строки = Новый Массив;
	Для Каждого СтрокаФОВ Из Ссылка.ФактическиОтработанноеВремя Цикл
		Строки.Добавить(
			КлючЗначения(СтрокаФОВ.Сотрудник)
			+ "|" + КлючЗначения(СтрокаФОВ.Дата)
			+ "|" + КлючЗначения(СтрокаФОВ.ВремяДневное)
			+ "|" + КлючЗначения(СтрокаФОВ.ВремяНочное));
	КонецЦикла;
	
	Возврат ТекстОтсортированныхСтрок(Строки);
	
КонецФункции

Функция ПредставлениеДвижений(Ссылка)
	
	Движения = Новый Соответствие;
	Для Каждого МетаданныеРегистра Из Метаданные.Документы.уатПутевойЛист.Движения Цикл
		Набор = СоздатьНаборЗаписей(МетаданныеРегистра);
		Набор.Отбор.Регистратор.Установить(Ссылка);
		Набор.Прочитать();
		Движения.Вставить(МетаданныеРегистра.Имя, ПредставлениеНабора(Набор, МетаданныеРегистра));
	КонецЦикла;
	
	Возврат Движения;
	
КонецФункции

Функция СоздатьНаборЗаписей(МетаданныеРегистра)
	
	Части = СтрРазделить(МетаданныеРегистра.ПолноеИмя(), ".");
	Вид = Части[0];
	Имя = Части[1];
	Если Вид = "РегистрНакопления" Тогда
		Возврат РегистрыНакопления[Имя].СоздатьНаборЗаписей();
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Возврат РегистрыСведений[Имя].СоздатьНаборЗаписей();
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Возврат РегистрыРасчета[Имя].СоздатьНаборЗаписей();
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Возврат РегистрыБухгалтерии[Имя].СоздатьНаборЗаписей();
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный вид регистра: " + МетаданныеРегистра.ПолноеИмя();
	
КонецФункции

Функция ПредставлениеНабора(Набор, МетаданныеРегистра)
	
	ИменаПолей = ИменаПолейРегистра(МетаданныеРегистра);
	Строки = Новый Массив;
	Для Каждого Запись Из Набор Цикл
		Части = Новый Массив;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Части.Добавить(ИмяПоля + "=" + КлючЗначения(Запись[ИмяПоля]));
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Части, ";"));
	КонецЦикла;
	
	Возврат ТекстОтсортированныхСтрок(Строки);
	
КонецФункции

Функция ИменаПолейРегистра(МетаданныеРегистра)
	
	Пропустить = Новый Соответствие;
	Пропустить.Вставить("Регистратор", Истина);
	Пропустить.Вставить("НомерСтроки", Истина);
	Пропустить.Вставить("МоментВремени", Истина);
	
	Имена = Новый Массив;
	Для Каждого СтандартныйРеквизит Из МетаданныеРегистра.СтандартныеРеквизиты Цикл
		Если Пропустить[СтандартныйРеквизит.Имя] = Неопределено Тогда
			Имена.Добавить(СтандартныйРеквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьИменаКоллекции(Имена, МетаданныеРегистра.Измерения);
	ДобавитьИменаКоллекции(Имена, МетаданныеРегистра.Ресурсы);
	ДобавитьИменаКоллекции(Имена, МетаданныеРегистра.Реквизиты);
	
	Возврат Имена;
	
КонецФункции

Процедура ДобавитьИменаКоллекции(Имена, Коллекция)
	
	Для Каждого Поле Из Коллекция Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	
КонецПроцедуры

Функция КлючЗначения(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(Значение);
	
КонецФункции

Функция ТекстОтсортированныхСтрок(Строки)
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Строки);
	Список.СортироватьПоЗначению();
	
	Отсортированные = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Отсортированные.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Возврат СтрСоединить(Отсортированные, Символы.ПС);
	
КонецФункции

Процедура ДобавитьОтличия(Результат, Ссылка, СнимокДо, СнимокПосле, Этап)
	
	ЕстьОтличия = Ложь;
	Если СнимокДо.ФОВ <> СнимокПосле.ФОВ Тогда
		ЕстьОтличия = Истина;
		ДобавитьРезультат(Результат, Ссылка, Этап, "ФактическиОтработанноеВремя",
			ТекстОтличия(СнимокДо.ФОВ, СнимокПосле.ФОВ));
	КонецЕсли;
	
	ИменаРегистров = Новый СписокЗначений;
	Для Каждого Элемент Из СнимокДо.Движения Цикл
		ИменаРегистров.Добавить(Элемент.Ключ);
	КонецЦикла;
	ИменаРегистров.СортироватьПоЗначению();
	
	Для Каждого ЭлементИмени Из ИменаРегистров Цикл
		ИмяРегистра = ЭлементИмени.Значение;
		ТекстДо = СнимокДо.Движения[ИмяРегистра];
		ТекстПосле = СнимокПосле.Движения[ИмяРегистра];
		Если ТекстДо <> ТекстПосле Тогда
			ЕстьОтличия = Истина;
			ДобавитьРезультат(Результат, Ссылка, Этап, ИмяРегистра, ТекстОтличия(ТекстДо, ТекстПосле));
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьОтличия Тогда
		Если Этап = "При включении" Тогда
			Текст = "Включение не изменило ФОВ и движения.";
		Иначе
			Текст = "После выключения ФОВ и движения совпали с исходными.";
		КонецЕсли;
		ДобавитьРезультат(Результат, Ссылка, Этап, "", Текст);
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстОтличия(ТекстДо, ТекстПосле)
	
	КоличествоДо = КоличествоСтрокТекста(ТекстДо);
	КоличествоПосле = КоличествоСтрокТекста(ТекстПосле);
	Возврат "Строк было " + Формат(КоличествоДо, "ЧГ=0") + ", стало " + Формат(КоличествоПосле, "ЧГ=0") + ".";
	
КонецФункции

Функция КоличествоСтрокТекста(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат СтрРазделить(Текст, Символы.ПС, Ложь).Количество();
	
КонецФункции

Функция НоваяТаблицаДокументов()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.уатПутевойЛист"));
	Таблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("РучнойФОВ", Новый ОписаниеТипов("Булево"));
	Возврат Таблица;
	
КонецФункции

Функция НоваяТаблицаРезультата()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.уатПутевойЛист"));
	Таблица.Колонки.Добавить("Этап", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50)));
	Таблица.Колонки.Добавить("Регистр", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)));
	Таблица.Колонки.Добавить("Сообщение", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(1024)));
	Возврат Таблица;
	
КонецФункции

Процедура ДобавитьРезультат(Результат, Документ, Этап, Регистр, Сообщение)
	
	Строка = Результат.Добавить();
	Строка.Документ = Документ;
	Строка.Этап = Этап;
	Строка.Регистр = Регистр;
	Строка.Сообщение = Сообщение;
	
КонецПроцедуры

#КонецОбласти
