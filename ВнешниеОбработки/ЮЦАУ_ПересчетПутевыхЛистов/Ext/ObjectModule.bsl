// Пересчет фактически отработанного времени проведенных путевых листов
// по текущему хранимому значению «НовыйРасчетВремениСмены»
// и проверка, что выключение значения возвращает прежние движения.

#Область ПрограммныйИнтерфейс

// Проведенные путевые листы за период по дате документа.
// Пустой водитель не ограничивает отбор. Заполненный оставляет документы,
// у которых Водитель1 совпадает с указанным сотрудником.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Пометка, Ссылка, Дата, Номер, Организация, Водитель, РучнойФОВ.
//
Функция ЗаполнитьДокументы(ДатаНачала, ДатаОкончания, Водитель = Неопределено) Экспорт
	
	Таблица = НоваяТаблицаДокументов();
	Если Не ЗначениеЗаполнено(ДатаНачала) Или Не ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ДатаОкончания));
	Запрос.УстановитьПараметр("Водитель", Водитель);
	Запрос.УстановитьПараметр("ОтбиратьПоВодителю", ЗначениеЗаполнено(Водитель));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	уатПутевойЛист.Ссылка КАК Ссылка,
	|	уатПутевойЛист.Дата КАК Дата,
	|	уатПутевойЛист.Номер КАК Номер,
	|	уатПутевойЛист.Организация КАК Организация,
	|	уатПутевойЛист.Водитель1 КАК Водитель,
	|	уатПутевойЛист.НеВыполнятьАвтоРасчетФОВ КАК РучнойФОВ
	|ИЗ
	|	Документ.уатПутевойЛист КАК уатПутевойЛист
	|ГДЕ
	|	уатПутевойЛист.Проведен
	|	И НЕ уатПутевойЛист.ПометкаУдаления
	|	И уатПутевойЛист.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И (НЕ &ОтбиратьПоВодителю
	|		ИЛИ уатПутевойЛист.Водитель1 = &Водитель)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(Строка, Выборка);
		Строка.Пометка = Не Выборка.РучнойФОВ;
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

// Пересчитывает ФОВ и проводит документы по текущему хранимому значению.
// Каждый документ записывается в своей транзакции.
// Журнал фиксирует условия, строки ФОВ и регистр рабочего времени до и после.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.уатПутевойЛист
//
// Возвращаемое значение:
//  Структура - Результат (таблица колонок Документ, Этап, Регистр, Сообщение) и Журнал (строка).
//
Функция ПересчитатьИПровести(Ссылки) Экспорт
	
	Журнал = Новый Массив;
	Результат = НоваяТаблицаРезультата();
	Счетчики = Новый Структура("Всего, Совпало, БезИзменений, Изменилось, НеСовпало, Ошибки, Пропущено", 0, 0, 0, 0, 0, 0, 0);
	
	ДобавитьСтрокуЖурнала(Журнал, "=== Пересчет и проведение " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT") + " ===");
	ДобавитьСтрокуЖурнала(Журнал,
		"Числа дневного и ночного времени и продолжительность РасчетВремени приведены в секундах, как их записывает расчет.");
	ДобавитьСтрокуЖурнала(Журнал, "Часы режима работы ТС, настройки обеда организации и расчет менеджера документа пишутся рядом с типовым РасчетВремени.");
	ДобавитьСтрокуЖурнала(Журнал, ТекстРасширенияДоработки());
	ДобавитьСтрокуЖурнала(Журнал, ТекстПраваПересчетаИтогов());
	
	ОписаниеВключения = ОписаниеХранимогоЗначения();
	ДобавитьСтрокуЖурнала(Журнал, ОписаниеВключения.Текст);
	
	ТаблицаДокументов = УпорядочитьДокументы(Ссылки);
	Если ТаблицаДокументов.Количество() = 0 Тогда
		ДобавитьСтрокуЖурнала(Журнал, "Нет помеченных путевых листов.");
		ДобавитьРезультат(Результат, Неопределено, "Пересчет", "", "Нет помеченных путевых листов.");
		Возврат ПакетПересчета(Результат, Журнал);
	КонецЕсли;
	
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Счетчики.Всего = Счетчики.Всего + 1;
		Если СтрокаДокумента.РучнойФОВ Тогда
			Счетчики.Пропущено = Счетчики.Пропущено + 1;
			ТекстПропуска = "Пропущен: фактически отработанное время изменено вручную.";
			ДобавитьСтрокуЖурнала(Журнал, "");
			ДобавитьСтрокуЖурнала(Журнал, "--- " + Строка(СтрокаДокумента.Ссылка) + " ---");
			ДобавитьСтрокуЖурнала(Журнал, ТекстПропуска);
			ДобавитьРезультат(Результат, СтрокаДокумента.Ссылка, "Итог", "ФОВ", ТекстПропуска);
			Продолжить;
		КонецЕсли;
		
		Попытка
			РазобратьПересчетДокумента(СтрокаДокумента.Ссылка, ОписаниеВключения, Результат, Журнал, Счетчики);
		Исключение
			Счетчики.Ошибки = Счетчики.Ошибки + 1;
			Информация = ИнформацияОбОшибке();
			ДобавитьСтрокуЖурнала(Журнал, "ОШИБКА");
			ДобавитьСтрокуЖурнала(Журнал, ПодробноеПредставлениеОшибки(Информация));
			ДобавитьРезультат(Результат, СтрокаДокумента.Ссылка, "Итог", "ФОВ",
				Лев("Ошибка журнала: " + КраткоеПредставлениеОшибки(Информация), 1000));
		КонецПопытки;
	КонецЦикла;
	
	ТекстИтога = "Итог. Документов: " + Формат(Счетчики.Всего, "ЧН=0; ЧГ=0")
		+ "; совпало: " + Формат(Счетчики.Совпало, "ЧН=0; ЧГ=0")
		+ "; без изменений: " + Формат(Счетчики.БезИзменений, "ЧН=0; ЧГ=0")
		+ "; изменилось без свертки: " + Формат(Счетчики.Изменилось, "ЧН=0; ЧГ=0")
		+ "; не совпало: " + Формат(Счетчики.НеСовпало, "ЧН=0; ЧГ=0")
		+ "; пропущено: " + Формат(Счетчики.Пропущено, "ЧН=0; ЧГ=0")
		+ "; ошибок: " + Формат(Счетчики.Ошибки, "ЧН=0; ЧГ=0") + ".";
	ДобавитьСтрокуЖурнала(Журнал, "");
	ДобавитьСтрокуЖурнала(Журнал, "=== " + ТекстИтога);
	ДобавитьРезультат(Результат, Неопределено, "Итог", "", ТекстИтога);
	
	Возврат ПакетПересчета(Результат, Журнал);
	
КонецФункции

// В одной транзакции включает хранимое значение, пересчитывает и проводит документы,
// выключает значение, повторяет расчет и сравнивает движения с исходными.
// Транзакция всегда отменяется.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.уатПутевойЛист
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Документ, Этап, Регистр, Сообщение.
//
Функция ПроверитьОбратимость(Ссылки) Экспорт
	
	Результат = НоваяТаблицаРезультата();
	ИсходноеЗначение = Справочники.Бит_ХранимыеЗначения.Получить("НовыйРасчетВремениСмены", Ложь);
	ДобавитьРезультат(Результат, Неопределено, "Проверка", "",
		"Исходное значение «НовыйРасчетВремениСмены»: " + Строка(ИсходноеЗначение) + ".");
	
	ТаблицаДокументов = УпорядочитьДокументы(Ссылки);
	Проверяемые = Новый Массив;
	Для Каждого СтрокаДокумента Из ТаблицаДокументов Цикл
		Если СтрокаДокумента.РучнойФОВ Тогда
			ДобавитьРезультат(Результат, СтрокаДокумента.Ссылка, "Проверка", "",
				"Пропущен: фактически отработанное время изменено вручную.");
		Иначе
			Проверяемые.Добавить(СтрокаДокумента.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если Проверяемые.Количество() = 0 Тогда
		ДобавитьРезультат(Результат, Неопределено, "Проверка", "", "Нет путевых листов для проверки.");
		Возврат Результат;
	КонецЕсли;
	
	Снимки = Новый Соответствие;
	Попытка
		Для Каждого Ссылка Из Проверяемые Цикл
			Снимки.Вставить(Ссылка, СнимокДокумента(Ссылка));
		КонецЦикла;
	Исключение
		ДобавитьРезультат(Результат, Неопределено, "Проверка", "",
			"Не удалось прочитать исходные движения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Результат;
	КонецПопытки;
	
	НачатьТранзакцию();
	Попытка
		УстановитьНовыйРасчет(Истина);
		Для Каждого Ссылка Из Проверяемые Цикл
			ПересчитатьДокумент(Ссылка);
		КонецЦикла;
		
		Для Каждого Ссылка Из Проверяемые Цикл
			ДобавитьОтличия(Результат, Ссылка, Снимки[Ссылка], СнимокДокумента(Ссылка), "При включении");
		КонецЦикла;
		
		УстановитьНовыйРасчет(Ложь);
		Для Каждого Ссылка Из Проверяемые Цикл
			ПересчитатьДокумент(Ссылка);
		КонецЦикла;
		
		Для Каждого Ссылка Из Проверяемые Цикл
			ДобавитьОтличия(Результат, Ссылка, Снимки[Ссылка], СнимокДокумента(Ссылка), "После выключения");
		КонецЦикла;
		
		ОтменитьТранзакцию();
		ДобавитьРезультат(Результат, Неопределено, "Проверка", "",
			"Транзакция отменена. Документы, движения и хранимое значение не изменены.");
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ДобавитьРезультат(Результат, Неопределено, "Проверка", "",
			"Проверка прервана, транзакция отменена: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция УпорядочитьДокументы(Ссылки)
	
	Таблица = НоваяТаблицаДокументов();
	Если Ссылки.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	уатПутевойЛист.Ссылка КАК Ссылка,
	|	уатПутевойЛист.Дата КАК Дата,
	|	уатПутевойЛист.Номер КАК Номер,
	|	уатПутевойЛист.Организация КАК Организация,
	|	уатПутевойЛист.НеВыполнятьАвтоРасчетФОВ КАК РучнойФОВ
	|ИЗ
	|	Документ.уатПутевойЛист КАК уатПутевойЛист
	|ГДЕ
	|	уатПутевойЛист.Ссылка В (&Ссылки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура ПересчитатьДокумент(Ссылка)
	
	ДокументОбъект = Ссылка.ПолучитьОбъект();
	ДокументОбъект.РасчетФОВ(Истина);
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры

Процедура УстановитьНовыйРасчет(Включено)
	
	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Элемент = ЭлементХранимогоЗначения();
		Элемент.ПометкаУдаления = Ложь;
		Элемент.Значение = Включено;
		Элемент.Записать();
	Исключение
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Функция ЭлементХранимогоЗначения()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Наименование", "НовыйРасчетВремениСмены");
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ХранимыеЗначения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Бит_ХранимыеЗначения КАК ХранимыеЗначения
	|ГДЕ
	|	ХранимыеЗначения.Наименование = &Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ХранимыеЗначения.ПометкаУдаления,
	|	ХранимыеЗначения.Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	
	Элемент = Справочники.Бит_ХранимыеЗначения.СоздатьЭлемент();
	Элемент.Наименование = "НовыйРасчетВремениСмены";
	Возврат Элемент;
	
КонецФункции

Функция СнимокДокумента(Ссылка)
	
	ПривилегированныйРежимБылУстановлен = ПривилегированныйРежим();
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Попытка
		Снимок = Новый Структура;
		Снимок.Вставить("ФОВ", ПредставлениеФОВ(Ссылка));
		Снимок.Вставить("Движения", ПредставлениеДвижений(Ссылка));
	Исключение
		Если Не ПривилегированныйРежимБылУстановлен Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	
	Если Не ПривилегированныйРежимБылУстановлен Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
	Возврат Снимок;
	
КонецФункции

Функция ПредставлениеФОВ(Ссылка)
	
	Строки = Новый Массив;
	Для Каждого СтрокаФОВ Из Ссылка.ФактическиОтработанноеВремя Цикл
		Строки.Добавить(
			КлючЗначения(СтрокаФОВ.Сотрудник)
			+ "|" + КлючЗначения(СтрокаФОВ.Дата)
			+ "|" + КлючЗначения(СтрокаФОВ.ВремяДневное)
			+ "|" + КлючЗначения(СтрокаФОВ.ВремяНочное));
	КонецЦикла;
	
	Возврат ТекстОтсортированныхСтрок(Строки);
	
КонецФункции

Функция ПредставлениеДвижений(Ссылка)
	
	Движения = Новый Соответствие;
	Для Каждого МетаданныеРегистра Из Метаданные.Документы.уатПутевойЛист.Движения Цикл
		Набор = СоздатьНаборЗаписей(МетаданныеРегистра);
		Набор.Отбор.Регистратор.Установить(Ссылка);
		Набор.Прочитать();
		Движения.Вставить(МетаданныеРегистра.Имя, ПредставлениеНабора(Набор, МетаданныеРегистра));
	КонецЦикла;
	
	Возврат Движения;
	
КонецФункции

Функция СоздатьНаборЗаписей(МетаданныеРегистра)
	
	Части = СтрРазделить(МетаданныеРегистра.ПолноеИмя(), ".");
	Вид = Части[0];
	Имя = Части[1];
	Если Вид = "РегистрНакопления" Тогда
		Возврат РегистрыНакопления[Имя].СоздатьНаборЗаписей();
	ИначеЕсли Вид = "РегистрСведений" Тогда
		Возврат РегистрыСведений[Имя].СоздатьНаборЗаписей();
	ИначеЕсли Вид = "РегистрРасчета" Тогда
		Возврат РегистрыРасчета[Имя].СоздатьНаборЗаписей();
	ИначеЕсли Вид = "РегистрБухгалтерии" Тогда
		Возврат РегистрыБухгалтерии[Имя].СоздатьНаборЗаписей();
	КонецЕсли;
	
	ВызватьИсключение "Неизвестный вид регистра: " + МетаданныеРегистра.ПолноеИмя();
	
КонецФункции

Функция ПредставлениеНабора(Набор, МетаданныеРегистра)
	
	ИменаПолей = ИменаПолейРегистра(МетаданныеРегистра);
	Строки = Новый Массив;
	Для Каждого Запись Из Набор Цикл
		Части = Новый Массив;
		Для Каждого ИмяПоля Из ИменаПолей Цикл
			Части.Добавить(ИмяПоля + "=" + КлючЗначения(Запись[ИмяПоля]));
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Части, ";"));
	КонецЦикла;
	
	Возврат ТекстОтсортированныхСтрок(Строки);
	
КонецФункции

Функция ИменаПолейРегистра(МетаданныеРегистра)
	
	Пропустить = Новый Соответствие;
	Пропустить.Вставить("Регистратор", Истина);
	Пропустить.Вставить("НомерСтроки", Истина);
	Пропустить.Вставить("МоментВремени", Истина);
	
	Имена = Новый Массив;
	Для Каждого СтандартныйРеквизит Из МетаданныеРегистра.СтандартныеРеквизиты Цикл
		Если Пропустить[СтандартныйРеквизит.Имя] = Неопределено Тогда
			Имена.Добавить(СтандартныйРеквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ДобавитьИменаКоллекции(Имена, МетаданныеРегистра.Измерения);
	ДобавитьИменаКоллекции(Имена, МетаданныеРегистра.Ресурсы);
	ДобавитьИменаКоллекции(Имена, МетаданныеРегистра.Реквизиты);
	
	Возврат Имена;
	
КонецФункции

Процедура ДобавитьИменаКоллекции(Имена, Коллекция)
	
	Для Каждого Поле Из Коллекция Цикл
		Имена.Добавить(Поле.Имя);
	КонецЦикла;
	
КонецПроцедуры

Функция КлючЗначения(Значение)
	
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат XMLСтрока(Значение);
	
КонецФункции

Функция ТекстОтсортированныхСтрок(Строки)
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Строки);
	Список.СортироватьПоЗначению();
	
	Отсортированные = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Отсортированные.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Возврат СтрСоединить(Отсортированные, Символы.ПС);
	
КонецФункции

Процедура ДобавитьОтличия(Результат, Ссылка, СнимокДо, СнимокПосле, Этап)
	
	ЕстьОтличия = Ложь;
	Если СнимокДо.ФОВ <> СнимокПосле.ФОВ Тогда
		ЕстьОтличия = Истина;
		ДобавитьРезультат(Результат, Ссылка, Этап, "ФактическиОтработанноеВремя",
			ТекстОтличия(СнимокДо.ФОВ, СнимокПосле.ФОВ));
	КонецЕсли;
	
	ИменаРегистров = Новый СписокЗначений;
	Для Каждого Элемент Из СнимокДо.Движения Цикл
		ИменаРегистров.Добавить(Элемент.Ключ);
	КонецЦикла;
	ИменаРегистров.СортироватьПоЗначению();
	
	Для Каждого ЭлементИмени Из ИменаРегистров Цикл
		ИмяРегистра = ЭлементИмени.Значение;
		ТекстДо = СнимокДо.Движения[ИмяРегистра];
		ТекстПосле = СнимокПосле.Движения[ИмяРегистра];
		Если ТекстДо <> ТекстПосле Тогда
			ЕстьОтличия = Истина;
			ДобавитьРезультат(Результат, Ссылка, Этап, ИмяРегистра, ТекстОтличия(ТекстДо, ТекстПосле));
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьОтличия Тогда
		Если Этап = "При включении" Тогда
			Текст = "Включение не изменило ФОВ и движения.";
		Иначе
			Текст = "После выключения ФОВ и движения совпали с исходными.";
		КонецЕсли;
		ДобавитьРезультат(Результат, Ссылка, Этап, "", Текст);
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстОтличия(ТекстДо, ТекстПосле)
	
	КоличествоДо = КоличествоСтрокТекста(ТекстДо);
	КоличествоПосле = КоличествоСтрокТекста(ТекстПосле);
	Возврат "Строк было " + Формат(КоличествоДо, "ЧН=0; ЧГ=0") + ", стало " + Формат(КоличествоПосле, "ЧН=0; ЧГ=0") + ".";
	
КонецФункции

Функция КоличествоСтрокТекста(Текст)
	
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат 0;
	КонецЕсли;
	
	Возврат СтрРазделить(Текст, Символы.ПС, Ложь).Количество();
	
КонецФункции

Функция ПакетПересчета(Результат, Журнал)
	
	Возврат Новый Структура("Результат, Журнал", Результат, СтрСоединить(Журнал, Символы.ПС));
	
КонецФункции

Процедура ДобавитьСтрокуЖурнала(Журнал, Текст)
	
	Журнал.Добавить(Текст);
	
КонецПроцедуры

Процедура РазобратьПересчетДокумента(Ссылка, ОписаниеВключения, Результат, Журнал, Счетчики)
	
	ДобавитьСтрокуЖурнала(Журнал, "");
	ДобавитьСтрокуЖурнала(Журнал, "--- " + Строка(Ссылка) + " | " + XMLСтрока(Ссылка) + " ---");
	
	Контекст = ПрочитатьКонтекстДокумента(Ссылка);
	ДобавитьСтрокуЖурнала(Журнал, Контекст.Текст);
	
	Ожидание = ОжидаемоеСостояниеФОВ(Контекст, ОписаниеВключения.Включено);
	ДобавитьСтрокуЖурнала(Журнал, "Ожидание: " + Ожидание.Текст);
	ДобавитьРасшифровкуРасчета(Ссылка, Журнал);
	
	ФОВДо = ОписаниеКоллекцииФОВ(ПрочитатьФОВ(Ссылка));
	РегистрДо = ОписаниеРабочегоВремени(ПрочитатьРабочееВремя(Ссылка));
	ДобавитьСтрокуЖурнала(Журнал, "ФОВ до: " + ФОВДо.Сводка);
	ДобавитьСтрокуЖурнала(Журнал, ФОВДо.Текст);
	ДобавитьСтрокуЖурнала(Журнал, "Регистр уатРабочееВремяСотрудников до: " + РегистрДо.Сводка);
	ДобавитьСтрокуЖурнала(Журнал, РегистрДо.Текст);
	
	КлючПамяти = "";
	Записан = Ложь;
	ТекстОшибки = "";
	КраткоОшибки = "";
	
	НачатьТранзакцию();
	Попытка
		ДокументОбъект = Ссылка.ПолучитьОбъект();
		ДокументОбъект.РасчетФОВ(Истина);
		Память = ОписаниеКоллекцииФОВ(ДокументОбъект.ФактическиОтработанноеВремя);
		ТекстПамяти = Память.Текст;
		КлючПамяти = Память.Ключ;
		ДобавитьСтрокуЖурнала(Журнал, "ФОВ после РасчетФОВ, до записи: " + Память.Сводка);
		ДобавитьСтрокуЖурнала(Журнал, ТекстПамяти);
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
		Записан = Истина;
	Исключение
		Информация = ИнформацияОбОшибке();
		ТекстОшибки = ПодробноеПредставлениеОшибки(Информация);
		КраткоОшибки = КраткоеПредставлениеОшибки(Информация);
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	КонецПопытки;
	
	Если Не Записан Тогда
		Счетчики.Ошибки = Счетчики.Ошибки + 1;
		Кратко = "Ошибка, документ не изменен: " + КраткоОшибки;
		Если ЗначениеЗаполнено(ТекстОшибки) Тогда
			ДобавитьСтрокуЖурнала(Журнал, "ОШИБКА");
			ДобавитьСтрокуЖурнала(Журнал, ТекстОшибки);
		КонецЕсли;
		ДобавитьРезультат(Результат, Ссылка, "Итог", "ФОВ", Лев(Кратко, 1000));
		Возврат;
	КонецЕсли;
	
	ФОВПосле = ОписаниеКоллекцииФОВ(ПрочитатьФОВ(Ссылка));
	РегистрПосле = ОписаниеРабочегоВремени(ПрочитатьРабочееВремя(Ссылка));
	ДобавитьСтрокуЖурнала(Журнал, "ФОВ в базе после проведения: " + ФОВПосле.Сводка);
	ДобавитьСтрокуЖурнала(Журнал, ФОВПосле.Текст);
	ДобавитьСтрокуЖурнала(Журнал, "Регистр уатРабочееВремяСотрудников после: " + РегистрПосле.Сводка);
	ДобавитьСтрокуЖурнала(Журнал, РегистрПосле.Текст);
	
	Если КлючПамяти <> ФОВПосле.Ключ Тогда
		ДобавитьСтрокуЖурнала(Журнал,
			"После записи ФОВ отличается от результата РасчетФОВ. ПередЗаписью мог повторно пересчитать документ.");
	КонецЕсли;
	
	ВердиктФОВ = ВердиктФОВ(Ожидание, ФОВДо, ФОВПосле, КлючПамяти);
	ВердиктРегистра = ВердиктРегистра(Ожидание, РегистрПосле.Таблица);
	ДобавитьСтрокуЖурнала(Журнал, ВердиктФОВ);
	ДобавитьСтрокуЖурнала(Журнал, ВердиктРегистра);
	
	УвеличитьСчетчикВердикта(Счетчики, ВердиктФОВ);
	ДобавитьРезультат(Результат, Ссылка, "Итог", "ФОВ", Лев(ВердиктФОВ, 1000));
	ДобавитьРезультат(Результат, Ссылка, "Итог", "уатРабочееВремяСотрудников", Лев(ВердиктРегистра, 1000));
	
КонецПроцедуры

Процедура УвеличитьСчетчикВердикта(Счетчики, Вердикт)
	
	Если СтрНачинаетсяС(Вердикт, "СОВПАЛО") Тогда
		Счетчики.Совпало = Счетчики.Совпало + 1;
	ИначеЕсли СтрНачинаетсяС(Вердикт, "НЕ СОВПАЛО") Тогда
		Счетчики.НеСовпало = Счетчики.НеСовпало + 1;
	ИначеЕсли СтрНачинаетсяС(Вердикт, "БЕЗ ИЗМЕНЕНИЙ") Тогда
		Счетчики.БезИзменений = Счетчики.БезИзменений + 1;
	ИначеЕсли СтрНачинаетсяС(Вердикт, "ИЗМЕНИЛОСЬ") Тогда
		Счетчики.Изменилось = Счетчики.Изменилось + 1;
	Иначе
		Счетчики.Изменилось = Счетчики.Изменилось + 1;
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстРасширенияДоработки()
	
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "бит_Доработки" Тогда
				Возврат "Расширение бит_Доработки: активно " + ПредставлениеЗначенияЖурнала(Расширение.Активно)
					+ ", версия " + Расширение.Версия + ".";
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат "Расширение бит_Доработки не прочитано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Возврат "Расширение бит_Доработки не подключено к базе.";
	
КонецФункции

Функция ТекстПраваПересчетаИтогов()
	
	Попытка
		ЗначениеПрава = уатПраваИНастройки.уатПраво("ПутевойЛистПерерасчетИтоговПриПроведении", Неопределено, Ложь);
		Возврат "Право «Путевой лист - перерасчет итогов при проведении»: " + ПредставлениеЗначенияЖурнала(ЗначениеПрава) + ".";
	Исключение
		Возврат "Право пересчета итогов не прочитано: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

Функция ОписаниеХранимогоЗначения()
	
	Описание = Новый Структура("Включено, Текст", Ложь, "");
	КаталогЕсть = Метаданные.Справочники.Найти("Бит_ХранимыеЗначения") <> Неопределено;
	Если Не КаталогЕсть Тогда
		Описание.Текст = "Справочник Бит_ХранимыеЗначения в базе нет. Доработка выключена.";
		Возврат Описание;
	КонецЕсли;
	
	ЗначениеПолучить = Неопределено;
	ТекстОшибки = "";
	Попытка
		ЗначениеПолучить = Справочники.Бит_ХранимыеЗначения.Получить("НовыйРасчетВремениСмены", Ложь);
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	Описание.Включено = ТипЗнч(ЗначениеПолучить) = Тип("Булево") И ЗначениеПолучить;
	Описание.Текст = "Получить(""НовыйРасчетВремениСмены"", Ложь): тип " + Строка(ТипЗнч(ЗначениеПолучить))
		+ ", значение " + ПредставлениеЗначенияЖурнала(ЗначениеПолучить)
		+ ". Доработка " + ?(Описание.Включено, "включена", "выключена") + ".";
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Описание.Текст = Описание.Текст + " Ошибка чтения: " + ТекстОшибки;
	КонецЕсли;
	
	Элементы = ПрочитатьЭлементыХранимогоЗначения();
	Если Элементы = Неопределено Тогда
		Описание.Текст = Описание.Текст + " Список элементов не прочитан.";
	ИначеЕсли Элементы.Количество() = 0 Тогда
		Описание.Текст = Описание.Текст + " Элемента с таким наименованием нет.";
	Иначе
		Для Каждого Элемент Из Элементы Цикл
			Описание.Текст = Описание.Текст + Символы.ПС
				+ "Элемент " + Элемент.Код + ": пометка удаления " + ПредставлениеЗначенияЖурнала(Элемент.ПометкаУдаления)
				+ ", тип " + Строка(ТипЗнч(Элемент.Значение))
				+ ", значение " + ПредставлениеЗначенияЖурнала(Элемент.Значение) + ".";
		КонецЦикла;
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции

Функция ПрочитатьЭлементыХранимогоЗначения()
	
	БылУстановлен = ВключитьПривилегированныйРежимЖурнала();
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Наименование", "НовыйРасчетВремениСмены");
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ХранимыеЗначения.Код КАК Код,
		|	ХранимыеЗначения.ПометкаУдаления КАК ПометкаУдаления,
		|	ХранимыеЗначения.Значение КАК Значение
		|ИЗ
		|	Справочник.Бит_ХранимыеЗначения КАК ХранимыеЗначения
		|ГДЕ
		|	ХранимыеЗначения.Наименование = &Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПометкаУдаления,
		|	Код";
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		ВернутьПривилегированныйРежимЖурнала(БылУстановлен);
		Возврат Неопределено;
	КонецПопытки;
	
	ВернутьПривилегированныйРежимЖурнала(БылУстановлен);
	Возврат Таблица;
	
КонецФункции

Функция ПрочитатьКонтекстДокумента(Ссылка)
	
	Контекст = Новый Структура;
	Контекст.Вставить("Водитель", Справочники.Сотрудники.ПустаяСсылка());
	Контекст.Вставить("ПодразделениеЗаполнено", Ложь);
	Контекст.Вставить("Флаг", Ложь);
	Контекст.Вставить("ДатаНачала", Дата(1, 1, 1));
	Контекст.Вставить("ДатаДокумента", Дата(1, 1, 1));
	Контекст.Вставить("ДатаВыезда", Дата(1, 1, 1));
	Контекст.Вставить("ДатаВозвращения", Дата(1, 1, 1));
	Контекст.Вставить("ЧасыЗадания", 0);
	Контекст.Вставить("ЕстьСлив", Ложь);
	Контекст.Вставить("РеквизитыЕсть", Ложь);
	Контекст.Вставить("Прочитан", Ложь);
	Контекст.Вставить("Текст", "");
	
	РеквизитыЕсть = Метаданные.Справочники.ПодразделенияОрганизаций.Реквизиты.Найти("Бит_НовыйРасчетВремениСмены") <> Неопределено
		И Метаданные.Справочники.ПодразделенияОрганизаций.Реквизиты.Найти("Бит_ДатаНачалаНовогоРасчетаВремениСмены") <> Неопределено;
	Контекст.РеквизитыЕсть = РеквизитыЕсть;
	
	БылУстановлен = ВключитьПривилегированныйРежимЖурнала();
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		ТекстФлага = "ЛОЖЬ КАК Флаг, ДАТАВРЕМЯ(1, 1, 1) КАК ДатаНачала,";
		Если РеквизитыЕсть Тогда
			ТекстФлага =
			"ПЛ.Водитель1.Подразделение.Бит_НовыйРасчетВремениСмены КАК Флаг,
			|	ПЛ.Водитель1.Подразделение.Бит_ДатаНачалаНовогоРасчетаВремениСмены КАК ДатаНачала,";
		КонецЕсли;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ПЛ.Дата КАК ДатаДокумента,
		|	ПЛ.Водитель1 КАК Водитель,
		|	ПРЕДСТАВЛЕНИЕ(ПЛ.Водитель1) КАК ВодительПредставление,
		|	ПЛ.Водитель1.Подразделение КАК Подразделение,
		|	ПРЕДСТАВЛЕНИЕ(ПЛ.Водитель1.Подразделение) КАК ПодразделениеПредставление,
		|	" + ТекстФлага + "
		|	ПЛ.ДатаВыезда КАК ДатаВыезда,
		|	ПЛ.ДатаВозвращения КАК ДатаВозвращения,
		|	ПЛ.Рассчитан КАК Рассчитан,
		|	ПЛ.Водитель2 КАК Водитель2,
		|	ПЛ.Сотрудник1 КАК Сотрудник1,
		|	ПЛ.Сотрудник2 КАК Сотрудник2
		|ИЗ
		|	Документ.уатПутевойЛист КАК ПЛ
		|ГДЕ
		|	ПЛ.Ссылка = &Ссылка";
		Шапка = Запрос.Выполнить().Выбрать();
		Шапка.Следующий();
		
		ЗапросЧасов = Новый Запрос;
		ЗапросЧасов.УстановитьПараметр("Ссылка", Ссылка);
		ЗапросЧасов.Текст =
		"ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Задание.КоличествоЧасов), 0) КАК Часы
		|ИЗ
		|	Документ.уатПутевойЛист.Задание КАК Задание
		|ГДЕ
		|	Задание.Ссылка = &Ссылка";
		Часы = ЗапросЧасов.Выполнить().Выгрузить()[0].Часы;
		ЕстьСлив = ЕстьНепомеченныйСливЖурнала(Ссылка);
	Исключение
		ВернутьПривилегированныйРежимЖурнала(БылУстановлен);
		Контекст.Текст = "Контекст документа не прочитан: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Контекст;
	КонецПопытки;
	ВернутьПривилегированныйРежимЖурнала(БылУстановлен);
	
	Контекст.Водитель = Шапка.Водитель;
	Контекст.ПодразделениеЗаполнено = ЗначениеЗаполнено(Шапка.Подразделение);
	Контекст.Флаг = Шапка.Флаг = Истина;
	Контекст.ДатаНачала = Шапка.ДатаНачала;
	Контекст.ДатаДокумента = Шапка.ДатаДокумента;
	Контекст.ДатаВыезда = Шапка.ДатаВыезда;
	Контекст.ДатаВозвращения = Шапка.ДатаВозвращения;
	Контекст.ЧасыЗадания = Часы;
	Контекст.ЕстьСлив = ЕстьСлив;
	Контекст.Прочитан = Истина;
	
	Длительность = 0;
	СекундОтПолуночи = 0;
	Если ЗначениеЗаполнено(Шапка.ДатаВыезда) И ЗначениеЗаполнено(Шапка.ДатаВозвращения) Тогда
		Длительность = Шапка.ДатаВозвращения - Шапка.ДатаВыезда;
		СекундОтПолуночи = Шапка.ДатаВыезда - НачалоДня(Шапка.ДатаВыезда);
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить("Водитель 1: " + Шапка.ВодительПредставление
		+ "; подразделение: " + Шапка.ПодразделениеПредставление + ".");
	Строки.Добавить("Водитель 2: " + ПредставлениеСсылкиЖурнала(Шапка.Водитель2)
		+ "; сотрудник 1: " + ПредставлениеСсылкиЖурнала(Шапка.Сотрудник1)
		+ "; сотрудник 2: " + ПредставлениеСсылкиЖурнала(Шапка.Сотрудник2) + ".");
	Строки.Добавить("Реквизиты смены в расширении: " + ?(РеквизитыЕсть, "есть", "нет")
		+ "; флаг: " + ПредставлениеЗначенияЖурнала(Шапка.Флаг)
		+ "; дата начала: " + ФорматДатыЖурнала(Шапка.ДатаНачала)
		+ "; дата документа: " + ФорматДатыЖурнала(Шапка.ДатаДокумента) + ".");
	Строки.Добавить("Выезд: " + ФорматДатаВремяЖурнала(Шапка.ДатаВыезда)
		+ "; возврат: " + ФорматДатаВремяЖурнала(Шапка.ДатаВозвращения)
		+ "; длительность, сек: " + Формат(Длительность, "ЧН=0; ЧГ=0")
		+ "; секунд от полуночи выезда: " + Формат(СекундОтПолуночи, "ЧН=0; ЧГ=0") + ".");
	Строки.Добавить("Часы задания: " + Формат(Часы, "ЧН=0; ЧГ=0")
		+ "; непомеченный слив: " + ?(ЕстьСлив, "да", "нет")
		+ "; рассчитан: " + ПредставлениеЗначенияЖурнала(Шапка.Рассчитан) + ".");
	Контекст.Текст = СтрСоединить(Строки, Символы.ПС);
	
	Возврат Контекст;
	
КонецФункции

Функция ЕстьНепомеченныйСливЖурнала(Ссылка)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПутевойЛист", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	уатСливГСМ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.уатСливГСМ КАК уатСливГСМ
	|ГДЕ
	|	НЕ уатСливГСМ.ПометкаУдаления
	|	И (уатСливГСМ.ПутевойЛист = &ПутевойЛист
	|		ИЛИ уатСливГСМ.ПутевойЛистПриемник = &ПутевойЛист)";
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

Функция ОжидаемоеСостояниеФОВ(Контекст, ДоработкаВключена)
	
	Ожидание = Новый Структура("Режим, ДатаОтнесения, Текст", "Типовой", Дата(1, 1, 1), "");
	Если Не Контекст.Прочитан Тогда
		Ожидание.Режим = "Неизвестно";
		Ожидание.Текст = "контекст документа не прочитан, сверка с правилом пропущена.";
		Возврат Ожидание;
	КонецЕсли;
	Если Не ДоработкаВключена Тогда
		Ожидание.Режим = "Выключено";
		Ожидание.Текст = "доработка выключена, свертка и очистка при сливе не применяются.";
		Возврат Ожидание;
	КонецЕсли;
	
	Если Контекст.ЧасыЗадания = 0 И Контекст.ЕстьСлив Тогда
		Ожидание.Режим = "Очистить";
		Ожидание.Текст = "очистить ФОВ: часы задания равны нулю и есть непомеченный слив.";
		Возврат Ожидание;
	КонецЕсли;
	
	Причины = Новый Массив;
	Если Не Контекст.РеквизитыЕсть Тогда
		Причины.Добавить("нет реквизитов подразделения в расширении");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Контекст.Водитель) Тогда
		Причины.Добавить("водитель 1 не заполнен");
	КонецЕсли;
	Если ЗначениеЗаполнено(Контекст.Водитель) И Не Контекст.ПодразделениеЗаполнено Тогда
		Причины.Добавить("у водителя 1 не заполнено подразделение");
	КонецЕсли;
	Если Контекст.РеквизитыЕсть И Не Контекст.Флаг Тогда
		Причины.Добавить("флаг подразделения выключен");
	КонецЕсли;
	Если Контекст.РеквизитыЕсть И Не ЗначениеЗаполнено(Контекст.ДатаНачала) Тогда
		Причины.Добавить("дата начала нового расчета пустая");
	КонецЕсли;
	Если Контекст.РеквизитыЕсть И ЗначениеЗаполнено(Контекст.ДатаНачала)
		И ЗначениеЗаполнено(Контекст.ДатаДокумента)
		И НачалоДня(Контекст.ДатаДокумента) < НачалоДня(Контекст.ДатаНачала) Тогда
		Причины.Добавить("дата документа раньше даты начала");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Контекст.ДатаВыезда) Или Не ЗначениеЗаполнено(Контекст.ДатаВозвращения) Тогда
		Причины.Добавить("не заполнен выезд или возврат");
	Иначе
		Длительность = Контекст.ДатаВозвращения - Контекст.ДатаВыезда;
		Если Длительность < 0 Тогда
			Причины.Добавить("возврат раньше выезда");
		ИначеЕсли Длительность > 86400 Тогда
			Причины.Добавить("смена длиннее суток, остается типовая нарезка");
		КонецЕсли;
	КонецЕсли;
	
	Если Причины.Количество() = 0 Тогда
		Ожидание.Режим = "Свернуть";
		Ожидание.ДатаОтнесения = ДатаОтнесенияСмены(Контекст.ДатаВыезда);
		// +++ 1 бит ЛТ 136_00721 Балицкий В.В. 28.10.2026
		Ожидание.Текст = "свернуть строки на " + ФорматДатыЖурнала(Ожидание.ДатаОтнесения)
			+ ", " + ТекстПереносаНочныхСледующегоДня(Контекст) + ".";
		// --- 1 бит ЛТ 136_00721 Балицкий В.В. 28.10.2026
	Иначе
		Ожидание.Режим = "Типовой";
		Ожидание.Текст = "свертка не применяется: " + СтрСоединить(Причины, "; ") + ".";
	КонецЕсли;
	
	Возврат Ожидание;
	
КонецФункции


// +++ 1 бит ЛТ 136_00721 Балицкий В.В. 28.10.2026
Функция ТекстПереносаНочныхСледующегоДня(Контекст)

	ВыездРаньшеШести = Контекст.ДатаВыезда - НачалоДня(Контекст.ДатаВыезда) < 6 * 3600;
	ХвостСледующихСуток = НачалоДня(Контекст.ДатаВыезда) <> НачалоДня(Контекст.ДатаВозвращения)
		И Контекст.ДатаВозвращения - НачалоДня(Контекст.ДатаВозвращения) > 6 * 3600;
	Если ВыездРаньшеШести Или ХвостСледующихСуток Тогда
		Возврат "дневное время суток после даты смены добавляется к ночным, граница 06:00 их не режет";
	КонецЕсли;

	Возврат "дневные и ночные числа по сотруднику суммируются без пересчета";

КонецФункции
// --- 1 бит ЛТ 136_00721 Балицкий В.В. 28.10.2026

Функция ДатаОтнесенияСмены(ДатаВыезда)
	
	СекундОтПолуночи = ДатаВыезда - НачалоДня(ДатаВыезда);
	Если СекундОтПолуночи < 6 * 3600 Тогда
		Возврат НачалоДня(ДатаВыезда) - 86400;
	КонецЕсли;
	
	Возврат НачалоДня(ДатаВыезда);
	
КонецФункции

Функция ВердиктФОВ(Ожидание, ФОВДо, ФОВПосле, КлючПамяти)
	
	Изменился = ФОВДо.Ключ <> ФОВПосле.Ключ;
	ЗаписьСовпала = КлючПамяти = ФОВПосле.Ключ;
	ПрипискаЗаписи = ?(ЗаписьСовпала, "", " После записи ФОВ отличается от результата РасчетФОВ.");
	
	Если Ожидание.Режим = "Неизвестно" Тогда
		Если Изменился Тогда
			Вердикт = "ИЗМЕНИЛОСЬ: " + Ожидание.Текст;
		Иначе
			Вердикт = "БЕЗ ИЗМЕНЕНИЙ: " + Ожидание.Текст;
		КонецЕсли;
	ИначеЕсли Ожидание.Режим = "Очистить" Тогда
		Если ФОВПосле.Количество = 0 И Изменился Тогда
			Вердикт = "СОВПАЛО: ФОВ очищен.";
		ИначеЕсли ФОВПосле.Количество = 0 Тогда
			Вердикт = "БЕЗ ИЗМЕНЕНИЙ: очистка ожидалась, ФОВ и раньше был пуст.";
		Иначе
			Вердикт = "НЕ СОВПАЛО: ожидалась очистка из-за слива без часов задания, строки остались.";
		КонецЕсли;
	ИначеЕсли Ожидание.Режим = "Свернуть" Тогда
		Форма = ФормаСвертки(ФОВПосле.Коллекция, Ожидание.ДатаОтнесения);
		Если Форма.Соответствует И Изменился Тогда
			Вердикт = "СОВПАЛО: строки собраны на " + ФорматДатыЖурнала(Ожидание.ДатаОтнесения) + ".";
		ИначеЕсли Форма.Соответствует Тогда
			Вердикт = "БЕЗ ИЗМЕНЕНИЙ: свертка ожидалась, строки уже были на "
				+ ФорматДатыЖурнала(Ожидание.ДатаОтнесения) + ".";
		Иначе
			Вердикт = "НЕ СОВПАЛО: свертка на " + ФорматДатыЖурнала(Ожидание.ДатаОтнесения)
				+ " не получилась. " + Форма.Причина + ".";
		КонецЕсли;
	ИначеЕсли Изменился Тогда
		Вердикт = "ИЗМЕНИЛОСЬ: строки изменил типовой пересчет. " + Ожидание.Текст;
	Иначе
		Вердикт = "БЕЗ ИЗМЕНЕНИЙ: " + Ожидание.Текст;
	КонецЕсли;
	
	Возврат Вердикт + ПрипискаЗаписи;
	
КонецФункции

Функция ФормаСвертки(Коллекция, ДатаОтнесения)
	
	Проверка = Новый Структура("Соответствует, Причина", Истина, "");
	Если Коллекция.Количество() = 0 Тогда
		Проверка.Соответствует = Ложь;
		Проверка.Причина = "после расчета строк нет";
		Возврат Проверка;
	КонецЕсли;
	
	Сотрудники = Новый Соответствие;
	Для Каждого СтрокаФОВ Из Коллекция Цикл
		Если НачалоДня(СтрокаФОВ.Дата) <> НачалоДня(ДатаОтнесения) Тогда
			Проверка.Соответствует = Ложь;
			Проверка.Причина = "есть дата " + ФорматДатыЖурнала(СтрокаФОВ.Дата)
				+ ", ожидалась " + ФорматДатыЖурнала(ДатаОтнесения);
			Возврат Проверка;
		КонецЕсли;
		Если СтрокаФОВ.ВремяДневное = 0 И СтрокаФОВ.ВремяНочное = 0 Тогда
			Проверка.Соответствует = Ложь;
			Проверка.Причина = "есть строка с нулевым дневным и ночным временем";
			Возврат Проверка;
		КонецЕсли;
		КлючСотрудника = XMLСтрока(СтрокаФОВ.Сотрудник);
		Если Сотрудники[КлючСотрудника] <> Неопределено Тогда
			Проверка.Соответствует = Ложь;
			Проверка.Причина = "несколько строк сотрудника " + Строка(СтрокаФОВ.Сотрудник);
			Возврат Проверка;
		КонецЕсли;
		Сотрудники.Вставить(КлючСотрудника, Истина);
	КонецЦикла;
	
	Возврат Проверка;
	
КонецФункции

Функция ВердиктРегистра(Ожидание, Таблица)
	
	Если Таблица = Неопределено Тогда
		Возврат "Регистр уатРабочееВремяСотрудников не прочитан.";
	КонецЕсли;
	
	Виды = ВидыВремениИзФОВ();
	Если Виды.Количество() = 0 Тогда
		Возврат "Виды явки и ночных не сопоставлены. Записей регистра: " + Формат(Таблица.Количество(), "ЧН=0; ЧГ=0") + ".";
	КонецЕсли;
	
	СтрокФОВ = 0;
	ЧужиеДаты = Новый Массив;
	Для Каждого СтрокаРегистра Из Таблица Цикл
		Если Виды[СтрокаРегистра.Вид] = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтрокФОВ = СтрокФОВ + 1;
		Если Ожидание.Режим = "Свернуть" И НачалоДня(СтрокаРегистра.ДатаРаботы) <> НачалоДня(Ожидание.ДатаОтнесения) Тогда
			ЧужиеДаты.Добавить(ФорматДатыЖурнала(СтрокаРегистра.ДатаРаботы) + " " + Строка(СтрокаРегистра.Вид));
		КонецЕсли;
	КонецЦикла;
	
	Если Ожидание.Режим = "Очистить" И СтрокФОВ > 0 Тогда
		Возврат "НЕ СОВПАЛО: в регистре остались явка, праздники или ночные, строк " + Формат(СтрокФОВ, "ЧН=0; ЧГ=0") + ".";
	ИначеЕсли Ожидание.Режим = "Очистить" Тогда
		Возврат "СОВПАЛО: в регистре нет явки и ночных по этому путевому.";
	ИначеЕсли Ожидание.Режим = "Свернуть" И ЧужиеДаты.Количество() > 0 Тогда
		Возврат "НЕ СОВПАЛО: строки регистра не на дате смены: " + СтрСоединить(ЧужиеДаты, "; ") + ".";
	ИначеЕсли Ожидание.Режим = "Свернуть" И СтрокФОВ = 0 Тогда
		Возврат "РЕГИСТР ПУСТ: нет явки, работы или ночных. Табель из этого путевого часов не получит.";
	ИначеЕсли Ожидание.Режим = "Свернуть" Тогда
		Возврат "СОВПАЛО: строки регистра на дате смены, строк " + Формат(СтрокФОВ, "ЧН=0; ЧГ=0") + ".";
	КонецЕсли;
	
	Возврат "Сверка дат регистра не требуется. Строк явки и ночных: " + Формат(СтрокФОВ, "ЧН=0; ЧГ=0") + ".";
	
КонецФункции

Функция ВидыВремениИзФОВ()
	
	Виды = Новый Соответствие;
	Попытка
		Виды.Вставить(Справочники.уатВидыИспользованияРабочегоВремени.Явка, Истина);
		Виды.Вставить(Справочники.уатВидыИспользованияРабочегоВремени.Праздники, Истина);
		Виды.Вставить(Справочники.уатВидыИспользованияРабочегоВремени.РаботаНочныеЧасы, Истина);
		Виды.Вставить(Справочники.уатВидыИспользованияРабочегоВремени.Работа, Истина);
		Виды.Вставить(Справочники.уатВидыИспользованияРабочегоВремени.Ночные, Истина);
		Виды.Вставить(Справочники.уатВидыИспользованияРабочегоВремени.КомандировкаПочасовая, Истина);
	Исключение
		Возврат Новый Соответствие;
	КонецПопытки;
	
	Возврат Виды;
	
КонецФункции

Процедура ДобавитьРасшифровкуРасчета(Ссылка, Журнал)
	
	Попытка
		ДокументОбъект = Ссылка.ПолучитьОбъект();
	Исключение
		ДобавитьСтрокуЖурнала(Журнал, "Расшифровка расчета не прочитана: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ДобавитьСтрокуЖурнала(Журнал, "Вид ПЛ: " + Строка(ДокументОбъект.ВидПЛ)
		+ "; режим работы ТС: " + ПредставлениеСсылкиЖурнала(ДокументОбъект.РежимРаботыТС) + ".");
	
	Попытка
		ДобавитьСтрокуЖурнала(Журнал, ТекстРежимаРаботы(ДокументОбъект));
	Исключение
		ДобавитьСтрокуЖурнала(Журнал, "Часы режима не прочитаны: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		ДобавитьСтрокуЖурнала(Журнал, ТекстНастроекОбедаОрганизации(ДокументОбъект));
	Исключение
		ДобавитьСтрокуЖурнала(Журнал, "Настройки обеда организации не прочитаны: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		ДобавитьСтрокуЖурнала(Журнал, ТекстПростоев(ДокументОбъект.Простои));
	Исключение
		ДобавитьСтрокуЖурнала(Журнал, "Простои не прочитаны: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		ДобавитьСтрокуЖурнала(Журнал, ТекстРасчетаВремени(ДокументОбъект));
	Исключение
		ДобавитьСтрокуЖурнала(Журнал, "Расчет времени не прочитан: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Попытка
		ДобавитьСтрокуЖурнала(Журнал, ТекстОбедаВидаПЛ(ДокументОбъект));
	Исключение
		ДобавитьСтрокуЖурнала(Журнал, "Обед вида ПЛ не прочитан: "
			+ КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

Функция ТекстПростоев(Простои)
	
	Если Простои.Количество() = 0 Тогда
		Возврат "Простои: нет.";
	КонецЕсли;
	
	Строки = Новый Массив;
	Строки.Добавить("Простои: " + Формат(Простои.Количество(), "ЧН=0; ЧГ=0") + ".");
	Для Каждого СтрокаПростоя Из Простои Цикл
		Строки.Добавить("  " + ФорматДатаВремяЖурнала(СтрокаПростоя.НачалоПростоя)
			+ " | " + Строка(СтрокаПростоя.ВидПростоя)
			+ " | длительность " + ФорматДатаВремяЖурнала(СтрокаПростоя.ВремяПростоя));
	КонецЦикла;
	
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

Функция ТекстРежимаРаботы(ДокументОбъект)
	
	Режим = ДокументОбъект.РежимРаботыТС;
	Если Не ЗначениеЗаполнено(Режим) Тогда
		Возврат "Режим работы ТС не заполнен. Обед и длительность дня типовой расчет берет из настроек организации.";
	КонецЕсли;
	
	Ночной = Режим.НачалоРаботы > Режим.КонецРаботы;
	Возврат "Часы режима: начало " + ТекстВремениРежима(Режим.НачалоРаботы)
		+ "; конец " + ТекстВремениРежима(Режим.КонецРаботы)
		+ "; начало обеда " + ТекстВремениРежима(Режим.НачалоОбеда)
		+ "; конец обеда " + ТекстВремениРежима(Режим.КонецОбеда)
		+ "; продолжительность обеда " + ТекстВремениРежима(Режим.Обед)
		+ "; ночной (начало больше конца): " + ПредставлениеЗначенияЖурнала(Ночной) + ".";
	
КонецФункции

Функция ТекстВремениРежима(Значение)
	
	Если ТипЗнч(Значение) <> Тип("Дата") Тогда
		Возврат ПредставлениеЗначенияЖурнала(Значение);
	КонецЕсли;
	
	Секунды = Значение - НачалоДня(Значение);
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "пусто (" + Формат(Секунды, "ЧН=0; ЧГ=0") + " сек)";
	КонецЕсли;
	
	Возврат Формат(Значение, "ДФ=HH:mm:ss") + " (" + Формат(Секунды, "ЧН=0; ЧГ=0") + " сек)";
	
КонецФункции

Функция ТекстНастроекОбедаОрганизации(ДокументОбъект)
	
	ВремяДоОбеда = уатПраваИНастройки.уатПолучитьПраваИНастройкиПользователя(ДокументОбъект.Организация, "ВремяДоОбеда");
	ПродолжительностьОбеда = уатПраваИНастройки.уатПолучитьПраваИНастройкиПользователя(ДокументОбъект.Организация, "ПродолжительностьОбеда");
	ПродолжительностьДня = уатПраваИНастройки.уатПолучитьПраваИНастройкиПользователя(ДокументОбъект.Организация, "ПродолжительностьРабочегоДня");
	
	Возврат "Настройки организации: время до обеда " + ТекстСекундНастройки(ВремяДоОбеда)
		+ "; продолжительность обеда " + ТекстСекундНастройки(ПродолжительностьОбеда)
		+ "; продолжительность рабочего дня " + ТекстСекундНастройки(ПродолжительностьДня) + ".";
	
КонецФункции

Функция ТекстСекундНастройки(Значение)
	
	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Секунды = Значение - '00010101';
		Если Не ЗначениеЗаполнено(Значение) Тогда
			Возврат "пусто (" + Формат(Секунды, "ЧН=0; ЧГ=0") + " сек)";
		КонецЕсли;
		Возврат Формат(Значение, "ДФ=HH:mm:ss") + " (" + Формат(Секунды, "ЧН=0; ЧГ=0") + " сек)";
	КонецЕсли;
	
	Возврат ПредставлениеЗначенияЖурнала(Значение) + ", тип " + Строка(ТипЗнч(Значение));
	
КонецФункции

Функция ТекстРасчетаВремени(ДокументОбъект)
	
	Строки = Новый Массив;
	Строки.Добавить("ФОВ берет строки уатПутевыеЛисты.РасчетВремени и оставляет виды «Дневные» и «РаботаНочныеЧасы». Менеджер документа считает отдельно.");
	Строки.Добавить(ТекстВызоваРасчетаВремени("уатПутевыеЛисты.РасчетВремени", ДокументОбъект, Ложь));
	Строки.Добавить(ТекстВызоваРасчетаВремени("Документы.уатПутевойЛист.РасчетВремени", ДокументОбъект, Истина));
	Возврат СтрСоединить(Строки, Символы.ПС);
	
КонецФункции

Функция ТекстВызоваРасчетаВремени(ИмяВызова, ДокументОбъект, ВызовМенеджераДокумента)
	
	Попытка
		Если ВызовМенеджераДокумента Тогда
			ТаблицаВремени = Документы.уатПутевойЛист.РасчетВремени(
				ДокументОбъект.ДатаВыезда,
				ДокументОбъект.ДатаВозвращения,
				ДокументОбъект.Организация,
				ДокументОбъект.РежимРаботыТС,
				ДокументОбъект.Простои.Выгрузить());
		Иначе
			ТаблицаВремени = уатПутевыеЛисты.РасчетВремени(
				ДокументОбъект.ДатаВыезда,
				ДокументОбъект.ДатаВозвращения,
				ДокументОбъект.Организация,
				ДокументОбъект.РежимРаботыТС,
				ДокументОбъект.Простои.Выгрузить());
		КонецЕсли;
		
		Если ТаблицаВремени.Количество() = 0 Тогда
			Если ВызовМенеджераДокумента Тогда
				Возврат ИмяВызова + ": строк нет.";
			КонецЕсли;
			Возврат ИмяВызова + ": строк нет. Дневные, ночные, явка и простой не больше нуля.";
		КонецЕсли;
		
		Строки = Новый Массив;
		Строки.Добавить(ИмяВызова + ": строк " + Формат(ТаблицаВремени.Количество(), "ЧН=0; ЧГ=0") + ".");
		Для Каждого СтрокаВремени Из ТаблицаВремени Цикл
			Строки.Добавить("  " + ФорматДатыЖурнала(СтрокаВремени.ДатаРаботы)
				+ " | " + Строка(СтрокаВремени.ВидВремени)
				+ " | " + Формат(СтрокаВремени.Продолжительность, "ЧН=0; ЧГ=0") + " сек");
		КонецЦикла;
		
		Возврат СтрСоединить(Строки, Символы.ПС);
	Исключение
		Возврат ИмяВызова + ": ошибка вызова. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

Функция ТекстОбедаВидаПЛ(ДокументОбъект)
	
	Если ДокументОбъект.ВидПЛ <> Перечисления.уатВидыПЛ._6 Тогда
		Возврат "Обед вида ПЛ 6 не применяется.";
	КонецЕсли;
	
	Обед = уатПутевыеЛисты.ДанныеОбедаПоЗаданию(ДокументОбъект.Задание);
	Возврат "Вид ПЛ 6, обед по заданию: дневной " + ПредставлениеЗначенияЖурнала(Обед.ДневнойОбед)
		+ ", " + Формат(Обед.ВремяОбеда, "ЧН=0; ЧГ=0") + " сек."
		+ " Этот обед вычитается из ФОВ до свертки даты; нулевые строки свертка удаляет.";
	
КонецФункции

Функция ПрочитатьФОВ(Ссылка)
	
	БылУстановлен = ВключитьПривилегированныйРежимЖурнала();
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ФОВ.Дата КАК Дата,
		|	ФОВ.Сотрудник КАК Сотрудник,
		|	ФОВ.ВремяДневное КАК ВремяДневное,
		|	ФОВ.ВремяНочное КАК ВремяНочное
		|ИЗ
		|	Документ.уатПутевойЛист.ФактическиОтработанноеВремя КАК ФОВ
		|ГДЕ
		|	ФОВ.Ссылка = &Ссылка";
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		ВернутьПривилегированныйРежимЖурнала(БылУстановлен);
		ВызватьИсключение;
	КонецПопытки;
	ВернутьПривилегированныйРежимЖурнала(БылУстановлен);
	
	Возврат Таблица;
	
КонецФункции

Функция ПрочитатьРабочееВремя(Ссылка)
	
	БылУстановлен = ВключитьПривилегированныйРежимЖурнала();
	Попытка
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РабочееВремя.ДатаРаботы КАК ДатаРаботы,
		|	РабочееВремя.Сотрудник КАК Сотрудник,
		|	РабочееВремя.ВидИспользованияРабочегоВремени КАК Вид,
		|	РабочееВремя.Время КАК Время,
		|	РабочееВремя.Дней КАК Дней
		|ИЗ
		|	РегистрНакопления.уатРабочееВремяСотрудников КАК РабочееВремя
		|ГДЕ
		|	РабочееВремя.Регистратор = &Ссылка";
		Таблица = Запрос.Выполнить().Выгрузить();
	Исключение
		ВернутьПривилегированныйРежимЖурнала(БылУстановлен);
		Возврат Неопределено;
	КонецПопытки;
	ВернутьПривилегированныйРежимЖурнала(БылУстановлен);
	
	Возврат Таблица;
	
КонецФункции

Функция ОписаниеКоллекцииФОВ(Коллекция)
	
	Список = Новый СписокЗначений;
	СуммаДень = 0;
	СуммаНочь = 0;
	Даты = Новый Соответствие;
	Для Каждого СтрокаФОВ Из Коллекция Цикл
		Ключ = XMLСтрока(НачалоДня(СтрокаФОВ.Дата))
			+ "|" + XMLСтрока(СтрокаФОВ.Сотрудник)
			+ "|" + XMLСтрока(СтрокаФОВ.ВремяДневное)
			+ "|" + XMLСтрока(СтрокаФОВ.ВремяНочное);
		Текст = ФорматДатыЖурнала(СтрокаФОВ.Дата)
			+ " | " + Строка(СтрокаФОВ.Сотрудник)
			+ " | день " + ФорматЧислаЖурнала(СтрокаФОВ.ВремяДневное)
			+ " | ночь " + ФорматЧислаЖурнала(СтрокаФОВ.ВремяНочное);
		Список.Добавить(Ключ, Текст);
		СуммаДень = СуммаДень + СтрокаФОВ.ВремяДневное;
		СуммаНочь = СуммаНочь + СтрокаФОВ.ВремяНочное;
		Даты.Вставить(ФорматДатыЖурнала(СтрокаФОВ.Дата), Истина);
	КонецЦикла;
	
	Список.СортироватьПоЗначению();
	Ключи = Новый Массив;
	Линии = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Ключи.Добавить(Элемент.Значение);
		Линии.Добавить(Элемент.Представление);
	КонецЦикла;
	
	ДатыТекст = Новый Массив;
	Для Каждого ЭлементДаты Из Даты Цикл
		ДатыТекст.Добавить(ЭлементДаты.Ключ);
	КонецЦикла;
	СписокДат = Новый СписокЗначений;
	СписокДат.ЗагрузитьЗначения(ДатыТекст);
	СписокДат.СортироватьПоЗначению();
	ДатыТекст.Очистить();
	Для Каждого ЭлементДаты Из СписокДат Цикл
		ДатыТекст.Добавить(ЭлементДаты.Значение);
	КонецЦикла;
	
	ТекстДат = ?(ДатыТекст.Количество() = 0, "нет", СтрСоединить(ДатыТекст, ", "));
	Сводка = "строк " + Формат(Коллекция.Количество(), "ЧН=0; ЧГ=0")
		+ "; даты: " + ТекстДат
		+ "; сумма день " + ФорматЧислаЖурнала(СуммаДень)
		+ "; сумма ночь " + ФорматЧислаЖурнала(СуммаНочь);
	Текст = ?(Линии.Количество() = 0, "(пусто)", СтрСоединить(Линии, Символы.ПС));
	
	Описание = Новый Структура;
	Описание.Вставить("Ключ", СтрСоединить(Ключи, Символы.ПС));
	Описание.Вставить("Текст", Текст);
	Описание.Вставить("Сводка", Сводка);
	Описание.Вставить("Количество", Коллекция.Количество());
	Описание.Вставить("Коллекция", Коллекция);
	Возврат Описание;
	
КонецФункции

Функция ОписаниеРабочегоВремени(Таблица)
	
	Описание = Новый Структура("Таблица, Сводка, Текст", Таблица, "", "");
	Если Таблица = Неопределено Тогда
		Описание.Сводка = "не прочитан";
		Описание.Текст = "(нет данных)";
		Возврат Описание;
	КонецЕсли;
	
	Список = Новый СписокЗначений;
	Для Каждого СтрокаРегистра Из Таблица Цикл
		Текст = ФорматДатыЖурнала(СтрокаРегистра.ДатаРаботы)
			+ " | " + Строка(СтрокаРегистра.Сотрудник)
			+ " | " + Строка(СтрокаРегистра.Вид)
			+ " | время " + ФорматЧислаЖурнала(СтрокаРегистра.Время)
			+ " | дней " + ФорматЧислаЖурнала(СтрокаРегистра.Дней);
		Список.Добавить(Текст);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	
	Линии = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Линии.Добавить(Элемент.Значение);
	КонецЦикла;
	
	Описание.Сводка = "записей " + Формат(Таблица.Количество(), "ЧН=0; ЧГ=0");
	Описание.Текст = ?(Линии.Количество() = 0, "(пусто)", СтрСоединить(Линии, Символы.ПС));
	Возврат Описание;
	
КонецФункции

Функция ВключитьПривилегированныйРежимЖурнала()
	
	БылУстановлен = ПривилегированныйРежим();
	Если Не БылУстановлен Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	
	Возврат БылУстановлен;
	
КонецФункции

Процедура ВернутьПривилегированныйРежимЖурнала(БылУстановлен)
	
	Если Не БылУстановлен И ПривилегированныйРежим() Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	
КонецПроцедуры

Функция ПредставлениеЗначенияЖурнала(Значение)
	
	Если Значение = Истина Тогда
		Возврат "Истина";
	ИначеЕсли Значение = Ложь Тогда
		Возврат "Ложь";
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "Неопределено";
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

Функция ПредставлениеСсылкиЖурнала(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "не заполнен";
	КонецЕсли;
	
	Возврат Строка(Ссылка);
	
КонецФункции

Функция ФорматДатыЖурнала(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "не заполнена";
	КонецЕсли;
	
	Возврат Формат(Дата, "ДФ=dd.MM.yyyy");
	
КонецФункции

Функция ФорматДатаВремяЖурнала(Дата)
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Возврат "не заполнено";
	КонецЕсли;
	
	Возврат Формат(Дата, "ДФ='dd.MM.yyyy HH:mm:ss'");
	
КонецФункции

Функция ФорматЧислаЖурнала(Число)
	
	Возврат Формат(Число, "ЧН=0; ЧГ=0; ЧДЦ=2");
	
КонецФункции

Функция НоваяТаблицаДокументов()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ДокументСсылка.уатПутевойЛист"));
	Таблица.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Таблица.Колонки.Добавить("Номер", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20)));
	Таблица.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Таблица.Колонки.Добавить("Водитель", Новый ОписаниеТипов("СправочникСсылка.Сотрудники"));
